@using NewRich.Admin.Constants
@model NewRich.Admin.Models.OfflineRegistrarViewModel
<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.OfflineKicker</div>
        <h1>@UiTexts.RegistrarQrOffline</h1>
        <p>@UiTexts.RegistrarQrAyuda</p>
    </div>
</div>
<div class="panel">
    <div asp-validation-summary="ModelOnly" class="notice error"></div>
    <form method="post">
        <div class="field">
            <label asp-for="Qr"></label>
            <textarea asp-for="Qr" rows="10" autofocus></textarea>
            <span asp-validation-for="Qr"></span>
        </div>
        <div class="text-center-actions">
            <button class="primary" type="submit">@UiTexts.RegistrarQrOffline</button>
            <a class="secondary" asp-action="Index">@UiTexts.Cancelar</a>
        </div>
    </form>
</div>
