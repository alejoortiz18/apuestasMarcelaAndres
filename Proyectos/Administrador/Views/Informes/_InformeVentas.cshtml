@using System.Globalization
@using NewRich.Admin.Constants
@using NewRich.Admin.Models
@using NewRich.Admin.Services
@using NewRich.Constants
@model InformeVentasViewModel
@{
    var cultura = CultureInfo.GetCultureInfo("es-CO");
    var r = Model.Resumen;
    string Numero(int valor) => valor.ToString("N0", cultura);
    string Porc(decimal valor) => valor.ToString("0.#", cultura);
    string Css(decimal valor) => valor.ToString("0.##", CultureInfo.InvariantCulture);
    string Pesos(decimal valor) => FormatoPesos.De(valor);
    string Corto(decimal valor) => Math.Abs(valor) >= 1_000_000m
        ? string.Format(UiTexts.InformeMillones, (valor / 1_000_000m).ToString("0.#", cultura))
        : Math.Abs(valor) >= 1_000m
            ? string.Format(UiTexts.InformeMiles, Math.Round(valor / 1_000m, 0, MidpointRounding.AwayFromZero).ToString("0", cultura))
            : valor.ToString("0", cultura);
    string Fecha(DateOnly fecha) => fecha.ToString("dd/MM/yyyy", cultura);
    string Periodo() => Model.Desde == Model.Hasta ? Fecha(Model.Desde) : string.Format(UiTexts.InformeRangoTexto, Fecha(Model.Desde), Fecha(Model.Hasta));

    var ganancia = r.Ganancias > 0 ? " is-positivo" : r.Ganancias < 0 ? " is-negativo" : "";
    var mayorDia = Model.Ingresos.Dias.Count == 0 ? 0m : Model.Ingresos.Dias.Max(d => d.Total);
    var conservar = (string[] quitar) => Context.Request.Query.Where(q => !quitar.Contains(q.Key, StringComparer.OrdinalIgnoreCase));
    var secciones = OrdenSeccionesInforme.Vista(ViewData, CategoriasInforme.Ventas);
}
<div class="informe-reporte informe-ventas informe-secciones" data-secciones="@secciones.Categoria" aria-labelledby="informeVentasReporteTitulo">
<div class="informe-movible" data-seccion="grupo" style="order: @secciones.Posicion("grupo")">
<partial name="~/Views/Informes/_MoverSeccion.cshtml" model='(secciones, "grupo")' />
<div class="informe-graficos">
    <section class="informe-grafico informe-grafico-ancho" aria-labelledby="informeVentasPorGrupo">
        <h5 id="informeVentasPorGrupo">@UiTexts.InformeIngresosPorGrupo</h5>
        <p>@UiTexts.InformeIngresosPorGrupoAyuda</p>
        @if (Model.Ingresos.PorGrupo.Count == 0)
        {
            <p class="empty">@UiTexts.InformeSinIngresos</p>
        }
        else
        {
            <ul class="informe-barras">
                @foreach (var grupo in Model.Ingresos.PorGrupo)
                {
                    <li>
                        <div class="informe-barra-head">
                            <span>@grupo.Texto</span>
                            <strong>@Pesos(grupo.Valor) <small>@Porc(grupo.Porcentaje) %</small></strong>
                        </div>
                        <div class="informe-barra" aria-hidden="true"><i style="width: @Css(grupo.Ancho)%"></i></div>
                    </li>
                }
            </ul>
        }
    </section>
</div>
</div>
    <div class="informe-movible" data-seccion="encabezado" style="order: @secciones.Posicion("encabezado")">
    <partial name="~/Views/Informes/_MoverSeccion.cshtml" model='(secciones, "encabezado")' />
    <header class="informe-reporte-head">
        <div>
            <h3 id="informeVentasReporteTitulo">@UiTexts.InformeVentasNombre</h3>
            <p>@string.Format(UiTexts.InformeCorte, Model.Corte.ToString("dd/MM/yyyy hh:mm tt", cultura))</p>
        </div>
        <ul class="informe-ventas-alcance">
            <li>@string.Format(UiTexts.InformePeriodoTexto, Periodo())</li>
            <li>@string.Format(UiTexts.InformeAlcanceTexto, Model.Alcance)</li>
        </ul>
    </header>
    </div>

    <div class="informe-movible" data-seccion="tarjetas" style="order: @secciones.Posicion("tarjetas")">
    <partial name="~/Views/Informes/_MoverSeccion.cshtml" model='(secciones, "tarjetas")' />
    <p class="informe-ventas-ayuda">@UiTexts.InformeTarjetasAyuda</p>
    <div class="informe-metricas informe-finanzas">
        <div class="informe-metrica is-principal">
            <small>@UiTexts.InformeTarjetaIngresos</small>
            <strong>@Pesos(r.TotalIngresos)</strong>
        </div>
        <div class="informe-metrica">
            <small>@UiTexts.InformeTarjetaPremios</small>
            <strong>@Pesos(r.TotalPremios)</strong>
        </div>
        <div class="informe-metrica">
            <small>@UiTexts.InformeTarjetaGastos</small>
            <strong>@Pesos(r.TotalGastos)</strong>
        </div>
        <div class="informe-metrica">
            <small>@UiTexts.InformeTarjetaCubierto</small>
            <strong>@Pesos(r.TotalCubierto)</strong>
        </div>
        <div class="informe-metrica is-egresos">
            <small>@UiTexts.InformeTarjetaEgresos</small>
            <strong>@Pesos(r.TotalEgresos)</strong>
        </div>
        <div class="informe-metrica is-ganancia@(ganancia)">
            <small>@UiTexts.InformeTarjetaGanancias</small>
            <strong>@Pesos(r.Ganancias)</strong>
        </div>
    </div>
    </div>

    <div class="informe-movible" data-seccion="dias" style="order: @secciones.Posicion("dias")">
    <partial name="~/Views/Informes/_MoverSeccion.cshtml" model='(secciones, "dias")' />
    <section class="informe-bloque" aria-labelledby="informeVentasIngresos">
        <header class="informe-bloque-head">
            <h4 id="informeVentasIngresos">@UiTexts.InformeSeccionIngresos</h4>
            <p>@UiTexts.InformeSeccionIngresosAyuda</p>
        </header>
        <div class="informe-graficos">
            <section class="informe-grafico informe-grafico-ancho" aria-labelledby="informeVentasPorDia">
                <h5 id="informeVentasPorDia">@UiTexts.InformeIngresosPorDia</h5>
                <p>@UiTexts.InformeIngresosPorDiaAyuda</p>
                <dl class="informe-datos">
                    <div>
                        <dt>@UiTexts.InformeIngresosPromedio</dt>
                        <dd>@Pesos(Model.Ingresos.PromedioDiario)</dd>
                    </div>
                    <div>
                        <dt>@UiTexts.InformeIngresosTicket</dt>
                        <dd>@Pesos(Model.Ingresos.TicketPromedio)</dd>
                    </div>
                    <div>
                        <dt>@UiTexts.InformeIngresosMejorDia</dt>
                        <dd>
                            @if (Model.Ingresos.MejorDia is { } mejor)
                            {
                                @Pesos(mejor.Total) <small>@Fecha(mejor.Fecha)</small>
                            }
                            else
                            {
                                @("-")
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>@UiTexts.InformeIngresosDiasVenta</dt>
                        <dd>@string.Format(UiTexts.InformeDiasDe, Numero(Model.Ingresos.DiasConVentas), Numero(Model.Ingresos.Dias.Count))</dd>
                    </div>
                </dl>
                @if (mayorDia <= 0)
                {
                    <p class="empty">@UiTexts.InformeSinIngresos</p>
                }
                else
                {
                    <div class="informe-dias informe-ventas-dias" role="img"
                         aria-label="@UiTexts.InformeIngresosPorDia: @string.Join(". ", Model.Ingresos.Dias.Select(d => $"{Fecha(d.Fecha)} {Pesos(d.Total)}"))">
                        @foreach (var dia in Model.Ingresos.Dias)
                        {
                            <div class="informe-dia" title="@Fecha(dia.Fecha) · @Pesos(dia.Total) · @string.Format(UiTexts.InformeIngresosVentas, Numero(dia.Ventas))">
                                <span class="informe-dia-valor">@Corto(dia.Total)</span>
                                <div class="informe-dia-pista">
                                    <i style="height: @Css(dia.Alto == 0 ? 0 : Math.Max(dia.Alto, 8))%"></i>
                                </div>
                                <span class="informe-dia-fecha">@dia.Fecha.ToString("dd/MM", cultura)</span>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </section>
    </div>

    <div class="informe-movible" data-seccion="vendedores" style="order: @secciones.Posicion("vendedores")">
    <partial name="~/Views/Informes/_MoverSeccion.cshtml" model='(secciones, "vendedores")' />
        <section class="informe-tabla" id="informeVentasRankingSeccion" aria-labelledby="informeVentasRanking">
            <div class="informe-tabla-head">
                <div>
                    <h5 id="informeVentasRanking">@UiTexts.InformeRankingVendedores</h5>
                    <p>@UiTexts.InformeRankingVendedoresAyuda</p>
                </div>
                <form method="get" asp-action="@ViewContext.RouteData.Values["action"]" class="informe-filas" data-submit-on-change>
                    @foreach (var q in conservar(["pageV", "pageSizeV"]))
                    {
                        <input type="hidden" name="@q.Key" value="@q.Value" />
                    }
                    <label for="informeVentasPageSizeV">@UiTexts.FilasPorPagina</label>
                    <select id="informeVentasPageSizeV" name="pageSizeV">
                        @foreach (var size in PagingHelper.PageSizes)
                        {
                            <option value="@size" selected="@(Model.Ingresos.Vendedores.PageSize == size)">@size</option>
                        }
                    </select>
                </form>
            </div>
            @if (Model.Ingresos.Vendedores.TotalCount == 0)
            {
                <p class="empty">@UiTexts.InformeSinIngresos</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="informe-table">
                        <thead>
                        <tr>
                            @foreach (var (clave, texto, numero) in new[]
                            {
                                (InformeOrden.Posicion, UiTexts.InformeColumnaPosicion, false),
                                (InformeOrden.Fecha, UiTexts.FechaVenta, false),
                                (InformeOrden.Vendedor, UiTexts.Vendedor, false),
                                (InformeOrden.Grupo, UiTexts.Grupo, false),
                                (InformeOrden.Total, UiTexts.Total, true)
                            })
                            {
                                <partial name="_ColumnaOrden" model='new ColumnaOrdenViewModel { Clave = clave, Texto = texto, Estado = Model.Ingresos.OrdenRanking, ParamOrden = "ordenV", ParamDireccion = "dirV", ParamPagina = "pageV", Ancla = "informeVentasRankingSeccion", Numero = numero }' />
                            }
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var v in Model.Ingresos.Vendedores.Items)
                        {
                            <tr>
                                <td><span class="informe-puesto@(v.Posicion <= 3 ? " is-podio" : "")">@v.Posicion</span></td>
                                <td>@v.FechaVenta.ToString("dd/MM/yyyy hh:mm tt", cultura)</td>
                                <td><strong>@v.Vendedor</strong></td>
                                <td>@v.Grupo</td>
                                <td class="num"><strong>@Pesos(v.Total)</strong></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                ViewData["PagerPageKey"] = "pageV";
                ViewData["PagerPageSizeKey"] = "pageSizeV";
                <partial name="_Pager" model="Model.Ingresos.Vendedores" />
            }
        </section>
    </div>
</div>
