@using NewRich.Admin.Constants
@using NewRich.Admin.Models
@using NewRich.Constants
@model InformesViewModel
@{
    var vendedores = Model.Vendedores;
    var filtros = vendedores.Filtros;
    var campos = new[]
    {
        new CampoFiltroInforme
        {
            Id = "informeGrupos", Modo = "modoGrupos", Nombre = "grupos", Titulo = UiTexts.InformeFiltrarGrupo,
            TextoTodos = UiTexts.InformeTodosGrupos, TextoElegidos = UiTexts.InformeGruposEspecificos, Error = UiTexts.InformeEligeGrupo,
            Opciones = vendedores.Grupos, Elegidos = filtros.Grupos?.ToHashSet(StringComparer.OrdinalIgnoreCase)
        },
        new CampoFiltroInforme
        {
            Id = "informeUsuarios", Modo = "modoUsuarios", Nombre = "usuarios", Titulo = UiTexts.InformeFiltrarUsuarios,
            TextoTodos = UiTexts.InformeTodosUsuarios, TextoElegidos = UiTexts.InformeUsuariosEspecificos, Error = UiTexts.InformeEligeUsuario,
            Opciones = vendedores.Usuarios, Elegidos = filtros.Usuarios?.Select(u => u.ToString()).ToHashSet(StringComparer.OrdinalIgnoreCase)
        },
        new CampoFiltroInforme
        {
            Id = "informeTipos", Modo = "modoTipos", Nombre = "tipos", Titulo = UiTexts.InformeFiltrarTipo,
            TextoTodos = UiTexts.InformeTodosTipos, TextoElegidos = UiTexts.InformeTiposEspecificos, Error = UiTexts.InformeEligeTipo,
            Opciones = vendedores.Tipos, Elegidos = filtros.Tipos?.Select(t => ((int)t).ToString()).ToHashSet()
        }
    };
    var resumen = vendedores.Resumen;
    var porPeriodo = new[]
    {
        (Modal: new ModalPeriodoInforme
        {
            Config = Model.Ventas, Prefijo = "informeVentas", Titulo = UiTexts.InformeVentasTitulo,
            Ayuda = UiTexts.InformeVentasAyuda, NotaGrupos = UiTexts.InformeGruposVentasAyuda
        }, Nombre: UiTexts.InformeCategoriaVentas),
        (Modal: new ModalPeriodoInforme
        {
            Config = Model.Egresos, Prefijo = "informeEgresos", Titulo = UiTexts.InformeEgresosTitulo,
            Ayuda = UiTexts.InformeEgresosAyuda, NotaGrupos = UiTexts.InformeGruposEgresosAyuda
        }, Nombre: UiTexts.InformeCategoriaEgresos),
        (Modal: new ModalPeriodoInforme
        {
            Config = Model.Recaudo, Prefijo = "informeRecaudo", Titulo = UiTexts.InformeRecaudoTitulo,
            Ayuda = UiTexts.InformeRecaudoAyuda, NotaGrupos = UiTexts.InformeGruposRecaudoAyuda
        }, Nombre: UiTexts.InformeCategoriaRecaudo)
    };
    var algunaConfigurada = vendedores.Configurada || porPeriodo.Any(c => c.Modal.Config.Configurada);
    var incluidos = (vendedores.Configurada ? new[] { (Nombre: UiTexts.InformeCategoriaVendedores, Detalle: vendedores.Detalle) } : [])
        .Concat(porPeriodo.Where(c => c.Modal.Config.Configurada).Select(c => (c.Nombre, c.Modal.Config.Detalle)))
        .ToList();
}
<link rel="stylesheet" href="~/css/informes.css" asp-append-version="true" />

<div class="heading">
    <div>
        <h1>@UiTexts.NavInformes</h1>
        <p>@UiTexts.InformesSub</p>
    </div>
    @if (algunaConfigurada)
    {
        <button class="primary informe-exportar" type="button" title="@UiTexts.InformeExportarPdfAyuda"
                data-informe-exportar="informeSeleccionados"
                data-resumen="informePdfResumen"
                data-titulo="@UiTexts.NavInformes"
                data-fuentes="@Url.Content("~/lib/fuentes-pdf/fuentes.css")"
                data-archivo="informes-@(Model.Corte.ToString("yyyyMMdd-HHmm")).pdf"
                data-generando="@UiTexts.InformePdfGenerando"
                data-error="@UiTexts.InformePdfError">@UiTexts.InformeExportarPdf</button>
    }
    else
    {
        <button class="primary informe-exportar" type="button" disabled title="@UiTexts.InformePdfSinCategorias">@UiTexts.InformeExportarPdf</button>
    }
</div>

<section class="panel informe-seccion" aria-labelledby="informeOpcionesTitulo">
    <h2 id="informeOpcionesTitulo">@UiTexts.InformeOpcionesTitulo</h2>
    <p class="panel-sub">@UiTexts.InformeOpcionesAyuda</p>
    <div class="informe-tarjetas">
        @foreach (var tarjeta in Model.Tarjetas)
        {
            <button type="button"
                    class="informe-tarjeta@(tarjeta.Configurada ? " is-selected" : "")"
                    disabled="@(!tarjeta.Habilitada)"
                    aria-label="@string.Format(UiTexts.InformeConfigurar, tarjeta.Nombre)"
                    aria-describedby="informeTarjeta-@tarjeta.Clave"
                    aria-haspopup="@(tarjeta.Habilitada ? "dialog" : null)"
                    data-informe-abrir="@(tarjeta.Habilitada ? tarjeta.Clave : null)">
                @if (tarjeta.Configurada)
                {
                    <span class="informe-insignia">@UiTexts.InformeSeleccionada</span>
                }
                <span class="informe-tarjeta-icono" aria-hidden="true">
                    @switch (tarjeta.Clave)
                    {
                        case CategoriasInforme.Vendedores:
                            <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2" /><path d="M3.5 19c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5" /><path d="M15.5 5.2a3 3 0 0 1 0 5.6" /><path d="M17 14.3c2 .5 3.2 2.1 3.5 4.7" /></svg>
                            break;
                        case CategoriasInforme.Ventas:
                            <svg viewBox="0 0 24 24"><path d="M4 7a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v3a2 2 0 0 0 0 4v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a2 2 0 0 0 0-4Z" /><path d="M10 9.5h4" /><path d="M10 14.5h4" /></svg>
                            break;
                        case CategoriasInforme.Egresos:
                            <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2" /><circle cx="12" cy="12" r="2.4" /><path d="M6.5 9.5h.01M17.5 14.5h.01" /><path d="m15 3-3 2.5L9 3" /></svg>
                            break;
                        case CategoriasInforme.Recaudo:
                            <svg viewBox="0 0 24 24"><path d="M3 10.5 12 5l9 5.5" /><path d="M5 10.5V19h14v-8.5" /><path d="M12 9.5v7" /><path d="M14.2 11.2c-.4-.6-1.2-1-2.2-1-1.2 0-2 .6-2 1.4 0 1.8 4.2 1 4.2 2.9 0 .8-.9 1.4-2.2 1.4-1 0-1.9-.4-2.3-1" /></svg>
                            break;
                    }
                </span>
                <span class="informe-tarjeta-nombre">@tarjeta.Nombre</span>
                <span class="informe-tarjeta-descripcion" id="informeTarjeta-@tarjeta.Clave">@tarjeta.Descripcion</span>
                @if (!string.IsNullOrWhiteSpace(tarjeta.Resumen))
                {
                    <span class="informe-tarjeta-resumen">@tarjeta.Resumen</span>
                }
            </button>
        }
    </div>
</section>

<section id="informeSeleccionados" class="panel informe-seccion" aria-label="@UiTexts.InformeFiltrosTitulo">
    @if (!algunaConfigurada)
    {
        <p class="empty">@UiTexts.InformeFiltrosVacio</p>
    }
    @if (vendedores.Configurada)
    {
        <div class="informe-categoria">
            <h2 id="informeTituloVendedores" class="informe-titulo-categoria">@UiTexts.InformeCategoriaVendedores</h2>
            <article class="informe-config">
                <div class="informe-config-datos">
                    <h3>@UiTexts.InformeCategoriaVendedores</h3>
                    <dl>
                        @foreach (var detalle in vendedores.Detalle)
                        {
                            <div>
                                <dt>@detalle.Etiqueta</dt>
                                <dd>@detalle.Valor</dd>
                            </div>
                        }
                    </dl>
                    <p>@vendedores.ResumenCorto</p>
                </div>
                <button class="secondary" type="button" data-informe-abrir="@CategoriasInforme.Vendedores" aria-haspopup="dialog">@UiTexts.InformeEditarFiltros</button>
            </article>
            @if (Model.Informe is not null)
            {
                <partial name="_InformeVendedores" model="Model.Informe" />
            }
        </div>
    }
    @foreach (var (modal, nombre) in porPeriodo.Where(c => c.Modal.Config.Configurada))
    {
        var config = modal.Config;
        <div class="informe-categoria">
            <h2 id="@(modal.Prefijo)TituloCategoria" class="informe-titulo-categoria">@nombre</h2>
            <article class="informe-config">
                <div class="informe-config-datos">
                    <h3>@nombre</h3>
                    <dl>
                        @foreach (var detalle in config.Detalle)
                        {
                            <div>
                                <dt>@detalle.Etiqueta</dt>
                                <dd>@detalle.Valor</dd>
                            </div>
                        }
                    </dl>
                    <p>@modal.NotaGrupos</p>
                </div>
                <button class="secondary" type="button" data-informe-abrir="@config.Clave" aria-haspopup="dialog">@UiTexts.InformeEditarFiltros</button>
            </article>
            @switch (config.Clave)
            {
                case CategoriasInforme.Ventas when Model.InformeVentas is not null:
                    <partial name="_InformeVentas" model="Model.InformeVentas" />
                    break;
                case CategoriasInforme.Egresos when Model.InformeEgresos is not null:
                    <partial name="_InformeEgresos" model="Model.InformeEgresos" />
                    break;
                case CategoriasInforme.Recaudo when Model.InformeRecaudo is not null:
                    <partial name="_InformeRecaudo" model="Model.InformeRecaudo" />
                    break;
            }
        </div>
    }
</section>

@if (algunaConfigurada)
{
    <div id="informePdfResumen" class="informe-pdf-resumen" aria-hidden="true">
        <header class="informe-pdf-encabezado" data-pdf-encabezado>
            <p class="informe-pdf-kicker">@UiTexts.InformePdfKicker</p>
            <h2>@UiTexts.NavInformes</h2>
            <p>@UiTexts.InformesSub</p>
            <p class="informe-pdf-corte">@UiTexts.CorteDeInformacion: @Model.Corte.ToString("dd/MM/yyyy HH:mm") · @UiTexts.FuenteSql</p>
        </header>
        <section class="informe-pdf-filtros" data-pdf-filtros>
            <h3>@UiTexts.FiltrosAplicados</h3>
            <p>@UiTexts.InformePdfIncluidos: @string.Join(", ", incluidos.Select(i => i.Nombre))</p>
            @foreach (var (nombre, detalle) in incluidos)
            {
                <div class="informe-pdf-categoria">
                    <strong>@nombre</strong>
                    @foreach (var d in detalle)
                    {
                        <p>@d.Etiqueta: @d.Valor</p>
                    }
                </div>
            }
        </section>
    </div>
}

<div id="informeVendedoresDialog" class="dialog-back hidden" role="dialog" aria-modal="true" aria-labelledby="informeVendedoresTitulo" data-informe-dialog="@CategoriasInforme.Vendedores" hidden>
    <div class="dialog dialog-informe">
        <h2 id="informeVendedoresTitulo">@UiTexts.InformeVendedoresTitulo</h2>
        <p>@UiTexts.InformeVendedoresAyuda</p>
        <form method="post" asp-action="GuardarVendedores" novalidate data-informe-form>
            @Html.AntiForgeryToken()
            <div class="informe-modal-cuerpo">
                <div class="informe-filtros">
                    @foreach (var campo in campos)
                    {
                        <partial name="_FiltroInforme" model="campo" />
                    }
                </div>
                <aside class="informe-conteos" aria-labelledby="informeConteosTitulo"
                       data-informe-conteos
                       data-sin-coincidencias="@UiTexts.InformeSinCoincidencias"
                       data-sin-vendedores="@UiTexts.InformeSinVendedores"
                       data-seleccionados="@UiTexts.InformeSeleccionados">
                    <h3 id="informeConteosTitulo">@UiTexts.InformeCantidadPersonal</h3>
                    <dl class="informe-totales" aria-live="polite">
                        <div>
                            <dt>@UiTexts.InformePersonalRegistrado</dt>
                            <dd data-informe-total>@resumen.TotalRegistrados</dd>
                        </div>
                        <div class="is-destacado">
                            <dt>@UiTexts.InformeCumplenFiltros</dt>
                            <dd data-informe-cumplen>@resumen.Cumplen</dd>
                        </div>
                    </dl>
                    <h4>@UiTexts.InformePorTipo</h4>
                    <ul class="informe-conteo-lista" data-informe-por-tipo>
                        @foreach (var tipo in resumen.PorTipo)
                        {
                            <li><span>@tipo.Texto</span><strong>@tipo.Cantidad</strong></li>
                        }
                    </ul>
                    <h4>@UiTexts.InformeVendedoresPorGrupo</h4>
                    <ul class="informe-conteo-lista" data-informe-por-grupo>
                        @foreach (var grupo in resumen.VendedoresPorGrupo)
                        {
                            <li><span>@grupo.Texto</span><strong>@grupo.Cantidad</strong></li>
                        }
                    </ul>
                    <p class="informe-conteo-vacio" data-informe-por-grupo-vacio @(resumen.VendedoresPorGrupo.Count > 0 ? "hidden" : null)>@UiTexts.InformeSinVendedores</p>
                    <h4>@UiTexts.InformeUsuariosIncluidos</h4>
                    <ul class="informe-personas" data-informe-personas>
                        @foreach (var persona in resumen.Usuarios)
                        {
                            <li><strong>@persona.Nombre</strong><small>@persona.Usuario · @persona.Tipo · @persona.Grupo</small></li>
                        }
                    </ul>
                    <p class="informe-conteo-vacio" data-informe-personas-vacio @(resumen.Usuarios.Count > 0 ? "hidden" : null)>@UiTexts.InformeSinCoincidencias</p>
                </aside>
            </div>
            <div class="dialog-actions informe-acciones">
                @if (vendedores.Configurada)
                {
                    <button class="danger" type="submit" form="informeQuitarVendedores">@UiTexts.InformeQuitar</button>
                }
                <button class="secondary" type="button" data-informe-cerrar>@UiTexts.Cancelar</button>
                <button class="primary" type="submit">@UiTexts.InformeGuardarSeleccion</button>
            </div>
        </form>
        @if (vendedores.Configurada)
        {
            <form id="informeQuitarVendedores" method="post" asp-action="Quitar" hidden>
                @Html.AntiForgeryToken()
                <input type="hidden" name="categoria" value="@CategoriasInforme.Vendedores" />
            </form>
        }
    </div>
</div>
<script type="application/json" id="informeVendedoresDatos">@Html.Raw(vendedores.DatosJson)</script>

@foreach (var categoria in porPeriodo)
{
    <partial name="_ModalPeriodoInforme" model="categoria.Modal" />
}

@section Scripts {
    <script src="~/lib/html-to-image/html-to-image.js" asp-append-version="true"></script>
    <script src="~/lib/jspdf/jspdf.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/informes.js" asp-append-version="true"></script>
}
