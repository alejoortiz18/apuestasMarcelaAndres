@using System.Globalization
@using NewRich.Admin.Constants
@using NewRich.Admin.Models
@using NewRich.Admin.Services
@using NewRich.Constants
@model InformeEgresosViewModel
@{
    var cultura = CultureInfo.GetCultureInfo("es-CO");
    var r = Model.Resumen;
    string Numero(int valor) => valor.ToString("N0", cultura);
    string Porc(decimal valor) => valor.ToString("0.#", cultura);
    string Css(decimal valor) => valor.ToString("0.##", CultureInfo.InvariantCulture);
    string Pesos(decimal valor) => FormatoPesos.De(valor);
    string Corto(decimal valor) => Math.Abs(valor) >= 1_000_000m
        ? string.Format(UiTexts.InformeMillones, (valor / 1_000_000m).ToString("0.#", cultura))
        : Math.Abs(valor) >= 1_000m
            ? string.Format(UiTexts.InformeMiles, Math.Round(valor / 1_000m, 0, MidpointRounding.AwayFromZero).ToString("0", cultura))
            : valor.ToString("0", cultura);
    string Segmento(SegmentoValorInforme s) => string.Format(UiTexts.InformeSegmento, s.Texto, Pesos(s.Valor), Porc(s.Porcentaje));
    string Fecha(DateOnly fecha) => fecha.ToString("dd/MM/yyyy", cultura);
    string Periodo() => Model.Desde == Model.Hasta ? Fecha(Model.Desde) : string.Format(UiTexts.InformeRangoTexto, Fecha(Model.Desde), Fecha(Model.Hasta));

    string Dona(IReadOnlyList<SegmentoValorInforme> segmentos)
    {
        var partes = new List<string>();
        var acumulado = 0m;
        var conValor = segmentos.Where(s => s.Valor > 0).ToList();
        for (var i = 0; i < conValor.Count; i++)
        {
            var fin = i == conValor.Count - 1 ? 100m : Math.Min(100m, acumulado + conValor[i].Porcentaje);
            partes.Add($"var(--informe-tono-{i % 6 + 1}) {Css(acumulado)}% {Css(fin)}%");
            acumulado = fin;
        }
        return partes.Count == 0 ? "var(--line) 0 100%" : string.Join(", ", partes);
    }

    var conceptos = Model.Egresos.Conceptos.Where(c => c.Valor > 0).ToList();
    var conservar = (string[] quitar) => Context.Request.Query.Where(q => !quitar.Contains(q.Key, StringComparer.OrdinalIgnoreCase));
    var premiosWeb = Model.Egresos.PremiosWeb;
    var ordenP = Model.Egresos.OrdenPremios;
    var dirP = Model.Egresos.DireccionPremios;
    var columnasPremios = new (string Clave, string Texto, bool Numero)[]
    {
        (InformePremiosWebOrden.Fecha, UiTexts.Fecha, false),
        (InformePremiosWebOrden.Vendedor, UiTexts.Vendedor, false),
        (InformePremiosWebOrden.Loteria, UiTexts.Loteria, false),
        (InformePremiosWebOrden.Numero, UiTexts.InformeColumnaNumero, false),
        (InformePremiosWebOrden.Apostado, UiTexts.ValorApostado, true),
        (InformePremiosWebOrden.Premio, UiTexts.InformeColumnaValorPremio, true)
    };
    string UrlOrdenPremios(string columna)
    {
        var valores = new Microsoft.AspNetCore.Routing.RouteValueDictionary();
        foreach (var q in conservar(["ordenP", "dirP", "pageP"])) valores[q.Key] = q.Value.ToString();
        valores["ordenP"] = columna;
        valores["dirP"] = InformePremiosWebOrden.SiguienteDireccion(columna, ordenP, dirP);
        return Url.Action("Index", valores) + "#informeEgresosPremiosWeb";
    }
    var ordenG = Model.Egresos.OrdenGastos;
    var dirG = Model.Egresos.DireccionGastos;
    var columnasGastos = new (string Clave, string Texto, bool Numero)[]
    {
        (VentasInforme.GastoPersonaFecha, UiTexts.Fecha, false),
        (VentasInforme.GastoPersonaPersona, UiTexts.InformeColumnaPersona, false),
        (VentasInforme.GastoPersonaTipo, UiTexts.TipoGasto, false),
        (VentasInforme.GastoPersonaTotal, UiTexts.Total, true)
    };
    string UrlOrdenGastos(string columna)
    {
        var valores = new Microsoft.AspNetCore.Routing.RouteValueDictionary();
        foreach (var q in conservar(["ordenG", "dirG", "pageG"])) valores[q.Key] = q.Value.ToString();
        valores["ordenG"] = columna;
        valores["dirG"] = OrdenTabla.Siguiente(columna, ordenG, dirG);
        return Url.Action("Index", valores) + "#informeEgresosGastosPersonaSeccion";
    }
    string EtiquetaGastos(string columna, string texto) => string.Format(
        OrdenTabla.Siguiente(columna, ordenG, dirG) == "asc" ? UiTexts.OrdenarColumnaAsc : UiTexts.OrdenarColumnaDesc,
        texto);
    string EtiquetaPremios(string columna, string texto) => string.Format(
        InformePremiosWebOrden.SiguienteDireccion(columna, ordenP, dirP) == "asc" ? UiTexts.OrdenarColumnaAsc : UiTexts.OrdenarColumnaDesc,
        texto);
    var secciones = OrdenSeccionesInforme.Vista(ViewData, CategoriasInforme.Egresos);
}
<div class="informe-reporte informe-egresos informe-secciones" data-secciones="@secciones.Categoria" aria-labelledby="informeEgresosReporteTitulo">
    <div class="informe-movible" data-seccion="encabezado" style="order: @secciones.Posicion("encabezado")">
    <partial name="_MoverSeccion" model='(secciones, "encabezado")' />
    <header class="informe-reporte-head">
        <div>
            <h3 id="informeEgresosReporteTitulo">@UiTexts.InformeEgresosNombre</h3>
            <p>@string.Format(UiTexts.InformeCorte, Model.Corte.ToString("dd/MM/yyyy hh:mm tt", cultura))</p>
        </div>
        <ul class="informe-ventas-alcance">
            <li>@string.Format(UiTexts.InformePeriodoTexto, Periodo())</li>
            <li>@string.Format(UiTexts.InformeAlcanceTexto, Model.Alcance)</li>
        </ul>
    </header>
    </div>

    <div class="informe-movible is-media" data-seccion="conceptos" style="order: @secciones.Posicion("conceptos")">
    <partial name="_MoverSeccion" model='(secciones, "conceptos")' />
            <section class="informe-grafico" aria-labelledby="informeEgresosConceptos">
                <h5 id="informeEgresosConceptos">@UiTexts.InformeEgresosPorConcepto</h5>
                <p>@UiTexts.InformeEgresosPorConceptoAyuda</p>
                @if (conceptos.Count == 0)
                {
                    <p class="empty">@UiTexts.InformeSinEgresos</p>
                }
                else
                {
                    <div class="informe-dona-bloque">
                        <div class="informe-dona" style="background: conic-gradient(@Dona(conceptos))" role="img" aria-label="@string.Join(". ", conceptos.Select(Segmento))">
                            <span><strong>@Corto(r.TotalEgresos)</strong><small>@UiTexts.InformeEgresosCentro</small></span>
                        </div>
                        <ul class="informe-leyenda informe-leyenda-valor">
                            @for (var i = 0; i < conceptos.Count; i++)
                            {
                                var concepto = conceptos[i];
                                <li>
                                    <i class="informe-tono-@(i % 6 + 1)" aria-hidden="true"></i>
                                    <span>@concepto.Texto</span>
                                    <strong>@Pesos(concepto.Valor)</strong>
                                    <small>@Porc(concepto.Porcentaje) %</small>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </section>
    </div>

    @if (Model.Egresos.IncluyeGastos)
    {
    <div class="informe-movible is-media" data-seccion="tipos" style="order: @secciones.Posicion("tipos")">
    <partial name="_MoverSeccion" model='(secciones, "tipos")' />
            <section class="informe-grafico" aria-labelledby="informeEgresosTiposGasto">
                <h5 id="informeEgresosTiposGasto">@UiTexts.InformeGastosPorTipo</h5>
                <p>@UiTexts.InformeGastosPorTipoAyuda</p>
                @if (Model.Egresos.GastosPorTipo.Count == 0)
                {
                    <p class="empty">@UiTexts.InformeSinGastos</p>
                }
                else
                {
                    <ul class="informe-barras">
                        @foreach (var tipo in Model.Egresos.GastosPorTipo)
                        {
                            <li>
                                <div class="informe-barra-head">
                                    <span>@tipo.Texto</span>
                                    <strong>@Pesos(tipo.Valor) <small>@Porc(tipo.Porcentaje) %</small></strong>
                                </div>
                                <div class="informe-barra is-gasto" aria-hidden="true"><i style="width: @Css(tipo.Ancho)%"></i></div>
                            </li>
                        }
                    </ul>
                }
            </section>
    </div>
    }

    @if (Model.Egresos.IncluyePremios)
    {
    <div class="informe-movible is-media" data-seccion="loterias" style="order: @secciones.Posicion("loterias")">
    <partial name="_MoverSeccion" model='(secciones, "loterias")' />
            <section class="informe-grafico" aria-labelledby="informeEgresosPremiosLoteria">
                <h5 id="informeEgresosPremiosLoteria">@UiTexts.InformePremiosPorLoteria</h5>
                <p>@UiTexts.InformePremiosPorLoteriaAyuda</p>
                @if (Model.Egresos.PremiosPorLoteria.Count == 0)
                {
                    <p class="empty">@UiTexts.InformeSinPremiosPorLoteria</p>
                }
                else
                {
                    <ul class="informe-barras">
                        @foreach (var loteria in Model.Egresos.PremiosPorLoteria)
                        {
                            <li>
                                <div class="informe-barra-head">
                                    <span>@loteria.Texto <small>@string.Format(UiTexts.InformePremiosCantidad, Numero(loteria.Cantidad))</small></span>
                                    <strong>@Pesos(loteria.Valor) <small>@Porc(loteria.Porcentaje) %</small></strong>
                                </div>
                                <div class="informe-barra" aria-hidden="true"><i style="width: @Css(loteria.Ancho)%"></i></div>
                            </li>
                        }
                    </ul>
                }
            </section>
    </div>

    <div class="informe-movible" data-seccion="premios" style="order: @secciones.Posicion("premios")">
    <partial name="_MoverSeccion" model='(secciones, "premios")' />
        <section class="informe-tabla" id="informeEgresosPremiosWeb" aria-labelledby="informeEgresosPremiosWebTitulo">
            <div class="informe-tabla-head">
                <div>
                    <h5 id="informeEgresosPremiosWebTitulo">@UiTexts.InformePremiosWeb</h5>
                    <p>@UiTexts.InformePremiosWebAyuda</p>
                </div>
                <form method="get" asp-action="Index" class="informe-filas" data-submit-on-change>
                    @foreach (var q in conservar(["pageP", "pageSizeP"]))
                    {
                        <input type="hidden" name="@q.Key" value="@q.Value" />
                    }
                    <label for="informeEgresosPageSizeP">@UiTexts.FilasPorPagina</label>
                    <select id="informeEgresosPageSizeP" name="pageSizeP">
                        @foreach (var size in PagingHelper.PageSizes)
                        {
                            <option value="@size" selected="@(premiosWeb.PageSize == size)">@size</option>
                        }
                    </select>
                </form>
            </div>
            @if (premiosWeb.TotalCount == 0)
            {
                <p class="empty">@UiTexts.InformeSinPremiosWeb</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="informe-table">
                        <thead>
                        <tr>
                            @foreach (var columna in columnasPremios)
                            {
                                var activa = ordenP == columna.Clave;
                                <th scope="col" class="@(columna.Numero ? "num" : null)" aria-sort="@(activa ? (dirP == "asc" ? "ascending" : "descending") : null)">
                                    <a class="table-sort" href="@UrlOrdenPremios(columna.Clave)" aria-label="@EtiquetaPremios(columna.Clave, columna.Texto)">
                                        @columna.Texto <span aria-hidden="true">@InformePremiosWebOrden.Marca(columna.Clave, ordenP, dirP)</span>
                                    </a>
                                </th>
                            }
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var p in premiosWeb.Items)
                        {
                            <tr>
                                <td>@Fecha(p.Fecha)</td>
                                <td><strong>@p.Vendedor</strong></td>
                                <td>@p.Loteria</td>
                                <td>@p.Numero</td>
                                <td class="num">@Pesos(p.ValorApostado)</td>
                                <td class="num"><strong>@Pesos(p.ValorPremio)</strong></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                ViewData["PagerPageKey"] = "pageP";
                ViewData["PagerPageSizeKey"] = "pageSizeP";
                <partial name="_Pager" model="premiosWeb" />
            }
        </section>
    </div>
    }

    @if (Model.Egresos.IncluyeCubierto)
    {
    <div class="informe-movible is-media" data-seccion="cubiertoloterias" style="order: @secciones.Posicion("cubiertoloterias")">
    <partial name="_MoverSeccion" model='(secciones, "cubiertoloterias")' />
            <section class="informe-grafico" aria-labelledby="informeEgresosCubiertoLoteria">
                <h5 id="informeEgresosCubiertoLoteria">@UiTexts.InformeCubiertoPorLoteria</h5>
                <p>@UiTexts.InformeCubiertoPorLoteriaAyuda</p>
                @if (Model.Egresos.CubiertoPorLoteria.Count == 0)
                {
                    <p class="empty">@UiTexts.InformeSinCubiertos</p>
                }
                else
                {
                    <ul class="informe-barras">
                        @foreach (var loteria in Model.Egresos.CubiertoPorLoteria)
                        {
                            <li>
                                <div class="informe-barra-head">
                                    <span>@loteria.Texto <small>@string.Format(UiTexts.InformeCubiertosCantidad, Numero(loteria.Cantidad))</small></span>
                                    <strong>@Pesos(loteria.Valor) <small>@Porc(loteria.Porcentaje) %</small></strong>
                                </div>
                                <div class="informe-barra" aria-hidden="true"><i style="width: @Css(loteria.Ancho)%"></i></div>
                            </li>
                        }
                    </ul>
                }
            </section>
    </div>

    <div class="informe-movible" data-seccion="cubiertos" style="order: @secciones.Posicion("cubiertos")">
    <partial name="_MoverSeccion" model='(secciones, "cubiertos")' />
        <section class="informe-tabla" id="informeEgresosCubiertosSeccion" aria-labelledby="informeEgresosCubiertos">
            <div class="informe-tabla-head">
                <div>
                    <h5 id="informeEgresosCubiertos">@UiTexts.InformeCubiertos</h5>
                    <p>@UiTexts.InformeCubiertosAyuda</p>
                </div>
                <form method="get" asp-action="Index" class="informe-filas" data-submit-on-change>
                    @foreach (var q in conservar(["pageC", "pageSizeC"]))
                    {
                        <input type="hidden" name="@q.Key" value="@q.Value" />
                    }
                    <label for="informeEgresosPageSizeC">@UiTexts.FilasPorPagina</label>
                    <select id="informeEgresosPageSizeC" name="pageSizeC">
                        @foreach (var size in PagingHelper.PageSizes)
                        {
                            <option value="@size" selected="@(Model.Egresos.Cubiertos.PageSize == size)">@size</option>
                        }
                    </select>
                </form>
            </div>
            @if (Model.Egresos.Cubiertos.TotalCount == 0)
            {
                <p class="empty">@UiTexts.InformeSinCubiertos</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="informe-table">
                        <thead>
                        <tr>
                            @foreach (var (clave, texto, numero) in new[]
                            {
                                (VentasInforme.CubiertoFecha, UiTexts.Fecha, false),
                                (VentasInforme.CubiertoLoteria, UiTexts.Loteria, false),
                                (VentasInforme.CubiertoNumero, UiTexts.InformeColumnaNumero, false),
                                (VentasInforme.CubiertoQuien, UiTexts.InformeColumnaQuienCubrio, false),
                                (VentasInforme.CubiertoSubtotal, UiTexts.Subtotal, true),
                                (VentasInforme.CubiertoDescuento, UiTexts.Descuento, true),
                                (VentasInforme.CubiertoPagado, UiTexts.InformeColumnaValorPagado, true)
                            })
                            {
                                <partial name="_ColumnaOrden" model='new ColumnaOrdenViewModel { Clave = clave, Texto = texto, Estado = Model.Egresos.OrdenCubiertos, ParamOrden = "ordenC", ParamDireccion = "dirC", ParamPagina = "pageC", Ancla = "informeEgresosCubiertosSeccion", Numero = numero }' />
                            }
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var c in Model.Egresos.Cubiertos.Items)
                        {
                            <tr>
                                <td>@c.Fecha.ToString("dd/MM/yyyy", cultura)</td>
                                <td>@c.Loteria</td>
                                <td><strong>@c.Numero</strong></td>
                                <td>@c.CubiertoPor</td>
                                <td class="num">@Pesos(c.Subtotal)</td>
                                <td class="num">
                                    @Pesos(c.Descuento)
                                    @if (c.DescuentoPorcentaje is { } porcentaje)
                                    {
                                        <small>(@Porc(porcentaje) %)</small>
                                    }
                                </td>
                                <td class="num"><strong>@Pesos(c.Pagado)</strong></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                ViewData["PagerPageKey"] = "pageC";
                ViewData["PagerPageSizeKey"] = "pageSizeC";
                <partial name="_Pager" model="Model.Egresos.Cubiertos" />
            }
        </section>
    </div>
    }

    @if (Model.Egresos.IncluyeGastos)
    {
    <div class="informe-movible" data-seccion="gastos" style="order: @secciones.Posicion("gastos")">
    <partial name="_MoverSeccion" model='(secciones, "gastos")' />
        <section class="informe-tabla" id="informeEgresosGastosPersonaSeccion" aria-labelledby="informeEgresosGastosPersona">
            <div class="informe-tabla-head">
                <div>
                    <h5 id="informeEgresosGastosPersona">@UiTexts.InformeGastosPorPersona</h5>
                    <p>@UiTexts.InformeGastosPorPersonaAyuda</p>
                </div>
                <form method="get" asp-action="Index" class="informe-filas" data-submit-on-change>
                    @foreach (var q in conservar(["pageG", "pageSizeG"]))
                    {
                        <input type="hidden" name="@q.Key" value="@q.Value" />
                    }
                    <label for="informeEgresosPageSizeG">@UiTexts.FilasPorPagina</label>
                    <select id="informeEgresosPageSizeG" name="pageSizeG">
                        @foreach (var size in PagingHelper.PageSizes)
                        {
                            <option value="@size" selected="@(Model.Egresos.GastosPorPersona.PageSize == size)">@size</option>
                        }
                    </select>
                </form>
            </div>
            @if (Model.Egresos.GastosPorPersona.TotalCount == 0)
            {
                <p class="empty">@UiTexts.InformeSinGastos</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="informe-table">
                        <thead>
                        <tr>
                            @foreach (var columna in columnasGastos)
                            {
                                <th scope="col" class="@(columna.Numero ? "num" : null)" aria-sort="@OrdenTabla.Sort(columna.Clave, ordenG, dirG)">
                                    <a class="table-sort" href="@UrlOrdenGastos(columna.Clave)" aria-label="@EtiquetaGastos(columna.Clave, columna.Texto)">
                                        @columna.Texto <span aria-hidden="true">@OrdenTabla.Marca(columna.Clave, ordenG, dirG)</span>
                                    </a>
                                </th>
                            }
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var p in Model.Egresos.GastosPorPersona.Items)
                        {
                            <tr>
                                <td>@p.Fecha.ToString("dd/MM/yyyy", cultura)</td>
                                <td><strong>@p.Persona</strong></td>
                                <td>@p.Tipo</td>
                                <td class="num"><strong>@Pesos(p.Total)</strong></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                ViewData["PagerPageKey"] = "pageG";
                ViewData["PagerPageSizeKey"] = "pageSizeG";
                <partial name="_Pager" model="Model.Egresos.GastosPorPersona" />
            }
            @if (Model.Egresos.AnuladosCantidad > 0)
            {
                <p class="informe-nota">@string.Format(UiTexts.InformeGastosAnulados, Numero(Model.Egresos.AnuladosCantidad), Pesos(Model.Egresos.AnuladosValor))</p>
            }
        </section>
    </div>
    }
</div>
