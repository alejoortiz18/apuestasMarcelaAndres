@using System.Globalization
@using NewRich.Admin.Constants
@using NewRich.Admin.Models
@using NewRich.Admin.Services
@model InformeEgresosViewModel
@{
    var cultura = CultureInfo.GetCultureInfo("es-CO");
    var r = Model.Resumen;
    string Numero(int valor) => valor.ToString("N0", cultura);
    string Porc(decimal valor) => valor.ToString("0.#", cultura);
    string Css(decimal valor) => valor.ToString("0.##", CultureInfo.InvariantCulture);
    string Pesos(decimal valor) => FormatoPesos.De(valor);
    string Corto(decimal valor) => Math.Abs(valor) >= 1_000_000m
        ? string.Format(UiTexts.InformeMillones, (valor / 1_000_000m).ToString("0.#", cultura))
        : Math.Abs(valor) >= 1_000m
            ? string.Format(UiTexts.InformeMiles, Math.Round(valor / 1_000m, 0, MidpointRounding.AwayFromZero).ToString("0", cultura))
            : valor.ToString("0", cultura);
    string Segmento(SegmentoValorInforme s) => string.Format(UiTexts.InformeSegmento, s.Texto, Pesos(s.Valor), Porc(s.Porcentaje));
    string Fecha(DateOnly fecha) => fecha.ToString("dd/MM/yyyy", cultura);
    string Periodo() => Model.Desde == Model.Hasta ? Fecha(Model.Desde) : string.Format(UiTexts.InformeRangoTexto, Fecha(Model.Desde), Fecha(Model.Hasta));

    string Dona(IReadOnlyList<SegmentoValorInforme> segmentos)
    {
        var partes = new List<string>();
        var acumulado = 0m;
        var conValor = segmentos.Where(s => s.Valor > 0).ToList();
        for (var i = 0; i < conValor.Count; i++)
        {
            var fin = i == conValor.Count - 1 ? 100m : Math.Min(100m, acumulado + conValor[i].Porcentaje);
            partes.Add($"var(--informe-tono-{i % 6 + 1}) {Css(acumulado)}% {Css(fin)}%");
            acumulado = fin;
        }
        return partes.Count == 0 ? "var(--line) 0 100%" : string.Join(", ", partes);
    }

    var conceptos = Model.Egresos.Conceptos.Where(c => c.Valor > 0).ToList();
    var conservar = (string[] quitar) => Context.Request.Query.Where(q => !quitar.Contains(q.Key, StringComparer.OrdinalIgnoreCase));
}
<div class="informe-reporte informe-egresos" aria-labelledby="informeEgresosReporteTitulo">
    <header class="informe-reporte-head">
        <div>
            <h3 id="informeEgresosReporteTitulo">@UiTexts.InformeEgresosNombre</h3>
            <p>@string.Format(UiTexts.InformeCorte, Model.Corte.ToString("dd/MM/yyyy hh:mm tt", cultura))</p>
        </div>
        <ul class="informe-ventas-alcance">
            <li>@string.Format(UiTexts.InformePeriodoTexto, Periodo())</li>
            <li>@string.Format(UiTexts.InformeAlcanceTexto, Model.Alcance)</li>
        </ul>
    </header>

    <section class="informe-bloque" aria-label="@UiTexts.InformeEgresosNombre">
        <div class="informe-graficos">
            <section class="informe-grafico" aria-labelledby="informeEgresosConceptos">
                <h5 id="informeEgresosConceptos">@UiTexts.InformeEgresosPorConcepto</h5>
                <p>@UiTexts.InformeEgresosPorConceptoAyuda</p>
                @if (conceptos.Count == 0)
                {
                    <p class="empty">@UiTexts.InformeSinEgresos</p>
                }
                else
                {
                    <div class="informe-dona-bloque">
                        <div class="informe-dona" style="background: conic-gradient(@Dona(conceptos))" role="img" aria-label="@string.Join(". ", conceptos.Select(Segmento))">
                            <span><strong>@Corto(r.TotalEgresos)</strong><small>@UiTexts.InformeEgresosCentro</small></span>
                        </div>
                        <ul class="informe-leyenda informe-leyenda-valor">
                            @for (var i = 0; i < conceptos.Count; i++)
                            {
                                var concepto = conceptos[i];
                                <li>
                                    <i class="informe-tono-@(i % 6 + 1)" aria-hidden="true"></i>
                                    <span>@concepto.Texto</span>
                                    <strong>@Pesos(concepto.Valor)</strong>
                                    <small>@Porc(concepto.Porcentaje) %</small>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </section>

            <section class="informe-grafico" aria-labelledby="informeEgresosTiposGasto">
                <h5 id="informeEgresosTiposGasto">@UiTexts.InformeGastosPorTipo</h5>
                <p>@UiTexts.InformeGastosPorTipoAyuda</p>
                @if (Model.Egresos.GastosPorTipo.Count == 0)
                {
                    <p class="empty">@UiTexts.InformeSinGastos</p>
                }
                else
                {
                    <ul class="informe-barras">
                        @foreach (var tipo in Model.Egresos.GastosPorTipo)
                        {
                            <li>
                                <div class="informe-barra-head">
                                    <span>@tipo.Texto</span>
                                    <strong>@Pesos(tipo.Valor) <small>@Porc(tipo.Porcentaje) %</small></strong>
                                </div>
                                <div class="informe-barra is-gasto" aria-hidden="true"><i style="width: @Css(tipo.Ancho)%"></i></div>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <section class="informe-tabla" aria-labelledby="informeEgresosGastosPersona">
            <div class="informe-tabla-head">
                <div>
                    <h5 id="informeEgresosGastosPersona">@UiTexts.InformeGastosPorPersona</h5>
                    <p>@UiTexts.InformeGastosPorPersonaAyuda</p>
                </div>
                <form method="get" asp-action="Index" class="informe-filas" data-submit-on-change>
                    @foreach (var q in conservar(["pageG", "pageSizeG"]))
                    {
                        <input type="hidden" name="@q.Key" value="@q.Value" />
                    }
                    <label for="informeEgresosPageSizeG">@UiTexts.FilasPorPagina</label>
                    <select id="informeEgresosPageSizeG" name="pageSizeG">
                        @foreach (var size in PagingHelper.PageSizes)
                        {
                            <option value="@size" selected="@(Model.Egresos.GastosPorPersona.PageSize == size)">@size</option>
                        }
                    </select>
                </form>
            </div>
            @if (Model.Egresos.GastosPorPersona.TotalCount == 0)
            {
                <p class="empty">@UiTexts.InformeSinGastos</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="informe-table">
                        <thead>
                        <tr>
                            <th scope="col">@UiTexts.InformeColumnaPersona</th>
                            <th scope="col" class="num">@UiTexts.InformeColumnaGastos</th>
                            <th scope="col">@UiTexts.InformeColumnaTipoPrincipal</th>
                            <th scope="col" class="num">@UiTexts.Total</th>
                            <th scope="col">@UiTexts.InformeColumnaParticipacion</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var p in Model.Egresos.GastosPorPersona.Items)
                        {
                            <tr>
                                <td><strong>@p.Persona</strong></td>
                                <td class="num">@Numero(p.Cantidad)</td>
                                <td>@p.TipoPrincipal</td>
                                <td class="num"><strong>@Pesos(p.Total)</strong></td>
                                <td>
                                    <div class="informe-participacion">
                                        <div class="informe-barra is-gasto" aria-hidden="true"><i style="width: @Css(p.Participacion)%"></i></div>
                                        <small>@Porc(p.Participacion) %</small>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                ViewData["PagerPageKey"] = "pageG";
                ViewData["PagerPageSizeKey"] = "pageSizeG";
                <partial name="_Pager" model="Model.Egresos.GastosPorPersona" />
            }
            @if (Model.Egresos.AnuladosCantidad > 0)
            {
                <p class="informe-nota">@string.Format(UiTexts.InformeGastosAnulados, Numero(Model.Egresos.AnuladosCantidad), Pesos(Model.Egresos.AnuladosValor))</p>
            }
        </section>
    </section>
</div>
