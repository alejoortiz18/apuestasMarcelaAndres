@using NewRich.Admin.Constants
@using NewRich.Admin.Services
@using NewRich.Application.Services
@using NewRich.Domain.Enums
@using NewRich.Domain.Services
@model NewRich.Admin.Models.ConfiguracionIndexViewModel
@{
    string UrlCatalogo(string? jornada, string orden, string dir) => Url.Action(
        "Index", "Configuracion",
        new { q = Model.Busqueda, jornada, orden, dir, pageSize = Model.Pagina.PageSize },
        null, null, "catalogo-loterias") ?? "#";
    string UrlOrdenCatalogo(string columna) =>
        UrlCatalogo(Model.Jornada, columna, CatalogoLoteriasOrden.SiguienteDireccion(columna, Model.Orden, Model.Direccion));
    string MarcaOrdenCatalogo(string columna) => CatalogoLoteriasOrden.Marca(columna, Model.Orden, Model.Direccion);
    string EtiquetaOrdenCatalogo(string columna, string nombre) => string.Format(
        CatalogoLoteriasOrden.SiguienteDireccion(columna, Model.Orden, Model.Direccion) == "asc" ? UiTexts.OrdenarColumnaAsc : UiTexts.OrdenarColumnaDesc,
        nombre);
    if (!string.IsNullOrWhiteSpace(Model.AvisoVersiones))
    {
        ViewData["AvisoPagina"] = Model.AvisoVersiones;
    }
}
<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.ConfigKicker</div>
        <h1>@UiTexts.ConfigTitulo</h1>
        <p>@UiTexts.ConfigSub</p>
    </div>
</div>
<form asp-action="Guardar" method="post" class="config-form" id="config-operativa" data-protected-action="@AccionesProtegidas.ConfiguracionGuardar">
    <div class="config-grid">
        <section class="kpi-section">
            <h2>@UiTexts.ConfigSesion</h2>
            <div class="field">
                <label asp-for="Form.MinutosInactividadSesion"></label>
                <input asp-for="Form.MinutosInactividadSesion" type="number" min="1" max="480" />
                <span class="field-help">@UiTexts.MinutosInactividadSesionAyuda</span>
                <span asp-validation-for="Form.MinutosInactividadSesion"></span>
            </div>
        </section>
        <section class="kpi-section">
            <h2>@UiTexts.ConfigHorarioPremios</h2>
            <div class="field">
                <label asp-for="Form.VigenciaPremiosDias"></label>
                <input asp-for="Form.VigenciaPremiosDias" type="number" min="1" />
                <span asp-validation-for="Form.VigenciaPremiosDias"></span>
            </div>
        </section>
        <section class="kpi-section">
            <h2>@UiTexts.ConfigApuestas</h2>
            <div class="field">
                <label asp-for="Form.MaxJuegosCombinado"></label>
                <input asp-for="Form.MaxJuegosCombinado" type="number" min="1" />
                <span asp-validation-for="Form.MaxJuegosCombinado"></span>
            </div>
            <div class="field">
                <label asp-for="Form.MaxLineasIndividual"></label>
                <input asp-for="Form.MaxLineasIndividual" type="number" min="1" max="6" />
                <span asp-validation-for="Form.MaxLineasIndividual"></span>
            </div>
        </section>
        <section class="kpi-section">
            <h2>@UiTexts.ConfigAlertas</h2>
            <div class="field">
                <label asp-for="Form.AlertaRepeticionNumero"></label>
                <input asp-for="Form.AlertaRepeticionNumero" type="number" min="1" />
                <span asp-validation-for="Form.AlertaRepeticionNumero"></span>
            </div>
            <div class="field">
                <label asp-for="Form.AlertaValorMinimo"></label>
                <input asp-for="Form.AlertaValorMinimo" type="number" min="0" />
                <span asp-validation-for="Form.AlertaValorMinimo"></span>
            </div>
        </section>
        <section class="kpi-section">
            <h2>@UiTexts.ConfigOffline</h2>
            <div class="field">
                <label asp-for="Form.CodigosOfflineCapacidad"></label>
                <input asp-for="Form.CodigosOfflineCapacidad" type="number" min="0" />
                <span asp-validation-for="Form.CodigosOfflineCapacidad"></span>
            </div>
            <div class="field">
                <label asp-for="Form.ReposicionDiariaOffline"></label>
                <label class="check">
                    <input asp-for="Form.ReposicionDiariaOffline" />
                    <span>@UiTexts.ReposicionDiariaOfflineAyuda</span>
                </label>
            </div>
            <div class="field">
                <label asp-for="Form.PermitirJuegosOffline"></label>
                <label class="check">
                    <input asp-for="Form.PermitirJuegosOffline" />
                    <span>@UiTexts.PermitirJuegosOfflineAyuda</span>
                </label>
            </div>
            <div class="field">
                <label asp-for="Form.DiasInactividadEliminarPda"></label>
                <input asp-for="Form.DiasInactividadEliminarPda" type="number" min="1" />
                <span class="field-help">@UiTexts.DiasInactividadEliminarPdaAyuda</span>
                <span asp-validation-for="Form.DiasInactividadEliminarPda"></span>
            </div>
            <div class="field">
                <label asp-for="Form.SincronizacionModo"></label>
                <select asp-for="Form.SincronizacionModo" class="searchable">
                    <option value="Manual">@UiTexts.ModoManual</option>
                    <option value="Automatica">@UiTexts.ModoAutomatica</option>
                </select>
                <span asp-validation-for="Form.SincronizacionModo"></span>
            </div>
        </section>
        <section class="kpi-section">
            <h2>@UiTexts.ConfigRetencion</h2>
            <div class="field">
                <label for="meses-maximos-retencion">@UiTexts.MesesMaximosRetencion</label>
                <input id="meses-maximos-retencion" type="text" value="6" readonly disabled />
                <span class="field-help">@UiTexts.MesesMaximosRetencionAyuda</span>
            </div>
            <div class="field">
                <label asp-for="Form.MesesAEliminar"></label>
                <select asp-for="Form.MesesAEliminar" class="searchable">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                </select>
                <span class="field-help">@UiTexts.MesesAEliminarAyuda</span>
                <span asp-validation-for="Form.MesesAEliminar"></span>
            </div>
        </section>
        <section class="kpi-section kpi-section-wide">
            <h2>@UiTexts.ConfigTirilla</h2>
            <div class="field">
                <label asp-for="Form.LeyendaTirilla"></label>
                <textarea asp-for="Form.LeyendaTirilla" rows="6" maxlength="4000"></textarea>
                <span class="field-help">@UiTexts.LeyendaTirillaAyuda</span>
                <span asp-validation-for="Form.LeyendaTirilla"></span>
            </div>
            <div class="field">
                <label asp-for="Form.MensajeSuperacionTope"></label>
                <textarea asp-for="Form.MensajeSuperacionTope" rows="6" maxlength="4000"></textarea>
                <span class="field-help">@UiTexts.MensajeSuperacionTopeAyuda</span>
                <span asp-validation-for="Form.MensajeSuperacionTope"></span>
            </div>
        </section>
    </div>
    <div class="config-save">
        <button class="primary" type="submit">@UiTexts.GuardarConfiguracion</button>
    </div>
</form>
<form asp-action="PublicarVersion" method="post" enctype="multipart/form-data" class="config-form" id="version-aplicacion" data-protected-action="@AccionesProtegidas.ConfiguracionVersionAplicacion" data-msg-subiendo="@UiTexts.SubiendoArchivo" data-msg-guardando="@UiTexts.GuardandoVersion" data-msg-lista="@UiTexts.VersionLista" data-msg-error="@UiTexts.ErrorAlPublicarVersion" data-msg-tamano="@UiTexts.ArchivoSuperaTamano" data-msg-sesion="@UiTexts.SesionExpiradaAlPublicar" data-tamano-maximo="209715200">
    @Html.AntiForgeryToken()
    <section class="kpi-section kpi-section-wide">
        <h2>@UiTexts.ConfigVersionAplicacion</h2>
        <p>@UiTexts.ConfigVersionAplicacionSub</p>
        @if (Model.Versiones.Count == 0)
        {
            if (string.IsNullOrWhiteSpace(Model.AvisoVersiones))
            {
                <div class="empty">@UiTexts.VacioVersionesAplicacion</div>
            }
        }
        else
        {
            <ul class="version-aplicacion-lista">
                @foreach (var version in Model.Versiones)
                {
                    var publicada = ZonaHorariaColombia.ALocal(version.FechaPublicacion).ToString("dd/MM/yyyy HH:mm");
                    <li>
                        <strong>@version.NombreVersion</strong>
                        @if (version.Vigente)
                        {
                            <span class="pill ok">@UiTexts.VersionVigente</span>
                        }
                        <span>@UiTexts.Compilacion @version.NumeroCompilacion</span>
                        <span>@UiTexts.PublicadaEl @publicada</span>
                    </li>
                }
            </ul>
        }
        <div class="field">
            <label for="archivo-apk">@UiTexts.ArchivoApk</label>
            <input id="archivo-apk" name="archivo" type="file" accept=".apk,application/vnd.android.package-archive" required />
            <span class="field-help">@UiTexts.ArchivoApkAyuda</span>
        </div>
        <div class="field">
            <label for="nombre-version">@UiTexts.NombreVersion</label>
            <input id="nombre-version" name="nombreVersion" type="text" maxlength="20" required autocomplete="off" />
            <span class="field-help">@UiTexts.NombreVersionAyuda</span>
        </div>
        <div class="field">
            <label for="numero-compilacion">@UiTexts.NumeroCompilacion</label>
            <input id="numero-compilacion" name="numeroCompilacion" type="number" min="1" step="1" required />
            <span class="field-help">@UiTexts.NumeroCompilacionAyuda</span>
        </div>
        <div id="version-progreso" class="version-progreso" hidden>
            <p id="version-progreso-texto" role="status" aria-live="polite"></p>
            <div class="version-progreso-pista">
                <span id="version-progreso-barra" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-labelledby="version-progreso-texto"></span>
            </div>
        </div>
        <div class="config-save">
            <button class="primary" type="submit">@UiTexts.PublicarVersion</button>
        </div>
    </section>
</form>
<form asp-action="GuardarDias" method="post" class="dias-venta" id="dias-venta" data-protected-action="@AccionesProtegidas.ConfiguracionDias">
    @Html.AntiForgeryToken()
    <section class="kpi-section kpi-section-wide dias-venta-panel" data-resumen="@UiTexts.LoteriasHabilitadasDelDia">
        <h2>@UiTexts.ConfigDiasVenta</h2>
        <p>@UiTexts.ConfigDiasVentaSub</p>
        @if (Model.DiasVenta.Count == 0)
        {
            <div class="empty">@UiTexts.VacioDiasVenta</div>
        }
        else
        {
            <div class="dias-venta-semana" role="tablist" aria-label="@UiTexts.DiaDeLaSemana">
                @foreach (var dia in DiasVentaLoteria.Semana)
                {
                    var activo = dia == DiaSemana.Lunes;
                    <button type="button"
                            class="dias-venta-tab@(activo ? " is-active" : null)"
                            role="tab"
                            id="dia-tab-@((byte)dia)"
                            aria-selected="@(activo ? "true" : "false")"
                            aria-controls="dia-panel"
                            data-dia="@((byte)dia)">
                        @DiasVentaLoteria.Nombre(dia)
                    </button>
                }
            </div>
            <div class="dias-venta-toolbar">
                <div class="field">
                    <label for="buscar-dia-loteria">@UiTexts.BuscarLoteriaDia</label>
                    <input id="buscar-dia-loteria" type="search" autocomplete="off" placeholder="@UiTexts.PlaceholderLoteria" />
                </div>
                <p class="dias-venta-resumen" id="dias-venta-resumen" aria-live="polite"></p>
            </div>
            <div class="dias-venta-lista" id="dia-panel" role="tabpanel" aria-labelledby="dia-tab-1" data-dia-activo="1">
                @for (var i = 0; i < Model.DiasVenta.Count; i++)
                {
                    var item = Model.DiasVenta[i];
                    <input type="hidden" name="DiasVenta[@i].LoteriaId" value="@item.LoteriaId" />
                    @foreach (var dia in DiasVentaLoteria.Semana)
                    {
                        var marcado = item.DiasHabilitados.Contains(dia);
                        <label class="dias-venta-fila" data-dia="@((byte)dia)" data-nombre="@item.Nombre">
                            <input type="checkbox"
                                   name="DiasVenta[@i].DiasHabilitados"
                                   value="@((byte)dia)"
                                   @(marcado ? "checked" : null)
                                   aria-label="@item.Nombre @DiasVentaLoteria.Nombre(dia)" />
                            <span>
                                <strong>@item.Nombre</strong>
                                <span class="pill @(item.Estado == EstadoGeneral.Activo ? "ok" : "info")">@item.Estado</span>
                            </span>
                        </label>
                    }
                }
            </div>
            <div class="config-save">
                <button class="primary" type="submit">@UiTexts.GuardarDiasVenta</button>
            </div>
        }
    </section>
</form>
<form asp-action="GuardarTopes" method="post" class="panel topes-panel" data-protected-action="@AccionesProtegidas.ConfiguracionTopes">
    @Html.AntiForgeryToken()
    <div class="panel-head">
        <div>
            <h2>@UiTexts.ConfigTopes</h2>
            <div class="panel-sub">@UiTexts.ConfigTopesSub</div>
        </div>
    </div>
    @if (!Model.Topes.Any())
    {
        <div class="empty">@UiTexts.Vacio</div>
    }
    else
    {
        <div data-topes-jornadas>
        <div class="jornada-filtro" role="tablist" aria-label="@UiTexts.TopesPorJornada">
            @foreach (var (opcion, indice) in new[] { JornadaPorHoraCierre.Manana, JornadaPorHoraCierre.Tarde, JornadaPorHoraCierre.Noche, string.Empty }.Select((o, i) => (o, i)))
            {
                var todas = opcion.Length == 0;
                <button type="button"
                        class="jornada-filtro-opcion@(todas ? " is-active" : null)"
                        role="tab"
                        id="tope-tab-@indice"
                        aria-selected="@(todas ? "true" : "false")"
                        aria-controls="topes-tabla-panel"
                        tabindex="@(todas ? "0" : "-1")"
                        data-jornada="@opcion">@(todas ? UiTexts.TodasLasJornadas : opcion)</button>
            }
        </div>
        <p class="empty" data-topes-vacio hidden>@UiTexts.Vacio</p>
        <div class="table-wrap" id="topes-tabla-panel" role="tabpanel" aria-labelledby="tope-tab-3">
            <table class="topes-tabla">
                <thead>
                <tr>
                    <th>@UiTexts.Loteria</th>
                    <th class="topes-col-valor">@UiTexts.TopeLoteria</th>
                    <th class="topes-col-estado">@UiTexts.Estado</th>
                </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.Topes.Count; i++)
                {
                    var item = Model.Topes[i];
                    var topeEntero = decimal.ToInt64(Math.Truncate(item.Tope));
                    var topeVisible = topeEntero.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("es-CO"));
                    var jornadaTope = TimeSpan.TryParse(item.HoraFin, out var horaFinTope)
                        ? JornadaPorHoraCierre.Nombre(horaFinTope)
                        : string.Empty;
                    <tr data-jornada="@jornadaTope">
                        <td><strong>@item.Nombre</strong></td>
                        <td class="topes-col-valor">
                            <input type="hidden" name="topes[@i].LoteriaId" value="@item.LoteriaId" />
                            <div class="money-input">
                                <span class="money-prefix" aria-hidden="true">@UiTexts.SimboloPesos</span>
                                <input type="text"
                                       class="money-visible"
                                       inputmode="numeric"
                                       autocomplete="off"
                                       data-miles
                                       value="@topeVisible"
                                       aria-label="@UiTexts.TopeLoteria @item.Nombre" />
                                <input type="hidden" name="topes[@i].Tope" value="@topeEntero" />
                            </div>
                        </td>
                        <td class="topes-col-estado">
                            @if (item.Tope <= 0)
                            {
                                <span class="pill info">@UiTexts.TopeSinUso</span>
                            }
                            else
                            {
                                <span class="pill ok">@UiTexts.TopeEnUso</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        </div>
        <div class="config-save">
            <button class="primary" type="submit">@UiTexts.GuardarTopes</button>
        </div>
    }
</form>
<div class="panel">
    <div class="panel-head">
        <div>
            <h2>@UiTexts.ConfigNumerosRestringidos</h2>
            <div class="panel-sub">@UiTexts.ConfigNumerosRestringidosSub</div>
        </div>
    </div>
    <form asp-action="AgregarNumeroRestringido" method="post" class="toolbar" data-protected-action="@AccionesProtegidas.ConfiguracionNumerosRestringidos">
        @Html.AntiForgeryToken()
        <div class="field">
            <label for="numero">@UiTexts.NumeroRestringido</label>
            <input id="numero" name="numero" value="@Model.NuevoNumeroRestringido" maxlength="4" inputmode="numeric" pattern="[0-9]{3,4}" placeholder="1234" />
            <span class="field-help">@UiTexts.NumeroRestringidoAyuda</span>
        </div>
        <button class="primary" type="submit">@UiTexts.AgregarNumeroRestringido</button>
    </form>
    <form class="toolbar" method="get">
        <input type="hidden" name="q" value="@Model.Busqueda" />
        <input type="hidden" name="pageSize" value="@Model.Pagina.PageSize" />
        <div class="field">
            <label for="pageSizeNumeros">@UiTexts.FilasPorPagina</label>
            <select id="pageSizeNumeros" name="pageSizeNumeros" class="searchable">
                @foreach (var size in PagingHelper.PageSizes)
                {
                    <option value="@size" @(Model.PaginaNumeros.PageSize == size ? "selected" : null)>@size</option>
                }
            </select>
        </div>
        <button class="primary" type="submit">@UiTexts.Buscar</button>
    </form>
    @if (!Model.PaginaNumeros.Items.Any())
    {
        <div class="empty">@UiTexts.VacioNumerosRestringidos</div>
    }
    else
    {
        <div class="table-wrap">
            <table data-table-select="config-numeros">
                <thead>
                <tr>
                    <th class="col-check"><span class="visually-hidden">@UiTexts.SeleccionarFila</span></th>
                    <th>@UiTexts.NumeroRestringido</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.PaginaNumeros.Items)
                {
                    <tr tabindex="0" data-row-id="@item.NumeroRestringidoId">
                        <td class="col-check">
                            <input class="row-check" type="checkbox" value="@item.NumeroRestringidoId" aria-label="@UiTexts.SeleccionarFila @item.Numero" />
                        </td>
                        <td><strong>@item.Numero</strong></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        ViewData["PagerPageKey"] = "pageNumeros";
        ViewData["PagerPageSizeKey"] = "pageSizeNumeros";
        <partial name="_Pager" model="Model.PaginaNumeros" />
        ViewData["PagerPageKey"] = "page";
        ViewData["PagerPageSizeKey"] = "pageSize";
        <div class="table-actions" data-table-panel="config-numeros">
            <h2>@UiTexts.AccionesDeNumeroRestringido</h2>
            <p class="panel-sub">@UiTexts.SeleccionaParaAcciones</p>
            <div class="table-actions-buttons">
                <form method="post" data-needs-selection data-url-template="@Url.Action("EliminarNumeroRestringido")/{id}" data-protected-action="@AccionesProtegidas.ConfiguracionNumerosRestringidos" hidden>
                    @Html.AntiForgeryToken()
                    <button class="danger" type="submit" disabled>@UiTexts.Eliminar</button>
                </form>
            </div>
        </div>
    }
</div>
<div class="panel" id="catalogo-loterias">
    <div class="panel-head">
        <div>
            <h2>@UiTexts.CatalogoLoterias</h2>
            <div class="panel-sub">@UiTexts.CatalogoLoteriasSub</div>
        </div>
        <a class="primary" asp-action="CrearLoteria">@UiTexts.AgregarLoteria</a>
    </div>
    <div class="catalogo-horario">
        <div class="field">
            <label asp-for="Form.HoraCierre"></label>
            <input asp-for="Form.HoraCierre" type="time" step="60" form="config-operativa" />
            <span class="field-help">@UiTexts.HoraCierrePdaAyuda</span>
            <span asp-validation-for="Form.HoraCierre"></span>
        </div>
        <div class="field">
            <label asp-for="Form.HoraApertura"></label>
            <input asp-for="Form.HoraApertura" type="time" step="60" form="config-operativa" />
            <span class="field-help">@UiTexts.HoraAperturaPdaAyuda</span>
            <span asp-validation-for="Form.HoraApertura"></span>
        </div>
        <div class="catalogo-horario-save">
            <button class="primary" type="submit" form="config-operativa">@UiTexts.GuardarConfiguracion</button>
        </div>
    </div>
    <nav class="jornada-filtro" data-filtro-jornada aria-label="@UiTexts.FiltrarPorJornada">
        @foreach (var opcion in new[] { JornadaPorHoraCierre.Manana, JornadaPorHoraCierre.Tarde, JornadaPorHoraCierre.Noche, string.Empty })
        {
            var activa = string.Equals(opcion, Model.Jornada ?? string.Empty, StringComparison.CurrentCultureIgnoreCase);
            <a class="jornada-filtro-opcion@(activa ? " is-active" : null)"
               href="@UrlCatalogo(opcion.Length == 0 ? null : opcion, Model.Orden, Model.Direccion)"
               aria-current="@(activa ? "page" : null)">@(opcion.Length == 0 ? UiTexts.TodasLasJornadas : opcion)</a>
        }
    </nav>
    <form class="toolbar" method="get">
        <input type="hidden" name="jornada" value="@Model.Jornada" />
        <input type="hidden" name="orden" value="@Model.Orden" />
        <input type="hidden" name="dir" value="@Model.Direccion" />
        <div class="field">
            <label for="q">@UiTexts.BuscarLoteria</label>
            <input id="q" name="q" value="@Model.Busqueda" placeholder="@UiTexts.PlaceholderLoteria" />
        </div>
        <div class="field">
            <label for="pageSize">@UiTexts.FilasPorPagina</label>
            <select id="pageSize" name="pageSize" class="searchable">
                @foreach (var size in PagingHelper.PageSizes)
                {
                    <option value="@size" @(Model.Pagina.PageSize == size ? "selected" : null)>@size</option>
                }
            </select>
        </div>
        <button class="primary" type="submit">@UiTexts.Buscar</button>
        <a class="secondary" asp-action="Index">@UiTexts.LimpiarFiltros</a>
    </form>
    @if (!Model.Pagina.Items.Any())
    {
        <div class="empty">@UiTexts.Vacio</div>
    }
    else
    {
        <form asp-action="GuardarHorarios" method="post" id="horarios-loterias" data-protected-action="@AccionesProtegidas.LoteriasGuardar" data-horarios-catalogo data-horarios-guardados="@(TempData["HorariosGuardados"] is true ? "1" : null)">
            @Html.AntiForgeryToken()
            <input type="hidden" name="q" value="@Model.Busqueda" />
            <input type="hidden" name="jornada" value="@Model.Jornada" />
            <input type="hidden" name="orden" value="@Model.Orden" />
            <input type="hidden" name="dir" value="@Model.Direccion" />
            <input type="hidden" name="page" value="@Model.Pagina.Page" />
            <input type="hidden" name="pageSize" value="@Model.Pagina.PageSize" />
            <div class="table-wrap">
                <table data-table-select="config-loterias">
                    <thead>
                    <tr>
                        <th class="col-check"><span class="visually-hidden">@UiTexts.SeleccionarFila</span></th>
                        <th><a class="table-sort" href="@UrlOrdenCatalogo("nombre")" aria-label="@EtiquetaOrdenCatalogo("nombre", UiTexts.Loteria)">@UiTexts.Loteria <span aria-hidden="true">@MarcaOrdenCatalogo("nombre")</span></a></th>
                        <th><a class="table-sort" href="@UrlOrdenCatalogo("jornada")" aria-label="@EtiquetaOrdenCatalogo("jornada", UiTexts.Jornada)">@UiTexts.Jornada <span aria-hidden="true">@MarcaOrdenCatalogo("jornada")</span></a></th>
                        <th><a class="table-sort" href="@UrlOrdenCatalogo("horaFin")" aria-label="@EtiquetaOrdenCatalogo("horaFin", UiTexts.HorarioHabilitado)">@UiTexts.HorarioHabilitado <span aria-hidden="true">@MarcaOrdenCatalogo("horaFin")</span></a></th>
                        <th><a class="table-sort" href="@UrlOrdenCatalogo("estado")" aria-label="@EtiquetaOrdenCatalogo("estado", UiTexts.Estado)">@UiTexts.Estado <span aria-hidden="true">@MarcaOrdenCatalogo("estado")</span></a></th>
                    </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Pagina.Items.Count; i++)
                    {
                        var item = Model.Pagina.Items[i];
                        var flag = item.Estado == EstadoGeneral.Activo ? "activo" : "inactivo";
                        <tr tabindex="0" data-row-id="@item.LoteriaId" data-flags="@flag">
                            <td class="col-check">
                                <input class="row-check" type="checkbox" value="@item.LoteriaId" aria-label="@UiTexts.SeleccionarFila @item.Nombre" />
                            </td>
                            <td><strong>@item.Nombre</strong></td>
                            <td>@(item.JornadaNombre ?? UiTexts.NoAplica)</td>
                            <td>
                                <input type="hidden" name="horarios[@i].LoteriaId" value="@item.LoteriaId" />
                                <div class="horario-celda">
                                    <input type="time"
                                           name="horarios[@i].HoraInicio"
                                           value="@item.HoraInicio"
                                           step="60"
                                           data-loteria-id="@item.LoteriaId"
                                           data-hora="inicio"
                                           data-original="@item.HoraInicio"
                                           aria-label="@UiTexts.HoraInicioLoteria @item.Nombre" />
                                    <span class="horario-sep" aria-hidden="true">-</span>
                                    <input type="time"
                                           name="horarios[@i].HoraFin"
                                           value="@item.HoraFin"
                                           step="60"
                                           data-loteria-id="@item.LoteriaId"
                                           data-hora="fin"
                                           data-original="@item.HoraFin"
                                           aria-label="@UiTexts.HoraFinLoteria @item.Nombre" />
                                </div>
                            </td>
                            <td><span class="pill @(item.Estado == EstadoGeneral.Activo ? "ok" : "info")">@item.Estado</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div data-horarios-extra></div>
        </form>
        <div class="config-save">
            <button class="primary" type="submit" form="horarios-loterias" data-guardar-horarios disabled title="@UiTexts.GuardarHorariosDesactivado">@UiTexts.GuardarHorarios</button>
        </div>
        <div data-horarios-pager>
            <partial name="_Pager" model="Model.Pagina" />
        </div>
        <div class="table-actions" data-table-panel="config-loterias">
            <h2>@UiTexts.AccionesDeLoteria</h2>
            <p class="panel-sub">@UiTexts.SeleccionaParaAcciones</p>
            <div class="table-actions-buttons">
                <a class="secondary" data-needs-selection data-url-template="@Url.Action("EditarLoteria")/{id}" href="#" aria-disabled="true">@UiTexts.Editar</a>
                <form method="post" data-needs-selection data-show-when="activo" data-url-template="@Url.Action("CambiarEstadoLoteria")/{id}" data-protected-action="@AccionesProtegidas.LoteriasCambiarEstado" hidden>
                    @Html.AntiForgeryToken()
                    <button class="secondary" type="submit" disabled>@UiTexts.Deshabilitar</button>
                </form>
                <form method="post" data-needs-selection data-show-when="inactivo" data-url-template="@Url.Action("CambiarEstadoLoteria")/{id}" data-protected-action="@AccionesProtegidas.LoteriasCambiarEstado" hidden>
                    @Html.AntiForgeryToken()
                    <button class="secondary" type="submit" disabled>@UiTexts.Habilitar</button>
                </form>
            </div>
        </div>
    }
</div>
