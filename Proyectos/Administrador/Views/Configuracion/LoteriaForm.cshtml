@using NewRich.Admin.Constants
@using NewRich.Domain.Enums
@using NewRich.Domain.Services
@model NewRich.Admin.Models.LoteriaFormViewModel
<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.ConfigKicker</div>
        <h1>@(Model.LoteriaId.HasValue ? UiTexts.Editar : UiTexts.AgregarLoteria)</h1>
        <p>@UiTexts.CatalogoLoteriasSub</p>
    </div>
</div>
<div class="panel">
    <form method="post" data-protected-action="@AccionesProtegidas.LoteriasGuardar" data-hora-fin-jornada>
        <div class="field">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" />
            <span asp-validation-for="Nombre"></span>
        </div>
        <div class="field">
            <label asp-for="Tope"></label>
            <div class="money-input money-input-wide">
                <span class="money-prefix" aria-hidden="true">@UiTexts.SimboloPesos</span>
                <input type="text"
                       class="money-visible"
                       inputmode="numeric"
                       autocomplete="off"
                       data-miles
                       value="@decimal.ToInt64(Math.Truncate(Model.Tope)).ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("es-CO"))"
                       aria-label="@UiTexts.TopeLoteria" />
                <input type="hidden" asp-for="Tope" />
            </div>
            <span class="field-help">@UiTexts.TopeLoteriaAyuda</span>
            <span asp-validation-for="Tope"></span>
        </div>
        <div class="field">
            <label asp-for="JornadaId"></label>
            <select asp-for="JornadaId" class="searchable" data-jornada-horario>
                <option value="">@UiTexts.Jornada</option>
                @foreach (var jornada in Model.Jornadas)
                {
                    if (!JornadaPorHoraCierre.TryRangoHoraFin(jornada.Nombre, out var min, out var max))
                    {
                        continue;
                    }
                    <option value="@jornada.JornadaId"
                            data-jornada-min="@JornadaPorHoraCierre.HoraHtml(min)"
                            data-jornada-max="@JornadaPorHoraCierre.HoraHtml(max)">
                        @jornada.Nombre
                    </option>
                }
            </select>
            <span class="field-help">@UiTexts.JornadasSub</span>
            <span asp-validation-for="JornadaId"></span>
        </div>
        <div class="field">
            <label asp-for="HoraInicio"></label>
            <input asp-for="HoraInicio" type="time" step="60" />
            <span class="field-help">@UiTexts.HorarioLoteriaAyuda</span>
            <span asp-validation-for="HoraInicio"></span>
        </div>
        <div class="field">
            <label asp-for="HoraFin"></label>
            <input asp-for="HoraFin" type="time" step="60" data-hora-fin data-hora-fin-mensaje="@UiTexts.HoraFinSegunJornada" />
            <span class="field-help">@UiTexts.HoraFinSegunJornada</span>
            <span asp-validation-for="HoraFin"></span>
        </div>
        @if (!Model.LoteriaId.HasValue)
        {
            <partial name="_DiasJuegoCampos" model="Model" />
        }
        @if (Model.LoteriaId.HasValue)
        {
            <div class="field">
                <label asp-for="Estado"></label>
                <select asp-for="Estado" class="searchable" asp-items="Html.GetEnumSelectList<EstadoGeneral>()"></select>
            </div>
        }
        <div class="text-center-actions">
            <button class="primary" type="submit">@UiTexts.Guardar</button>
            <a class="secondary" asp-action="Index">@UiTexts.Cancelar</a>
        </div>
    </form>
</div>
