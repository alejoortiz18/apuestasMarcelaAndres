@using NewRich.Admin.Constants
@using NewRich.Admin.Services
@using NewRich.Domain.Enums
@model NewRich.Admin.Models.UsuarioFormViewModel
<div class="field">
    <label asp-for="NombreCompleto"></label>
    <input asp-for="NombreCompleto" />
    <span asp-validation-for="NombreCompleto"></span>
</div>
<div class="field">
    <label asp-for="Usuario"></label>
    <input asp-for="Usuario" readonly="@(Model.UsuarioId.HasValue)" />
    <span asp-validation-for="Usuario"></span>
</div>
<div class="field">
    <label asp-for="Alias"></label>
    <input asp-for="Alias" />
</div>
<div class="field">
    <label asp-for="Documento"></label>
    <input asp-for="Documento" />
</div>
<div class="field">
    <label asp-for="Celular"></label>
    <input asp-for="Celular" />
</div>
<div class="field">
    <label asp-for="Email"></label>
    <input asp-for="Email" />
</div>
<div class="field">
    <label asp-for="Rol"></label>
    <select asp-for="Rol" class="searchable" data-usuario-rol>
        @foreach (var rol in RolConsola.Asignables)
        {
            <option value="@((int)rol)" selected="@(Model.Rol == rol)">@RolUi.Nombre(rol)</option>
        }
    </select>
</div>
@if (!Model.UsuarioId.HasValue)
{
    <div class="field" data-usuario-grupo="@((int)RolUsuario.Vendedor)" hidden="@(Model.Rol != RolUsuario.Vendedor)">
        <label asp-for="GrupoId"></label>
        <select asp-for="GrupoId" class="searchable">
            <option value="">@UiTexts.Seleccionar</option>
            @foreach (var grupo in Model.Grupos)
            {
                <option value="@grupo.GrupoId">@grupo.Nombre</option>
            }
        </select>
        <span asp-validation-for="GrupoId"></span>
    </div>
}
@if (Model.UsuarioId.HasValue)
{
    <div class="field">
        <label asp-for="Estado"></label>
        <select asp-for="Estado" class="searchable" asp-items="Html.GetEnumSelectList<EstadoUsuario>()"></select>
    </div>
}
<p class="hint" role="note" data-usuario-aviso-web="@((int)RolUsuario.VendedorWeb)" hidden="@(!RolConsola.SoloSitioVendedor(Model.Rol))">@UiTexts.VendedorWebSoloSitio</p>
<fieldset class="comision-dias" data-usuario-comision="@((int)RolUsuario.Vendedor),@((int)RolUsuario.Recaudador)" hidden="@(Model.Rol is not (RolUsuario.Vendedor or RolUsuario.Recaudador))">
    <legend>@UiTexts.ComisionPorDia</legend>
    <div class="comision-dias-head">
        <p class="field-help" id="comisionDiasAyuda">@UiTexts.ComisionPorDiaAyuda</p>
        <button type="button" class="secondary comision-dias-todos" data-comision-todos>@UiTexts.ComisionAplicarTodos</button>
    </div>
    <div class="comision-dias-grid">
        @{
            var dias = new[] { "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo" };
            for (var i = 0; i < dias.Length; i++)
            {
                <div class="comision-dia">
                    <label for="PorcentajesDia_@i">@dias[i]</label>
                    <div class="comision-dia-input">
                        <input id="PorcentajesDia_@i" name="PorcentajesDia" type="number" inputmode="numeric" min="0" max="100" step="1" value="@(Model.PorcentajesDia.Length > i ? Model.PorcentajesDia[i] : 1)" required="@(Model.Rol is RolUsuario.Vendedor or RolUsuario.Recaudador)" aria-describedby="comisionDiasAyuda" />
                        <span aria-hidden="true">%</span>
                    </div>
                </div>
            }
        }
    </div>
</fieldset>
<div class="field" data-usuario-sin-dispositivo="@((int)RolUsuario.VendedorWeb)" hidden="@(RolConsola.SoloSitioVendedor(Model.Rol))">
    <label asp-for="DispositivoId"></label>
    <select asp-for="DispositivoId" class="searchable">
        <option value="">@UiTexts.SinAsociar</option>
        @foreach (var d in Model.Dispositivos)
        {
            <option value="@d.DispositivoId">@d.CodigoDispositivo · @(string.IsNullOrWhiteSpace(d.Sistema) ? "Sistema no informado" : d.Sistema)</option>
        }
    </select>
</div>
