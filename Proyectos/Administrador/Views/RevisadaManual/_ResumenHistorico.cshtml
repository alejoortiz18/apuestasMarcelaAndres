@using System.Globalization
@using NewRich.Admin.Constants
@using NewRich.Admin.Models
@model RevisadaPaginaViewModel
@{
    var cultura = CultureInfo.GetCultureInfo("es-CO");
    string Pesos(decimal valor) => valor.ToString("N0", cultura);
    var historico = Model.HistoricoResumen!;
    var columnas = new (string Clave, string Titulo, bool Numerica)[]
    {
        ("fecha", UiTexts.Fecha, false),
        ("loteria", UiTexts.Loteria, false),
        ("numero", UiTexts.NumeroJugado, false),
        ("estado", UiTexts.Estado, false),
        ("registros", UiTexts.RecubrirRegistros, true),
        ("subtotal", UiTexts.Subtotal, true)
    };
}
<section class="panel revisada-historico" aria-labelledby="revisadaHistoricoTitulo"
         data-historico
         data-url="@Url.Action("ResumenTabla")"
         data-desde="@Model.HistoricoDesde.ToString("yyyy-MM-dd")"
         data-hasta="@Model.HistoricoHasta.ToString("yyyy-MM-dd")"
         data-orden="fecha"
         data-descendente="true"
         data-asc="@UiTexts.OrdenarColumnaAsc"
         data-desc="@UiTexts.OrdenarColumnaDesc">
    <div class="revisada-historico-head">
        <h2 id="revisadaHistoricoTitulo">@UiTexts.HistoricoResumenTitulo</h2>
        <p class="revisada-historico-rango">
            <span>@UiTexts.Desde: <strong>@Model.HistoricoDesde.ToString("dd/MM/yyyy", cultura)</strong></span>
            <span>@UiTexts.Hasta: <strong>@Model.HistoricoHasta.ToString("dd/MM/yyyy", cultura)</strong></span>
        </p>
    </div>
    <dl class="revisada-totales-lista revisada-historico-resumen">
        <div><dt>@UiTexts.HistoricoFilas</dt><dd>@historico.TotalFilas.ToString("N0", cultura)</dd></div>
        <div><dt>@UiTexts.RecubrirRegistros</dt><dd>@historico.Registros.ToString("N0", cultura)</dd></div>
        <div><dt>@UiTexts.HistoricoTotalPendiente</dt><dd>@Pesos(historico.SubtotalPendiente)</dd></div>
        <div><dt>@UiTexts.HistoricoTotalCubierto</dt><dd>@Pesos(historico.SubtotalCubierto)</dd></div>
        <div class="is-principal"><dt>@UiTexts.Subtotal</dt><dd>@Pesos(historico.Subtotal)</dd></div>
    </dl>
    @if (historico.TotalFilas == 0)
    {
        <p class="empty">@UiTexts.HistoricoResumenVacio</p>
    }
    else
    {
        <div class="revisada-historico-tabla revisada-historico-resumen-tabla" data-historico-scroll>
            <table>
                <thead>
                    <tr>
                        @foreach (var (clave, titulo, numerica) in columnas)
                        {
                            var activa = clave == "fecha";
                            <th scope="col" class="@(numerica ? "num" : null)" aria-sort="@(activa ? "descending" : "none")">
                                <button type="button" class="table-sort" data-historico-orden="@clave" data-titulo="@titulo"
                                        aria-label="@string.Format(UiTexts.OrdenarColumnaAsc, titulo)">
                                    @titulo <span aria-hidden="true">@(activa ? "↓" : "↕")</span>
                                </button>
                            </th>
                        }
                        <th scope="col"><span class="sr-only">@UiTexts.DetalleApuestasTitulo</span></th>
                    </tr>
                </thead>
                <tbody data-historico-filas>
                    @await Html.PartialAsync("_ResumenFilas", new ResumenFilasViewModel { Filas = historico.Filas, HayMas = historico.HayMas, Siguiente = 2 })
                </tbody>
            </table>
            <p class="revisada-historico-cargando" data-historico-centinela>@UiTexts.HistoricoCargando</p>
        </div>
    }
</section>
