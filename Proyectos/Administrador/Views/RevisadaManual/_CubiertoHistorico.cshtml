@using System.Globalization
@using NewRich.Admin.Constants
@using NewRich.Admin.Models
@model RevisadaPaginaViewModel
@{
    var cultura = CultureInfo.GetCultureInfo("es-CO");
    string Pesos(decimal valor) => valor.ToString("N0", cultura);
    var historico = Model.Historico!;
    var columnas = new (string Clave, string Titulo, bool Numerica, bool EnPdf, string? TituloPdf)[]
    {
        ("fecha", UiTexts.Fecha, false, true, null),
        ("loteria", UiTexts.Loteria, false, true, null),
        ("numero", UiTexts.NumeroJugado, false, true, null),
        ("registros", UiTexts.RecubrirRegistros, true, false, null),
        ("subtotal", UiTexts.Subtotal, true, true, UiTexts.Valor),
        ("comision", UiTexts.Comision, true, false, null),
        ("valorcomision", UiTexts.ValorComision, true, false, null),
        ("totalcomision", UiTexts.TotalConComision, true, false, null),
        ("descuento", UiTexts.Descuento, true, false, null),
        ("valordescuento", UiTexts.ValorDescuento, true, false, null),
        ("totalpagar", UiTexts.TotalAPagar, true, true, null)
    };

    void Orden(string clave, string titulo, bool activa, string? tituloPdf)
    {
        <button type="button" class="table-sort" data-historico-orden="@clave" data-titulo="@titulo" data-pdf-texto="@tituloPdf"
                aria-label="@string.Format(UiTexts.OrdenarColumnaAsc, titulo)">
            @titulo <span aria-hidden="true">@(activa ? "↓" : "↕")</span>
        </button>
    }
}
<section class="panel revisada-historico" aria-labelledby="revisadaHistoricoTitulo"
         data-historico
         data-url="@Url.Action("CubiertoTabla")"
         data-desde="@Model.Desde.ToString("yyyy-MM-dd")"
         data-hasta="@Model.Hasta.ToString("yyyy-MM-dd")"
         data-orden="fecha"
         data-descendente="true"
         data-asc="@UiTexts.OrdenarColumnaAsc"
         data-desc="@UiTexts.OrdenarColumnaDesc">
    <div class="revisada-historico-head">
        <h2 id="revisadaHistoricoTitulo" data-pdf-texto="@UiTexts.HistoricoCubiertoPdfTitulo">@UiTexts.HistoricoCubiertoTitulo</h2>
        <p class="revisada-historico-rango">
            <span>@UiTexts.Desde: <strong>@Model.Desde.ToString("dd/MM/yyyy", cultura)</strong></span>
            <span>@UiTexts.Hasta: <strong>@Model.Hasta.ToString("dd/MM/yyyy", cultura)</strong></span>
        </p>
    </div>
    @if (historico.TotalFilas == 0)
    {
        <p class="empty">@UiTexts.HistoricoVacio</p>
    }
    else
    {
        <div class="revisada-historico-tabla" data-historico-scroll>
            <table>
                <thead>
                    <tr>
                        @foreach (var (clave, titulo, numerica, enPdf, tituloPdf) in columnas)
                        {
                            var activa = clave == "fecha";
                            if (enPdf)
                            {
                                <th scope="col" class="@(numerica ? "num" : null)" aria-sort="@(activa ? "descending" : "none")">@{ Orden(clave, titulo, activa, tituloPdf); }</th>
                            }
                            else
                            {
                                <th scope="col" class="@(numerica ? "num" : null)" aria-sort="@(activa ? "descending" : "none")" data-pdf-omitir>@{ Orden(clave, titulo, activa, tituloPdf); }</th>
                            }
                        }
                        <th scope="col" data-pdf-omitir><span class="sr-only">@UiTexts.VerDetalleCubierto</span></th>
                    </tr>
                </thead>
                <tbody data-historico-filas>
                    @await Html.PartialAsync("_CubiertoFilas", new CubiertoFilasViewModel { Filas = historico.Filas, HayMas = historico.HayMas, Siguiente = 2 })
                </tbody>
            </table>
            <p class="revisada-historico-cargando" data-historico-centinela>@UiTexts.HistoricoCargando</p>
        </div>
    }
    <dl class="revisada-totales-lista revisada-historico-pie">
        <div><dt data-pdf-texto="@UiTexts.Valor">@UiTexts.Subtotal</dt><dd>@Pesos(historico.Subtotal)</dd></div>
        <div><dt>@UiTexts.TotalValorDescuento</dt><dd>@Pesos(historico.DescuentoValor)</dd></div>
        <div class="is-principal"><dt>@UiTexts.TotalAPagar</dt><dd data-pdf-texto="@Pesos(historico.Subtotal - historico.DescuentoValor)">@Pesos(historico.TotalPagar)</dd></div>
    </dl>
</section>
