@using System.Globalization
@using NewRich.Admin.Constants
@using NewRich.Admin.Controllers
@using NewRich.Constants
@using NewRich.Domain.Services
@model NewRich.Admin.Models.RevisadaPaginaViewModel
@{
    var cultura = CultureInfo.GetCultureInfo("es-CO");
    string Pesos(decimal valor) => valor.ToString("N0", cultura);
    string Boletas(int cantidad) => cantidad == 1 ? UiTexts.UnaBoleta : string.Format(cultura, UiTexts.CantidadBoletas, cantidad);
    decimal porcentaje = 0;
    var tienePorcentaje = RevisadaManualController.Porcentaje(Model.Porcentaje, out porcentaje);
    var esCubierto = Model.Modo == "cubierto";
    string Titulo() => esCubierto ? UiTexts.NavRevisadaCubierto : UiTexts.NavRevisadaResumen;
    string Sub() => esCubierto ? UiTexts.RevisadaCubiertoSub : UiTexts.RevisadaResumenSub;
    string Accion() => esCubierto ? "Cubierto" : "Resumen";
    string Porcentajes(IEnumerable<decimal?> valores) =>
        string.Join(" y ", valores.Where(v => v.HasValue).Select(v => v!.Value.ToString("0.##", cultura)).Distinct());
    string EnlaceOrden(string orden)
    {
        var valores = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        foreach (var item in Context.Request.Query)
        {
            if (item.Key is "orden" or "page")
            {
                continue;
            }

            valores[item.Key] = item.Value.ToString();
        }

        valores["orden"] = orden;
        valores["page"] = "1";
        return Url.Action(Accion(), valores) ?? "#";
    }
}
<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.RevisadaKicker</div>
        <h1>@Titulo()</h1>
        <p>@Sub()</p>
    </div>
    @if (esCubierto)
    {
        <button class="primary revisada-exportar" type="button" title="@UiTexts.CubiertoExportarAyuda"
                data-revisada-exportar
                data-fuentes="@Url.Content("~/lib/fuentes-pdf/fuentes.css")"
                data-archivo="cubierto-@(DateTime.Now.ToString("yyyyMMdd-HHmm")).pdf"
                data-titulo="@UiTexts.NavRevisadaCubierto"
                data-generando="@UiTexts.InformePdfGenerando"
                data-error="@UiTexts.InformePdfError">@UiTexts.InformeExportarPdf</button>
    }
</div>
@if (esCubierto)
{
    <div class="revisada-pdf-resumen" aria-hidden="true" data-revisada-pdf-resumen>
        <header class="revisada-pdf-encabezado" data-pdf-encabezado>
            <p class="revisada-pdf-kicker">@UiTexts.InformePdfKicker</p>
            <h2>@UiTexts.NavRevisadaCubierto</h2>
            <p>@UiTexts.RevisadaCubiertoSub</p>
            <p class="revisada-pdf-corte">@UiTexts.CorteDeInformacion: @DateTime.Now.ToString("dd/MM/yyyy HH:mm") · @UiTexts.FuenteSql</p>
        </header>
        <section class="revisada-pdf-filtros" data-pdf-filtros>
            <h3>@UiTexts.FiltrosAplicados</h3>
            <p>@UiTexts.Desde: @Model.Desde.ToString("dd/MM/yyyy", cultura)</p>
            <p>@UiTexts.Hasta: @Model.Hasta.ToString("dd/MM/yyyy", cultura)</p>
            <p>@UiTexts.Comision: @(string.IsNullOrWhiteSpace(Model.Comision) ? "-" : Model.Comision + " %")</p>
            <p>@UiTexts.Descuento: @(string.IsNullOrWhiteSpace(Model.Porcentaje) ? "-" : Model.Porcentaje + " %")</p>
        </section>
    </div>
}
<div id="revisada-datos">
@if (Model.IncluyeHoy)
{
<div class="stats">
    <article class="stat"><small>@UiTexts.JugadasVisibles</small><strong>@Model.Jugadas.ToString("N0", cultura)</strong></article>
    <article class="stat"><small>@UiTexts.LoteriasVisibles</small><strong>@Model.Loterias.ToString("N0", cultura)</strong></article>
    <article class="stat"><small>@UiTexts.TotalAgrupado</small><strong>@Pesos(Model.Total)</strong></article>
</div>
}
<div class="panel">
    @if (esCubierto)
    {
        <form id="porcentajesForm" method="post" asp-action="GuardarPorcentajes" hidden>
            @Html.AntiForgeryToken()
            <input type="hidden" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="pageSize" value="@Model.Pagina.PageSize" />
            <input type="hidden" name="orden" value="@Model.Orden" />
        </form>
    }
    <form class="toolbar" method="get" asp-action="@Accion()">
        <div class="field">
            <label for="desde">@UiTexts.Desde</label>
            <input id="desde" name="desde" type="date" value="@Model.Desde.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="hasta">@UiTexts.Hasta</label>
            <input id="hasta" name="hasta" type="date" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
        </div>
        @if (Model.Modo == "resumen")
        {
            <div class="field">
                <label for="valorMinimo">@UiTexts.ValorMinimoVisualizar</label>
                <input id="valorMinimo" name="valorMinimo" inputmode="numeric" value="@Model.ValorMinimo" />
            </div>
        }
        else
        {
            <div class="field">
                <label for="comision">@UiTexts.Comision</label>
                <input id="comision" name="comision" form="porcentajesForm" type="number" inputmode="numeric" min="0" max="99" step="1" maxlength="2" value="@Model.Comision" data-dos-digitos autocomplete="off" />
            </div>
            <div class="field">
                <label for="porcentaje">@UiTexts.Descuento</label>
                <input id="porcentaje" name="descuento" form="porcentajesForm" type="number" inputmode="numeric" min="0" max="99" step="1" maxlength="2" value="@Model.Porcentaje" data-dos-digitos autocomplete="off" />
            </div>
            <button class="secondary" type="submit" form="porcentajesForm">@UiTexts.GuardarPorcentajes</button>
        }
        <div class="field">
            <label for="pageSize">@UiTexts.FilasPorPagina</label>
            <select id="pageSize" name="pageSize">
                @foreach (var size in PagingHelper.PageSizes)
                {
                    <option value="@size" @(Model.Pagina.PageSize == size ? "selected" : null)>@size</option>
                }
            </select>
        </div>
        <input type="hidden" name="orden" value="@Model.Orden" />
        <button class="primary" type="submit">@UiTexts.Buscar</button>
        <a class="secondary" asp-action="@Accion()">@UiTexts.Limpiar</a>
    </form>
</div>
@if (esCubierto && Model.IncluyeHoy)
{
    <h2 class="revisada-parte-titulo">@string.Format(cultura, UiTexts.CubiertoHoyTitulo, DateTime.Today.ToString("dd/MM/yyyy", cultura))</h2>
}
else if (!esCubierto && Model.IncluyeHoy && Model.HistoricoResumen is not null)
{
    <h2 class="revisada-parte-titulo">@string.Format(cultura, UiTexts.PendienteHoyTitulo, DateTime.Today.ToString("dd/MM/yyyy", cultura))</h2>
}
@if (Model.IncluyeHoy && Model.Pagina.TotalCount == 0)
{
    <div class="panel"><p>@(esCubierto ? UiTexts.CubiertoHoyVacio : UiTexts.SinJugadasRevisada)</p></div>
}
else if (Model.IncluyeHoy)
{
    <section class="panel revisada-previa revisada-modo-resumen" data-revisada-filtro>
        <div class="revisada-previa-head">
            <div>
                <h2>@UiTexts.LoteriasEnEstaPagina</h2>
                <p class="panel-sub">@UiTexts.AyudaFiltrarLoteria</p>
            </div>
            <div class="revisada-acciones">
                @if (!esCubierto)
                {
                    <button type="button" class="secondary revisada-recubrir" data-recubrir-url="@Url.Action("RecubrirPrevia")" title="@UiTexts.RecubrirAyuda" aria-haspopup="dialog">@UiTexts.RecubrirBoton</button>
                }
                <div class="revisada-orden" role="group" aria-label="@UiTexts.OrdenarPorSubtotal">
                    <a class="@(Model.Orden == "asc" ? "primary" : "secondary")" href="@EnlaceOrden("asc")" aria-pressed="@(Model.Orden == "asc" ? "true" : "false")">@UiTexts.MenorAMayor</a>
                    <a class="@(Model.Orden == "desc" ? "primary" : "secondary")" href="@EnlaceOrden("desc")" aria-pressed="@(Model.Orden == "desc" ? "true" : "false")">@UiTexts.MayorAMenor</a>
                </div>
            </div>
        </div>
        <ul>
            @foreach (var loteria in Model.Pagina.Items)
            {
                var boletas = loteria.Grupos.Sum(g => g.Lineas.Count);
                var subtotal = loteria.Grupos.Sum(g => g.Subtotal);
                <li>
                    <button type="button" class="revisada-nombre" data-loteria="@loteria.Nombre" aria-pressed="false" aria-label="@($"{UiTexts.FiltrarLoteria} {loteria.Nombre}")">
                        <span>@loteria.Nombre</span>
                        <small>@Boletas(boletas)</small>
                        <strong>@Pesos(subtotal)</strong>
                    </button>
                </li>
            }
        </ul>
    </section>
    <div class="revisada-columnas">
    @foreach (var loteria in Model.Pagina.Items)
    {
        <section class="panel revisada-loteria" data-loteria="@loteria.Nombre"
                 data-total-comision="@loteria.Grupos.Sum(g => g.TotalConComision ?? 0).ToString(CultureInfo.InvariantCulture)"
                 data-valor-descuento="@loteria.Grupos.Sum(g => g.DescuentoValor ?? 0).ToString(CultureInfo.InvariantCulture)"
                 data-total-pagar="@loteria.Grupos.Sum(g => g.TotalPagar ?? 0).ToString(CultureInfo.InvariantCulture)">
            <h2>
                <button type="button" class="table-sort revisada-orden-grupos" data-orden="" data-asc="@string.Format(UiTexts.OrdenarColumnaAsc, UiTexts.Subtotal)" data-desc="@string.Format(UiTexts.OrdenarColumnaDesc, UiTexts.Subtotal)" aria-label="@string.Format(UiTexts.OrdenarColumnaAsc, UiTexts.Subtotal)">
                    @UiTexts.Loteria: @loteria.Nombre
                    <span aria-hidden="true">↕</span>
                </button>
            </h2>
            <div class="revisada-grupos">
                @if (esCubierto)
                {
                    @foreach (var porNumero in loteria.Grupos.GroupBy(g => g.Numero))
                    {
                        var cubiertos = porNumero.OrderBy(g => g.FechaOperacion).ToList();
                        var subtotal = cubiertos.Sum(g => g.Subtotal);
                        var detalleId = $"revisada-detalle-{cubiertos[0].OperacionId}";
                        <article class="revisada-grupo" data-subtotal="@subtotal.ToString(CultureInfo.InvariantCulture)">
                            <div class="revisada-grupo-head">
                                <h3>@UiTexts.NumeroJugado: @porNumero.Key</h3>
                                <button type="button" class="revisada-ver" data-revisada-ver="@detalleId"
                                        data-titulo="@($"{UiTexts.Loteria}: {loteria.Nombre} · {UiTexts.NumeroJugado}: {porNumero.Key}")"
                                        aria-label="@($"{UiTexts.VerDetalleCubierto} {loteria.Nombre} {porNumero.Key}")" title="@UiTexts.VerDetalleCubierto">
                                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.7" /></svg>
                                </button>
                            </div>
                            <p><strong>@UiTexts.Subtotal:</strong> @Pesos(subtotal)</p>
                            <p>@UiTexts.Comision: @Porcentajes(cubiertos.Select(g => g.ComisionPorcentaje)) %</p>
                            <p>@UiTexts.ValorComision: @Pesos(cubiertos.Sum(g => g.ComisionValor ?? 0))</p>
                            <p><strong>@UiTexts.TotalConComision:</strong> @Pesos(cubiertos.Sum(g => g.TotalConComision ?? 0))</p>
                            <p>@UiTexts.Descuento: @Porcentajes(cubiertos.Select(g => g.DescuentoPorcentaje)) %</p>
                            <p>@UiTexts.ValorDescuento: @Pesos(cubiertos.Sum(g => g.DescuentoValor ?? 0))</p>
                            <p><strong>@UiTexts.TotalAPagar:</strong> @Pesos(cubiertos.Sum(g => g.TotalPagar ?? 0))</p>
                            <template id="@detalleId">
                                @foreach (var grupo in cubiertos)
                                {
                                    <article class="revisada-grupo">
                                        <h3>@UiTexts.NumeroJugado: @grupo.Numero</h3>
                                        @if (grupo.FechaOperacion is { } fechaCubierto)
                                        {
                                            <p class="revisada-fecha-cubierto">@UiTexts.CubiertoEl: @fechaCubierto.ToString("dd/MM/yyyy HH:mm", cultura)</p>
                                        }
                                        <p><strong>@UiTexts.Subtotal:</strong> @Pesos(grupo.Subtotal)</p>
                                        <p>@UiTexts.Comision: @((grupo.ComisionPorcentaje ?? 0).ToString("0.##", cultura)) %</p>
                                        <p>@UiTexts.ValorComision: @Pesos(grupo.ComisionValor ?? 0)</p>
                                        <p><strong>@UiTexts.TotalConComision:</strong> @Pesos(grupo.TotalConComision ?? 0)</p>
                                        @if (grupo.TotalPagar is not null)
                                        {
                                            <p>@UiTexts.Descuento: @((grupo.DescuentoPorcentaje ?? 0).ToString("0.##", cultura)) %</p>
                                            <p>@UiTexts.ValorDescuento: @Pesos(grupo.DescuentoValor ?? 0)</p>
                                            <p><strong>@UiTexts.TotalAPagar:</strong> @Pesos(grupo.TotalPagar.Value)</p>
                                        }
                                    </article>
                                }
                            </template>
                        </article>
                    }
                }
                else
                {
                @foreach (var grupo in loteria.Grupos)
                {
                    var comisionValor = grupo.ComisionValor;
                    var totalComision = grupo.TotalConComision ?? (comisionValor is null ? (decimal?)null : grupo.Subtotal + comisionValor);
                    var descuentoValor = grupo.DescuentoValor;
                    var totalPagar = grupo.TotalPagar;
                    <article class="revisada-grupo" data-subtotal="@grupo.Subtotal.ToString(CultureInfo.InvariantCulture)">
                        <h3>@UiTexts.NumeroJugado: @grupo.Numero</h3>
                        @if (Model.Modo == "resumen")
                        {
                            <div class="revisada-lineas">
                                <p class="revisada-lineas-titulo">@UiTexts.ValorApostado</p>
                                <ul>
                                    @foreach (var linea in grupo.Lineas)
                                    {
                                        <li>
                                            <span>@Pesos(linea.Valor)</span>
                                            <time datetime="@linea.Fecha.ToString("yyyy-MM-ddTHH:mm")">@linea.Fecha.ToString("h:mm tt", cultura)</time>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        <p><strong>@UiTexts.Subtotal:</strong> @Pesos(grupo.Subtotal)</p>
                        @if (Model.Modo != "resumen" && totalComision is not null)
                        {
                            <p>@UiTexts.Comision: @((grupo.ComisionPorcentaje ?? porcentaje).ToString("0.##", cultura)) %</p>
                            <p>@UiTexts.ValorComision: @Pesos(comisionValor ?? 0)</p>
                            <p><strong>@UiTexts.TotalConComision:</strong> @Pesos(totalComision.Value)</p>
                        }
                        @if (Model.Modo == "cubierto" && totalPagar is not null)
                        {
                            <p>@UiTexts.Descuento: @((grupo.DescuentoPorcentaje ?? porcentaje).ToString("0.##", cultura)) %</p>
                            <p>@UiTexts.ValorDescuento: @Pesos(descuentoValor ?? 0)</p>
                            <p><strong>@UiTexts.TotalAPagar:</strong> @Pesos(totalPagar.Value)</p>
                        }
                        @if (Model.Modo == "resumen")
                        {
                            <form method="post" asp-action="Cubrir">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
                                <input type="hidden" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
                                <input type="hidden" name="valorMinimo" value="@Model.ValorMinimo" />
                                <input type="hidden" name="page" value="@Model.Pagina.Page" />
                                <input type="hidden" name="pageSize" value="@Model.Pagina.PageSize" />
                                <input type="hidden" name="orden" value="@Model.Orden" />
                                @foreach (var linea in grupo.Lineas)
                                {
                                    <input type="hidden" name="claves" value="@linea.Clave" />
                                }
                                <button class="primary" type="submit" aria-label="@($"{UiTexts.BotonCubrir} {loteria.Nombre} {grupo.Numero}")">@UiTexts.BotonCubrir</button>
                            </form>
                        }
                    </article>
                }
                }
            </div>
        </section>
    }
    </div>
    @if (esCubierto)
    {
        var enPagina = Model.Pagina.Items.SelectMany(l => l.Grupos).ToList();
        <section class="panel revisada-totales" aria-labelledby="revisadaTotalesTitulo" data-revisada-totales>
            <h2 id="revisadaTotalesTitulo">@UiTexts.TotalesCubiertoTitulo</h2>
            <dl class="revisada-totales-lista">
                <div>
                    <dt>@UiTexts.TotalConComision</dt>
                    <dd data-total="comision">@Pesos(enPagina.Sum(g => g.TotalConComision ?? 0))</dd>
                </div>
                <div>
                    <dt>@UiTexts.TotalValorDescuento</dt>
                    <dd data-total="descuento">@Pesos(enPagina.Sum(g => g.DescuentoValor ?? 0))</dd>
                </div>
                <div class="is-principal">
                    <dt>@UiTexts.TotalAPagar</dt>
                    <dd data-total="pagar">@Pesos(enPagina.Sum(g => g.TotalPagar ?? 0))</dd>
                </div>
            </dl>
        </section>
    }
    @await Html.PartialAsync("_Pager", Model.Pagina)
}
@if (esCubierto && Model.Historico is not null)
{
    @await Html.PartialAsync("_CubiertoHistorico", Model)
}
</div>
@if (!esCubierto && Model.HistoricoResumen is not null)
{
    @await Html.PartialAsync("_ResumenHistorico", Model)
}
<div id="revisadaDetalle" class="dialog-back hidden" role="dialog" aria-modal="true" aria-labelledby="revisadaDetalleTitulo" hidden data-revisada-modal>
    <div class="dialog dialog-revisada">
        <h2 id="revisadaDetalleTitulo">@(esCubierto ? UiTexts.DetalleCubiertoTitulo : UiTexts.DetalleApuestasTitulo)</h2>
        <p class="dialog-revisada-sub" data-revisada-modal-sub></p>
        <div class="revisada-detalle-lista" data-revisada-modal-lista></div>
        <div class="dialog-actions">
            <button type="button" class="primary" data-revisada-modal-cerrar>@UiTexts.Cerrar</button>
        </div>
    </div>
</div>
@if (!esCubierto)
{
    <div id="revisadaRecubrir" class="dialog-back hidden" role="dialog" aria-modal="true" aria-labelledby="revisadaRecubrirTitulo" hidden data-recubrir-modal>
        <div class="dialog dialog-revisada" data-recubrir-contenido></div>
    </div>
}
<script>
    window.iniciarRevisada = function () {
        var raiz = document.querySelector("[data-revisada-filtro]");
        if (raiz) {
        var clave = "nr.revisada.loteria." + location.pathname;
        var botones = raiz.querySelectorAll(".revisada-nombre");
        var tarjetas = document.querySelectorAll(".revisada-loteria");
        function leer() {
            try {
                var guardadas = JSON.parse(sessionStorage.getItem(clave) || "[]");
                return Array.isArray(guardadas) ? guardadas : [];
            } catch (error) {
                return [];
            }
        }
        function recalcularTotales() {
            var totales = document.querySelector("[data-revisada-totales]");
            if (!totales) {
                return;
            }
            var visibles = Array.prototype.filter.call(tarjetas, function (tarjeta) { return !tarjeta.hidden; });
            function sumar(atributo) {
                return visibles.reduce(function (suma, tarjeta) { return suma + (parseFloat(tarjeta.getAttribute(atributo)) || 0); }, 0);
            }
            function pesos(valor) {
                return valor.toLocaleString("es-CO", { maximumFractionDigits: 0 });
            }
            totales.querySelector('[data-total="comision"]').textContent = pesos(sumar("data-total-comision"));
            totales.querySelector('[data-total="descuento"]').textContent = pesos(sumar("data-valor-descuento"));
            totales.querySelector('[data-total="pagar"]').textContent = pesos(sumar("data-total-pagar"));
        }
        function aplicar(nombres) {
            var vigentes = [];
            botones.forEach(function (boton) {
                var nombre = boton.getAttribute("data-loteria");
                var activo = nombres.indexOf(nombre) >= 0;
                if (activo) {
                    vigentes.push(nombre);
                }
                boton.setAttribute("aria-pressed", activo ? "true" : "false");
                boton.classList.toggle("is-selected", activo);
            });
            tarjetas.forEach(function (tarjeta) {
                tarjeta.hidden = vigentes.length > 0 && vigentes.indexOf(tarjeta.getAttribute("data-loteria")) < 0;
            });
            recalcularTotales();
            if (vigentes.length) {
                sessionStorage.setItem(clave, JSON.stringify(vigentes));
            } else {
                sessionStorage.removeItem(clave);
            }
        }
        botones.forEach(function (boton) {
            boton.addEventListener("click", function () {
                var nombres = leer();
                var nombre = boton.getAttribute("data-loteria");
                var indice = nombres.indexOf(nombre);
                if (indice >= 0) {
                    nombres.splice(indice, 1);
                } else {
                    nombres.push(nombre);
                }
                aplicar(nombres);
            });
        });
        aplicar(leer());
        }
    document.querySelectorAll(".revisada-orden-grupos").forEach(function (boton) {
        var seccion = boton.closest(".revisada-loteria");
        var lista = seccion.querySelector(".revisada-grupos");
        var marca = boton.querySelector("span");
        var clave = "nr.revisada.grupos." + location.pathname + "." + (seccion.getAttribute("data-loteria") || "");
        function ordenar(direccion) {
            var grupos = Array.prototype.slice.call(lista.querySelectorAll(".revisada-grupo"));
            grupos.sort(function (a, b) {
                var va = parseFloat(a.getAttribute("data-subtotal")) || 0;
                var vb = parseFloat(b.getAttribute("data-subtotal")) || 0;
                if (va === vb) {
                    return 0;
                }
                return direccion === "desc" ? vb - va : va - vb;
            });
            grupos.forEach(function (grupo) {
                lista.appendChild(grupo);
            });
            boton.setAttribute("data-orden", direccion);
            boton.setAttribute("aria-label", direccion === "desc" ? boton.getAttribute("data-desc") : boton.getAttribute("data-asc"));
            if (marca) {
                marca.textContent = direccion === "desc" ? "↓" : "↑";
            }
            sessionStorage.setItem(clave, direccion);
        }
        boton.addEventListener("click", function () {
            ordenar(boton.getAttribute("data-orden") === "asc" ? "desc" : "asc");
        });
        var guardado = sessionStorage.getItem(clave);
        if (guardado === "asc" || guardado === "desc") {
            ordenar(guardado);
        }
    });
    };
    window.iniciarRevisada();
    (function () {
        var seccion = document.querySelector("[data-historico]");
        var cuerpo = seccion && seccion.querySelector("[data-historico-filas]");
        var scroll = seccion && seccion.querySelector("[data-historico-scroll]");
        var centinela = seccion && seccion.querySelector("[data-historico-centinela]");
        if (!cuerpo || !scroll || !centinela) {
            return;
        }
        var cargando = false;
        var hayMas = false;
        var siguiente = 2;
        function leerFin() {
            var fin = cuerpo.querySelector("[data-historico-fin]");
            if (fin) {
                hayMas = fin.getAttribute("data-hay-mas") === "true";
                siguiente = parseInt(fin.getAttribute("data-siguiente"), 10) || siguiente;
                fin.remove();
            }
            centinela.hidden = !hayMas;
        }
        function direccion(pagina) {
            var datos = new URLSearchParams({
                desde: seccion.dataset.desde,
                hasta: seccion.dataset.hasta,
                orden: seccion.dataset.orden,
                descendente: seccion.dataset.descendente,
                pagina: String(pagina)
            });
            return seccion.dataset.url + "?" + datos.toString();
        }
        function cargar(pagina, reemplazar) {
            if (cargando) {
                return;
            }
            cargando = true;
            fetch(direccion(pagina), { credentials: "same-origin", headers: { "X-Requested-With": "fetch" } })
                .then(function (respuesta) { return respuesta.ok ? respuesta.text() : Promise.reject(); })
                .then(function (html) {
                    var temporal = document.createElement("tbody");
                    temporal.innerHTML = html;
                    if (!temporal.querySelector("[data-historico-fin]")) {
                        location.reload();
                        return;
                    }
                    if (reemplazar) {
                        cuerpo.replaceChildren();
                    }
                    while (temporal.firstChild) {
                        cuerpo.appendChild(temporal.firstChild);
                    }
                    leerFin();
                })
                .catch(function () { })
                .finally(function () { cargando = false; });
        }
        leerFin();
        new IntersectionObserver(function (entradas) {
            if (hayMas && !cargando && entradas.some(function (e) { return e.isIntersecting; })) {
                cargar(siguiente, false);
            }
        }, { root: scroll, rootMargin: "150px" }).observe(centinela);
        seccion.querySelectorAll("[data-historico-orden]").forEach(function (boton) {
            boton.addEventListener("click", function () {
                var clave = boton.getAttribute("data-historico-orden");
                var descendente = seccion.dataset.orden === clave ? seccion.dataset.descendente !== "true" : false;
                seccion.dataset.orden = clave;
                seccion.dataset.descendente = descendente ? "true" : "false";
                seccion.querySelectorAll("[data-historico-orden]").forEach(function (otro) {
                    var activo = otro === boton;
                    var marca = otro.querySelector("span");
                    otro.closest("th").setAttribute("aria-sort", activo ? (descendente ? "descending" : "ascending") : "none");
                    if (marca) {
                        marca.textContent = activo ? (descendente ? "↓" : "↑") : "↕";
                    }
                    var plantilla = activo && !descendente ? seccion.dataset.desc : seccion.dataset.asc;
                    otro.setAttribute("aria-label", plantilla.replace("{0}", otro.getAttribute("data-titulo") || ""));
                });
                scroll.scrollTop = 0;
                cargar(1, true);
            });
        });
    })();
    (function () {
        var modal = document.querySelector("[data-recubrir-modal]");
        if (!modal) {
            return;
        }
        var contenido = modal.querySelector("[data-recubrir-contenido]");
        var origen = null;
        function cerrar() {
            modal.hidden = true;
            modal.classList.add("hidden");
            contenido.replaceChildren();
            if (origen) {
                origen.focus();
            }
        }
        document.addEventListener("click", function (evento) {
            var boton = evento.target.closest("[data-recubrir-url]");
            if (!boton || boton.disabled) {
                return;
            }
            origen = boton;
            boton.disabled = true;
            var url = boton.getAttribute("data-recubrir-url") + location.search;
            fetch(url, { credentials: "same-origin", headers: { "X-Requested-With": "fetch" } })
                .then(function (respuesta) { return respuesta.text(); })
                .then(function (html) {
                    contenido.innerHTML = html;
                    if (!contenido.querySelector("#revisadaRecubrirTitulo")) {
                        location.reload();
                        return;
                    }
                    modal.hidden = false;
                    modal.classList.remove("hidden");
                    var primero = contenido.querySelector("button[type='submit'], [data-recubrir-cerrar]");
                    if (primero) {
                        primero.focus();
                    }
                })
                .catch(function () { location.reload(); })
                .finally(function () { boton.disabled = false; });
        });
        modal.addEventListener("click", function (evento) {
            if (evento.target === modal || evento.target.closest("[data-recubrir-cerrar]")) {
                cerrar();
            }
        });
        modal.addEventListener("keydown", function (evento) {
            if (evento.key === "Escape") {
                evento.preventDefault();
                cerrar();
            }
        });
        modal.addEventListener("submit", function (evento) {
            var enviar = evento.target.querySelector("button[type='submit']");
            if (enviar) {
                enviar.disabled = true;
            }
        });
    })();
    (function () {
        var modal = document.querySelector("[data-revisada-modal]");
        if (!modal) {
            return;
        }
        var lista = modal.querySelector("[data-revisada-modal-lista]");
        var sub = modal.querySelector("[data-revisada-modal-sub]");
        var cerrarBoton = modal.querySelector("[data-revisada-modal-cerrar]");
        var origen = null;
        function cerrar() {
            modal.hidden = true;
            modal.classList.add("hidden");
            lista.replaceChildren();
            if (origen) {
                origen.focus();
            }
        }
        document.addEventListener("click", function (evento) {
            var boton = evento.target.closest("[data-revisada-ver]");
            if (!boton) {
                return;
            }
            var plantilla = document.getElementById(boton.getAttribute("data-revisada-ver"));
            if (!plantilla) {
                return;
            }
            origen = boton;
            lista.replaceChildren(plantilla.content.cloneNode(true));
            sub.textContent = boton.getAttribute("data-titulo") || "";
            modal.hidden = false;
            modal.classList.remove("hidden");
            cerrarBoton.focus();
        });
        cerrarBoton.addEventListener("click", cerrar);
        modal.addEventListener("click", function (evento) {
            if (evento.target === modal) {
                cerrar();
            }
        });
        modal.addEventListener("keydown", function (evento) {
            if (evento.key === "Escape") {
                evento.preventDefault();
                cerrar();
            } else if (evento.key === "Tab") {
                evento.preventDefault();
                cerrarBoton.focus();
            }
        });
    })();
    document.querySelectorAll("[data-dos-digitos]").forEach(function (campo) {
        function limitar() {
            var digitos = String(campo.value || "").replace(/\D/g, "").slice(0, 2);
            if (campo.value !== digitos) {
                campo.value = digitos;
            }
        }
        campo.addEventListener("input", limitar);
        campo.addEventListener("keydown", function (evento) {
            if (evento.key === "e" || evento.key === "E" || evento.key === "+" || evento.key === "-" || evento.key === "." || evento.key === ",") {
                evento.preventDefault();
            }
        });
        limitar();
    });
</script>
@if (Model.Modo == "resumen")
{
    <script>
        (function () {
            var ocupado = false;
            async function refrescar() {
                if (ocupado || document.hidden) {
                    return;
                }
                var actual = document.getElementById("revisada-datos");
                var panel = document.querySelector("main");
                if (!actual) {
                    return;
                }
                ocupado = true;
                var scrollPanel = panel ? panel.scrollTop : window.scrollY;
                var scrolls = {};
                actual.querySelectorAll(".revisada-loteria").forEach(function (tarjeta) {
                    scrolls[tarjeta.getAttribute("data-loteria") || ""] = tarjeta.scrollTop;
                });
                try {
                    var respuesta = await fetch(location.href, { credentials: "same-origin", headers: { "X-Requested-With": "fetch" } });
                    if (!respuesta.ok) {
                        return;
                    }
                    var documento = new DOMParser().parseFromString(await respuesta.text(), "text/html");
                    var nuevo = documento.getElementById("revisada-datos");
                    if (!nuevo || nuevo.innerHTML === actual.innerHTML) {
                        return;
                    }
                    actual.replaceWith(nuevo);
                    if (panel) {
                        panel.scrollTop = scrollPanel;
                    } else {
                        window.scrollTo(0, scrollPanel);
                    }
                    document.querySelectorAll(".revisada-loteria").forEach(function (tarjeta) {
                        var nombre = tarjeta.getAttribute("data-loteria") || "";
                        if (Object.prototype.hasOwnProperty.call(scrolls, nombre)) {
                            tarjeta.scrollTop = scrolls[nombre];
                        }
                    });
                    if (window.iniciarRevisada) {
                        window.iniciarRevisada();
                    }
                } catch (error) {
                } finally {
                    ocupado = false;
                }
            }
            setInterval(refrescar, 60000);
        })();
    </script>
