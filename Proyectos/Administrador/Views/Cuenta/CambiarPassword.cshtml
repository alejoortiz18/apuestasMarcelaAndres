@using NewRich.Admin.Constants
@model NewRich.Admin.Models.CambiarPasswordViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = UiTexts.CambiarContrasena;
}
<section class="login">
    <div class="login-box">
        <div class="logo">@UiTexts.AppName.ToUpperInvariant()<small>@UiTexts.AppSubtitle.ToUpperInvariant()</small></div>
        <h1>@UiTexts.CambiarContrasena</h1>
        <p>@NewRich.Constants.Messages.AuthMessages.DebeCambiarPassword</p>
        <form asp-action="CambiarPassword" method="post">
            <div class="field">
                <label asp-for="PasswordActual"></label>
                <input asp-for="PasswordActual" />
                <span asp-validation-for="PasswordActual"></span>
            </div>
            <div class="field">
                <label asp-for="PasswordNuevo"></label>
                <input asp-for="PasswordNuevo" />
                <span asp-validation-for="PasswordNuevo"></span>
            </div>
            <div class="field">
                <label asp-for="PasswordConfirmacion"></label>
                <input asp-for="PasswordConfirmacion" />
                <span asp-validation-for="PasswordConfirmacion"></span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="notice error" role="alert">@Model.Error</div>
            }
            <button class="primary" type="submit">@UiTexts.GuardarCambios</button>
        </form>
        <form asp-action="Salir" method="post" style="margin-top:12px">
            <button class="secondary" type="submit" style="width:100%">@UiTexts.CerrarSesion</button>
        </form>
    </div>
</section>
