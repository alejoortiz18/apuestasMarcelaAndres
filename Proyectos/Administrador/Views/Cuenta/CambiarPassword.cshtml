@using NewRich.Admin.Constants
@model NewRich.Admin.Models.CambiarPasswordViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = UiTexts.CambiarContrasena;
}
<section class="login">
    <div class="login-inner">
        <header class="login-brand">
            <div class="login-emblema">
                <img src="~/img/login-emblema.png" alt="" width="200" height="200" />
            </div>
            <p class="login-name">@UiTexts.AppName</p>
            <p class="login-lema">@UiTexts.AppLema</p>
        </header>
        <div class="login-box">
            <h1>@UiTexts.CambiarContrasena</h1>
            <p>@NewRich.Constants.Messages.AuthMessages.DebeCambiarPassword</p>
            <form asp-action="CambiarPassword" method="post">
                <div class="field">
                    <label asp-for="PasswordActual"></label>
                    <div class="login-input">
                        <svg class="login-input-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                            <rect x="5" y="11" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
                            <path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                        <input asp-for="PasswordActual" />
                    </div>
                    <span asp-validation-for="PasswordActual"></span>
                </div>
                <div class="field">
                    <label asp-for="PasswordNuevo"></label>
                    <div class="login-input">
                        <svg class="login-input-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                            <rect x="5" y="11" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
                            <path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                        <input asp-for="PasswordNuevo" />
                    </div>
                    <span asp-validation-for="PasswordNuevo"></span>
                </div>
                <div class="field">
                    <label asp-for="PasswordConfirmacion"></label>
                    <div class="login-input">
                        <svg class="login-input-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                            <rect x="5" y="11" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
                            <path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                        <input asp-for="PasswordConfirmacion" />
                    </div>
                    <span asp-validation-for="PasswordConfirmacion"></span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Error))
                {
                    <div class="notice error" role="alert">@Model.Error</div>
                }
                <button class="primary" type="submit">@UiTexts.GuardarCambios</button>
            </form>
            <form asp-action="Salir" method="post" class="login-salir">
                <button class="secondary" type="submit">@UiTexts.CerrarSesion</button>
            </form>
        </div>
    </div>
</section>
