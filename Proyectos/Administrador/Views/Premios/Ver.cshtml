@using NewRich.Admin.Constants
@using NewRich.Admin.Services
@model NewRich.Admin.Models.PremioVerViewModel
@{
    var caso = Model.Caso;
    var pasos = new[] { "Reportado", "Validado", "Asignado", "En proceso", "Registrado", "Premio entregado" };
    var actual = caso.Estado == "Premio entregado" ? "Premio entregado" : caso.Estado;
    var indice = Array.IndexOf(pasos, actual);
    if (indice < 0 && caso.Estado == "Rechazado")
    {
        indice = 0;
    }
    var puedeValidar = caso.Estado == "Reportado";
    var puedeAsignar = caso.Estado is "Validado" or "Asignado" or "En proceso";
}
<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.PremiosKicker</div>
        <h1>@UiTexts.DetalleCasoGanador</h1>
        <p>@UiTexts.Ticket <strong>@caso.Ticket</strong> · @caso.Vendedor · @caso.Pda</p>
    </div>
    <a class="secondary" asp-action="Index">@UiTexts.VolverAlListado</a>
</div>
<div class="panel">
    <div class="field">
        <label>@UiTexts.EstadoActual</label>
        <input value="@caso.Estado" readonly />
    </div>
    <div class="prize-steps" aria-label="@UiTexts.EstadoActual">
        @for (var i = 0; i < pasos.Length; i++)
        {
            var activo = caso.Estado != "Rechazado" && i <= indice;
            <div class="prize-step@(activo ? " is-done" : null)">
                <span>@(i + 1)</span>
                <strong>@pasos[i]</strong>
            </div>
        }
    </div>
    <div class="receipt">
        <div class="receipt-row"><span>@UiTexts.Ticket</span><strong>@caso.Ticket</strong></div>
        <div class="receipt-row"><span>@UiTexts.UsuarioVendedor</span><strong>@caso.Vendedor</strong></div>
        <div class="receipt-row"><span>@UiTexts.Pda</span><strong>@caso.Pda</strong></div>
        <div class="receipt-row"><span>@UiTexts.Observador</span><strong>@caso.Observador</strong></div>
        <div class="receipt-row"><span>@UiTexts.FechaReporte</span><strong>@caso.FechaReporte.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
        @if (caso.FechaValidacion.HasValue)
        {
            <div class="receipt-row"><span>@UiTexts.FechaValidacion</span><strong>@caso.FechaValidacion.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
        }
        @if (caso.FechaAsignacion.HasValue)
        {
            <div class="receipt-row"><span>@UiTexts.FechaAsignacion</span><strong>@caso.FechaAsignacion.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
        }
        @if (caso.FechaRegistro.HasValue)
        {
            <div class="receipt-row"><span>@UiTexts.FechaRegistro</span><strong>@caso.FechaRegistro.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
        }
        @if (caso.ValorTotalGanado.HasValue)
        {
            <div class="receipt-rule">----------------</div>
            <div class="receipt-row"><span>@UiTexts.NombreCompleto</span><strong>@caso.NombreGanador @caso.ApellidoGanador</strong></div>
            <div class="receipt-row"><span>@caso.NumeroContacto</span><strong>@caso.LugarGano</strong></div>
            <div class="receipt-row"><span>@UiTexts.Valor</span><strong>@caso.ValorTotalGanado.Value.ToString("N0")</strong></div>
        }
    </div>
    <div class="field" style="margin-top:18px">
        <label>@UiTexts.FotoDelTicket</label>
        @if (caso.TieneFoto)
        {
            <p class="field-help">@UiTexts.FotoTicketAyuda</p>
            <img class="premio-foto-ticket" src="@Url.Action("Foto", new { id = caso.CasoId })" alt="@UiTexts.FotoDelTicket" />
        }
        else
        {
            <p class="field-help">@UiTexts.SinFoto</p>
        }
    </div>
    @if (puedeValidar)
    {
        <div class="table-actions-buttons" style="margin-top:18px">
            <form method="post" asp-action="Validar" asp-route-id="@caso.CasoId" data-protected-action="@AccionesProtegidas.PremiosValidar">
                @Html.AntiForgeryToken()
                <button class="primary" type="submit">@UiTexts.ValidarCaso</button>
            </form>
            <form method="post" asp-action="Rechazar" asp-route-id="@caso.CasoId" data-protected-action="@AccionesProtegidas.PremiosRechazar">
                @Html.AntiForgeryToken()
                <button class="danger" type="submit">@UiTexts.RechazarCaso</button>
            </form>
        </div>
    }
    @if (puedeAsignar)
    {
        <form method="post" asp-action="Asignar" asp-route-id="@caso.CasoId" class="toolbar" style="margin-top:18px" data-protected-action="@AccionesProtegidas.PremiosAsignar">
            @Html.AntiForgeryToken()
            <div class="field">
                <label for="observadorId">@UiTexts.AsignarObservador</label>
                <select id="observadorId" name="observadorId" class="searchable" required>
                    <option value="">@UiTexts.Seleccionar</option>
                    @foreach (var observador in Model.Observadores)
                    {
                        <option value="@observador.UsuarioId">@observador.NombreCompleto</option>
                    }
                </select>
            </div>
            <button class="primary" type="submit">@UiTexts.AsignarObservador</button>
        </form>
    }
</div>
<div class="panel">
    <div class="panel-head">
        <div>
            <h2>@UiTexts.DatosDeLaApuesta</h2>
            <div class="panel-sub">@UiTexts.DatosDeLaApuestaSub</div>
        </div>
    </div>
    <div class="receipt">
        <div class="receipt-row"><span>@UiTexts.Ticket</span><strong>@caso.Ticket</strong></div>
        @if (!string.IsNullOrWhiteSpace(caso.CodigoRecibo))
        {
            <div class="receipt-row"><span>@UiTexts.ReciboDeVentaCaso</span><strong>@caso.CodigoRecibo</strong></div>
        }
        @if (caso.FechaJuego.HasValue)
        {
            <div class="receipt-row"><span>@UiTexts.FechaEnQueGano</span><strong>@caso.FechaJuego.Value.ToString("dd/MM/yyyy")</strong></div>
        }
        @if (caso.TotalApostado.HasValue)
        {
            <div class="receipt-row"><span>@UiTexts.TotalApostadoCaso</span><strong>@caso.TotalApostado.Value.ToString("N0")</strong></div>
        }
    </div>
    @if (!caso.Resultados.Any())
    {
        <div class="empty" style="margin-top:14px">@UiTexts.SinDatosApuesta</div>
    }
    else
    {
        <div class="table-wrap" style="margin-top:14px">
            <table>
                <thead>
                <tr>
                    <th>@UiTexts.Loteria</th>
                    <th>@UiTexts.NumeroApostado</th>
                    <th>@UiTexts.NumeroGanadorColumna</th>
                    <th>@UiTexts.ResultadoColumna</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var linea in caso.Resultados)
                {
                    <tr>
                        <td>@linea.Loteria</td>
                        <td><strong>@linea.Numero</strong></td>
                        <td>@(linea.NumeroGanador ?? UiTexts.ResultadoSinPublicar)</td>
                        <td>
                            @if (linea.NumeroGanador is null)
                            {
                                <span class="pill info">@UiTexts.ResultadoSinPublicar</span>
                            }
                            else if (linea.Gano)
                            {
                                <span class="pill ok">@UiTexts.ResultadoGano</span>
                            }
                            else
                            {
                                <span class="pill warn">@UiTexts.ResultadoNoGano</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
<div class="panel">
    <div class="panel-head">
        <div>
            <h2>@UiTexts.EntregaDelPremio</h2>
            <div class="panel-sub">@UiTexts.EntregaDelPremioSub</div>
        </div>
    </div>
    @if (!caso.FechaEntrega.HasValue && !caso.ValorTotalGanado.HasValue)
    {
        <div class="empty">@UiTexts.SinEntregaRegistrada</div>
    }
    else
    {
        <div class="receipt">
            <div class="receipt-row"><span>@UiTexts.NombreGanador</span><strong>@caso.NombreGanador</strong></div>
            <div class="receipt-row"><span>@UiTexts.ApellidoGanador</span><strong>@caso.ApellidoGanador</strong></div>
            <div class="receipt-row"><span>@UiTexts.NumeroContacto</span><strong>@caso.NumeroContacto</strong></div>
            <div class="receipt-row"><span>@UiTexts.LugarGano</span><strong>@caso.LugarGano</strong></div>
            <div class="receipt-row"><span>@UiTexts.NombreVendedorEntrega</span><strong>@(caso.NombreVendedorEntrega ?? caso.Vendedor)</strong></div>
            @if (caso.ValorTotalGanado.HasValue)
            {
                <div class="receipt-row"><span>@UiTexts.ValorTotalGanado</span><strong>@caso.ValorTotalGanado.Value.ToString("N0")</strong></div>
            }
            <div class="receipt-row"><span>@UiTexts.PersonaQueEntrega</span><strong>@(caso.PersonaQueEntrega ?? caso.Observador)</strong></div>
            @if (caso.FechaEntrega.HasValue)
            {
                <div class="receipt-row"><span>@UiTexts.FechaEntrega</span><strong>@caso.FechaEntrega.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
            }
        </div>
        <div class="field" style="margin-top:18px">
            <label>@UiTexts.EvidenciasEntrega</label>
            @if (!caso.Evidencias.Any())
            {
                <p class="field-help">@UiTexts.SinEvidencias</p>
            }
            else
            {
                <div class="premio-evidencias">
                    @foreach (var evidencia in caso.Evidencias)
                    {
                        var url = Url.Action("Evidencia", new { id = caso.CasoId, evidenciaId = evidencia.EvidenciaId });
                        <figure class="premio-evidencia">
                            <a href="@url" target="_blank" rel="noopener">
                                <img src="@url" alt="@evidencia.Tipo" loading="lazy" />
                            </a>
                            <span>@evidencia.Tipo · @evidencia.FechaCaptura.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </figure>
                    }
                </div>
            }
        </div>
    }
</div>
