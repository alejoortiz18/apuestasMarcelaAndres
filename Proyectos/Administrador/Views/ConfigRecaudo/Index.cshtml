@using NewRich.Admin.Constants
@using NewRich.Admin.Models
@model ConfigRecaudoViewModel
<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.RecaudoKicker</div>
        <h1>@UiTexts.ConfigRecaudoTitulo</h1>
        <p>@UiTexts.ConfigRecaudoSub</p>
    </div>
</div>
<div class="panel">
    <form class="toolbar" method="get">
        <div class="field">
            <label for="desde">@UiTexts.Desde</label>
            <input id="desde" name="desde" type="date" value="@Model.Desde.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="hasta">@UiTexts.Hasta</label>
            <input id="hasta" name="hasta" type="date" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
        </div>
        <button class="primary" type="submit">@UiTexts.Aplicar</button>
    </form>
</div>
@if (Model.Alarmas.Count > 0)
{
    <div class="recaudo-alarma" role="status">
        <strong>@UiTexts.AlarmaGruposSinConfigurar</strong>
        <p>@string.Join(", ", Model.Alarmas)</p>
    </div>
}
<div class="panel">
    <div class="panel-head"><h2>@UiTexts.AsignarGrupoRecaudo</h2></div>
    <form class="toolbar" method="post" asp-action="AsignarGrupo">
        @Html.AntiForgeryToken()
        <input type="hidden" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
        <div class="field">
            <label for="recaudadorGrupo">@UiTexts.Recaudador</label>
            <select id="recaudadorGrupo" name="recaudadorId" required>
                <option value="">@UiTexts.EligeRecaudador</option>
                @foreach (var item in Model.Recaudadores)
                {
                    <option value="@item.Id">@item.Nombre</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="grupoId">@UiTexts.Grupo</label>
            <select id="grupoId" name="grupoId" required>
                <option value="">@UiTexts.EligeGrupo</option>
                @foreach (var item in Model.GruposSinRecaudador)
                {
                    <option value="@item.Id">@item.Nombre</option>
                }
            </select>
        </div>
        <button class="primary" type="submit">@UiTexts.GuardarAsignacion</button>
    </form>
    <p class="panel-sub">@UiTexts.AyudaPorcentaje</p>
</div>
<div class="panel">
    <div class="panel-head">
        <div>
            <h2>@UiTexts.CatalogoGruposRecaudo</h2>
            <div class="panel-sub">@Model.Grupos.TotalCount registros</div>
        </div>
    </div>
    @if (!Model.Grupos.Items.Any())
    {
        <div class="empty">@UiTexts.Vacio</div>
    }
    else
    {
        <div class="table-wrap">
            <table data-table-select="grupos-recaudo">
                <thead>
                <tr>
                    <th class="col-check"><span class="visually-hidden">@UiTexts.SeleccionarFila</span></th>
                    <th>@UiTexts.Grupo</th>
                    <th>@UiTexts.CantidadVendedores</th>
                    <th>@UiTexts.TotalPorRecaudar</th>
                    <th>@UiTexts.TotalRecaudado</th>
                    <th title="@UiTexts.AyudaColumnaRecibir">@UiTexts.Recibir</th>
                    <th title="@UiTexts.AyudaColumnaEntregado">@UiTexts.Entregado</th>
                    <th title="@UiTexts.AyudaColumnaPago">@UiTexts.Pago</th>
                    <th title="@UiTexts.AyudaColumnaDebe">@UiTexts.Debe</th>
                    <th>@UiTexts.Recaudador</th>
                    <th>@UiTexts.Acciones</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var fila in Model.Grupos.Items)
                {
                    var clasesFila = new List<string> { "recaudo-fila-panel" };
                    if (fila.SinConfigurar) { clasesFila.Add("recaudo-fila-gris"); }
                    if (fila.EnDeuda) { clasesFila.Add("recaudo-fila-deuda"); }
                    <tr class="@string.Join(" ", clasesFila)" tabindex="0" data-row-id="@fila.GrupoId">
                        <td class="col-check">
                            <input class="row-check" type="checkbox" value="@fila.GrupoId" aria-label="@UiTexts.SeleccionarFila @fila.Nombre" />
                        </td>
                        <td class="recaudo-cifra">@fila.Nombre @(fila.SinConfigurar ? $"({UiTexts.SinConfigurar})" : "")</td>
                        <td class="recaudo-cifra">@fila.Vendedores</td>
                        <td class="recaudo-cifra">@FormatoPesos.De(fila.TotalPorRecaudar)</td>
                        <td class="recaudo-cifra">@FormatoPesos.De(fila.TotalRecaudado)</td>
                        <td class="recaudo-cifra">@FormatoPesos.De(fila.Recibir)</td>
                        <td class="recaudo-cifra">@FormatoPesos.De(fila.Entregado)</td>
                        <td class="recaudo-col-pago">
                            <form id="form-pago-@fila.GrupoId" method="post" asp-action="RegistrarPagoAdministracion" class="recaudo-form-pago" data-protected-action="@AccionesProtegidas.RecaudoRegistrarPagoAdmin" data-protected-usos="1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="grupoId" value="@fila.GrupoId" />
                                <input type="hidden" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
                                <input type="hidden" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
                                <div class="money-input">
                                    <span class="money-prefix" aria-hidden="true">@UiTexts.SimboloPesos</span>
                                    <input type="text"
                                           class="money-visible"
                                           inputmode="numeric"
                                           autocomplete="off"
                                           data-miles
                                           aria-label="@UiTexts.ValorARegistrar @fila.Nombre" />
                                    <input type="hidden" name="valor" value="0" />
                                </div>
                            </form>
                        </td>
                        <td class="recaudo-cifra">@FormatoPesos.De(fila.Debe)</td>
                        <td class="recaudo-col-recaudador">
                            <div class="recaudo-recaudador-label">
                                <span class="recaudo-cifra">@fila.RecaudadorNombre</span>
                                <button type="button"
                                        class="secondary boton-icono boton-lapiz"
                                        data-cambiar-recaudador
                                        data-grupo-id="@fila.GrupoId"
                                        data-grupo-nombre="@fila.Nombre"
                                        data-recaudador-id="@(fila.RecaudadorId?.ToString() ?? "")"
                                        aria-label="@UiTexts.CambiarRecaudador @fila.Nombre">
                                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M4 17.25V20h2.75L17.8 8.95l-2.75-2.75L4 17.25zm16.7-11.2a.73.73 0 0 0 0-1.04l-1.71-1.71a.73.73 0 0 0-1.04 0l-1.34 1.34 2.75 2.75 1.34-1.34z" fill="currentColor"/></svg>
                                </button>
                            </div>
                        </td>
                        <td class="recaudo-col-acciones">
                            <a class="secondary table-ver" asp-action="Ver" asp-route-id="@fila.GrupoId" asp-route-desde="@Model.Desde.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta.ToString("yyyy-MM-dd")">@UiTexts.Ver</a>
                            <button class="primary" type="submit" form="form-pago-@fila.GrupoId">@UiTexts.RegistrarPago</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.Grupos" />
    }
</div>
<div id="dialogCambiarRecaudador" class="dialog-back hidden" role="dialog" aria-modal="true" aria-labelledby="dialogCambiarRecaudadorTitulo" hidden>
    <div class="dialog">
        <h2 id="dialogCambiarRecaudadorTitulo">@UiTexts.CambiarRecaudador</h2>
        <p class="panel-sub" data-cambiar-recaudador-grupo></p>
        <form method="post" asp-action="CambiarRecaudadorGrupo" data-protected-action="@AccionesProtegidas.GruposAsignar" data-protected-usos="1">
            @Html.AntiForgeryToken()
            <input type="hidden" name="grupoId" data-cambiar-recaudador-grupo-id />
            <input type="hidden" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
            <div class="field">
                <label for="cambiarRecaudadorId">@UiTexts.Recaudador</label>
                <select id="cambiarRecaudadorId" name="recaudadorId" class="searchable" data-cambiar-recaudador-select>
                    <option value="">@UiTexts.SinAsignar</option>
                    @foreach (var item in Model.Recaudadores)
                    {
                        <option value="@item.Id">@item.Nombre</option>
                    }
                </select>
            </div>
            <div class="dialog-actions">
                <button type="button" class="secondary" data-cambiar-recaudador-cancelar>@UiTexts.Cancelar</button>
                <button type="submit" class="primary">@UiTexts.Aceptar</button>
            </div>
        </form>
    </div>
</div>
<div class="panel">
    <div class="panel-head"><h2>@UiTexts.AsignarVendedorRecaudo</h2></div>
    <form class="toolbar" method="post" asp-action="AsignarVendedor">
        @Html.AntiForgeryToken()
        <input type="hidden" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
        <div class="field">
            <label for="recaudadorVendedor">@UiTexts.Recaudador</label>
            <select id="recaudadorVendedor" name="recaudadorId" required>
                <option value="">@UiTexts.EligeRecaudador</option>
                @foreach (var item in Model.Recaudadores)
                {
                    <option value="@item.Id">@item.Nombre</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="vendedorId">@UiTexts.Vendedor</label>
            <select id="vendedorId" name="vendedorId" required>
                <option value="">@UiTexts.EligeVendedor</option>
                @foreach (var item in Model.CatalogoVendedores)
                {
                    <option value="@item.Id">@item.Nombre</option>
                }
            </select>
        </div>
        <button class="primary" type="submit">@UiTexts.GuardarAsignacion</button>
    </form>
</div>
<div class="panel">
    <div class="panel-head">
        <div>
            <h2>@UiTexts.VendedoresSinGrupoTitulo</h2>
            <div class="panel-sub">@Model.Vendedores.TotalCount registros</div>
        </div>
    </div>
    @if (!Model.Vendedores.Items.Any())
    {
        <div class="empty">@UiTexts.Vacio</div>
    }
    else
    {
        <div data-asignar-grupos>
        <div class="table-wrap table-wrap-dropdown">
            <table data-table-select="vendedores-recaudo">
                <thead>
                <tr>
                    <th class="col-check"><span class="visually-hidden">@UiTexts.SeleccionarFila</span></th>
                    <th>@UiTexts.Vendedor</th>
                    <th>@UiTexts.Recaudador</th>
                    <th>@UiTexts.Estado</th>
                    <th>@UiTexts.AsignarUnGrupo</th>
                </tr>
                </thead>
                <tbody>
                @{ var j = 0; }
                @foreach (var fila in Model.Vendedores.Items)
                {
                    <tr tabindex="0" data-row-id="@fila.VendedorId">
                        <td class="col-check">
                            <input class="row-check" type="checkbox" value="@fila.VendedorId" aria-label="@UiTexts.SeleccionarFila @fila.Nombre" />
                        </td>
                        <td><strong>@fila.Nombre</strong></td>
                        <td>@fila.RecaudadorNombre</td>
                        <td>@UiTexts.SenalDebeGrupo</td>
                        <td class="recaudo-col-grupo">
                            <input type="hidden" form="form-grupos-vendedores" name="asignaciones[@j].VendedorId" value="@fila.VendedorId" />
                            <select class="searchable" form="form-grupos-vendedores" name="asignaciones[@j].GrupoId" data-grupo-vendedor aria-label="@UiTexts.AsignarUnGrupo @fila.Nombre">
                                <option value="">@UiTexts.EligeGrupo</option>
                                @foreach (var grupo in Model.CatalogoGrupos)
                                {
                                    <option value="@grupo.Id">@grupo.Nombre</option>
                                }
                            </select>
                            @{ j++; }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @{
            ViewData["PagerPageKey"] = "pageV";
            ViewData["PagerPageSizeKey"] = "pageSizeV";
        }
        <partial name="_Pager" model="Model.Vendedores" />
        <div class="table-actions">
            <h2>@UiTexts.AsignarUnGrupo</h2>
            <p class="panel-sub">@UiTexts.AyudaAsignarGrupos</p>
            <div class="table-actions-buttons">
                <form id="form-grupos-vendedores" method="post" asp-action="GuardarGruposVendedores" data-guardar-grupos data-protected-action="@AccionesProtegidas.GruposAsignar" data-protected-usos="1" hidden>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
                    <button class="primary boton-icono" type="submit">
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        @UiTexts.GuardarGrupos
                    </button>
                </form>
                <button class="secondary" type="button" data-cancelar-grupos hidden>@UiTexts.Cancelar</button>
            </div>
        </div>
        </div>
    }
</div>
