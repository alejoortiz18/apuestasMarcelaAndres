@using NewRich.Admin.Constants
@using NewRich.Admin.Services
@using NewRich.Domain.Enums
@using System.Globalization
@model NewRich.Admin.Models.LoteriasIndexViewModel
@{
    var cultura = CultureInfo.GetCultureInfo("es-CO");
}
<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.LoteriasKicker</div>
        <h1>@UiTexts.LoteriasTitulo</h1>
        <p>@UiTexts.LoteriasSub</p>
        <partial name="_VentasTabs" />
    </div>
    <a class="primary" asp-action="Crear">+ @UiTexts.NuevoRegistro</a>
</div>
<div class="panel">
    <form class="toolbar pda-toolbar" method="get">
        <div class="field">
            <label for="q">@UiTexts.BuscarLoteria</label>
            <input id="q" name="q" value="@Model.Busqueda" placeholder="@UiTexts.PlaceholderLoteria" />
        </div>
        <div class="field">
            <label for="estado">@UiTexts.Estado</label>
            <select id="estado" name="estado" class="searchable">
                <option value="">@UiTexts.Todos</option>
                <option value="@((int)EstadoGeneral.Activo)" @(Model.Estado == (int)EstadoGeneral.Activo ? "selected" : null)>Activo</option>
                <option value="@((int)EstadoGeneral.Inactivo)" @(Model.Estado == (int)EstadoGeneral.Inactivo ? "selected" : null)>Inactivo</option>
            </select>
        </div>
        <div class="field">
            <label for="pageSize">@UiTexts.FilasPorPagina</label>
            <select id="pageSize" name="pageSize" class="searchable">
                @foreach (var size in PagingHelper.PageSizes)
                {
                    <option value="@size" @(Model.Pagina.PageSize == size ? "selected" : null)>@size</option>
                }
            </select>
        </div>
        <button class="primary" type="submit">@UiTexts.Buscar</button>
        <a class="secondary pda-clear" asp-action="Index">@UiTexts.LimpiarFiltros</a>
    </form>
</div>
<div class="panel">
    <div class="panel-head">
        <div>
            <h2>@UiTexts.ResumenPorLoteria</h2>
            <div class="panel-sub">@UiTexts.ResumenPorLoteriaSub</div>
        </div>
    </div>
    @if (!Model.Pagina.Items.Any())
    {
        <div class="empty">@UiTexts.Vacio</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>@UiTexts.Loteria</th>
                    <th>@UiTexts.NumeroJugado</th>
                    <th>@UiTexts.HoraCierre</th>
                    <th>@UiTexts.BoletosVendidos</th>
                    <th>@UiTexts.TotalVendido</th>
                    <th>@UiTexts.TipoDeApuesta</th>
                    <th>@UiTexts.Estado</th>
                    <th>@UiTexts.Accion</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Pagina.Items)
                {
                    var pill = item.Estado == EstadoGeneral.Activo ? "ok" : "info";
                    <tr tabindex="0">
                        <td><strong>@item.Nombre</strong></td>
                        <td>@(string.IsNullOrWhiteSpace(item.NumeroJugado) ? UiTexts.NoAplica : item.NumeroJugado)</td>
                        <td>@(string.IsNullOrWhiteSpace(item.HoraCierre) ? UiTexts.NoAplica : item.HoraCierre)</td>
                        <td>@item.BoletosVendidos</td>
                        <td>@item.TotalVendido.ToString("C0", cultura)</td>
                        <td>@(string.IsNullOrWhiteSpace(item.TipoApuesta) ? UiTexts.NoAplica : item.TipoApuesta)</td>
                        <td><span class="pill @pill">@item.Estado</span></td>
                        <td>
                            @if (item.BoletosVendidos == 0)
                            {
                                <button type="button" class="secondary table-ver" data-aviso="@UiTexts.SinBoletosEnLoteria">@UiTexts.Ver</button>
                            }
                            else
                            {
                                <a class="secondary table-ver" asp-action="Ver" asp-route-id="@item.LoteriaId">@UiTexts.Ver</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.Pagina" />
    }
</div>
<div class="panel">
    <div class="panel-head">
        <div>
            <h2>@UiTexts.BuscarBoletosVendidos</h2>
            <div class="panel-sub">@UiTexts.BuscarBoletosVendidosSub</div>
        </div>
    </div>
    <form class="toolbar" method="get" asp-action="Boletos">
        <div class="field">
            <label for="codigoBoleto">@UiTexts.CodigoBoleto</label>
            <input id="codigoBoleto" name="codigoBoleto" placeholder="@UiTexts.PlaceholderCodigoBoleto" />
        </div>
        <div class="field">
            <label for="numero">@UiTexts.NumeroJugado</label>
            <input id="numero" name="numero" placeholder="@UiTexts.PlaceholderNumeroJugado" inputmode="numeric" />
        </div>
        <div class="field">
            <label for="vendedor">@UiTexts.Vendedor</label>
            <input id="vendedor" name="vendedor" placeholder="@UiTexts.PlaceholderVendedorBoleto" />
        </div>
        <div class="field">
            <label for="fecha">@UiTexts.Fecha</label>
            <input id="fecha" name="fecha" type="date" />
        </div>
        <div class="field">
            <label for="estadoBoleto">@UiTexts.Estado</label>
            <select id="estadoBoleto" name="estado" class="searchable">
                <option value="">@UiTexts.Todos</option>
                <option value="Jugado">Jugado</option>
                <option value="Ganador">Ganador</option>
                <option value="Pagado/cobrado">Pagado</option>
                <option value="Vencido">Vencido</option>
                <option value="No ganador">No ganador</option>
            </select>
        </div>
        <button class="primary" type="submit">@UiTexts.BuscarBoletos</button>
        <a class="secondary" asp-action="Index">@UiTexts.Limpiar</a>
    </form>
</div>
