@using NewRich.Admin.Constants
@model NewRich.Admin.Models.ResultadosIndexViewModel
<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.ResultadosKicker</div>
        <h1>@UiTexts.ResultadosTitulo</h1>
        <p>@UiTexts.ResultadosSub</p>
    </div>
    <a class="primary" asp-action="Crear">@UiTexts.RegistrarResultado</a>
</div>
<div class="panel">
    <form class="toolbar" method="get" data-submit-on-change>
        <div class="field">
            <label for="loteriaId">@UiTexts.Loteria</label>
            <select id="loteriaId" name="loteriaId" class="searchable">
                <option value="">@UiTexts.Todos</option>
                @foreach (var l in Model.Loterias)
                {
                    <option value="@l.LoteriaId" @(Model.LoteriaId == l.LoteriaId ? "selected" : null)>@l.Nombre</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="fecha">@UiTexts.FechaJuego</label>
            <input id="fecha" name="fecha" type="date" value="@ViewBag.Fecha" />
        </div>
        <div class="field">
            <label for="pageSize">@UiTexts.FilasPorPagina</label>
            <select id="pageSize" name="pageSize" class="searchable">
                @foreach (var size in PagingHelper.PageSizes)
                {
                    <option value="@size" @(Model.Pagina.PageSize == size ? "selected" : null)>@size</option>
                }
            </select>
        </div>
        <button class="primary" type="submit">@UiTexts.Buscar</button>
        <a class="secondary" asp-action="Index">@UiTexts.Limpiar</a>
    </form>
</div>
<div class="panel">
    @if (!Model.Pagina.Items.Any())
    {
        <div class="empty">@UiTexts.Vacio</div>
    }
    else
    {
        <div class="table-wrap">
            <table data-table-select="resultados">
                <thead>
                <tr>
                    <th class="col-check"><span class="visually-hidden">@UiTexts.SeleccionarFila</span></th>
                    <th>@UiTexts.Fecha</th>
                    <th>@UiTexts.Loteria</th>
                    <th>@UiTexts.NumeroGanador</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Pagina.Items)
                {
                    <tr tabindex="0" data-row-id="@r.NumeroGanadorId">
                        <td class="col-check">
                            <input class="row-check" type="checkbox" value="@r.NumeroGanadorId" aria-label="@UiTexts.SeleccionarFila @r.Loteria @r.FechaJuego.ToString("dd/MM/yyyy")" />
                        </td>
                        <td>@r.FechaJuego.ToString("dd/MM/yyyy")</td>
                        <td>@r.Loteria</td>
                        <td><strong>@r.Numero</strong></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.Pagina" />
    }
</div>
