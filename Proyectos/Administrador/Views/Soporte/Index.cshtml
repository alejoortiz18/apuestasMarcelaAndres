@using NewRich.Admin.Constants
@using NewRich.Admin.Services
@using NewRich.Application.Chat
@model NewRich.Admin.Models.SoporteIndexViewModel
@{
    var yoTexto = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    _ = Guid.TryParse(yoTexto, out var yo);
    var abierta = string.Equals(Model.Detalle?.Conversacion.Estado, "Abierta", StringComparison.Ordinal);
}
<div class="page-soporte">
<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.SoporteKicker</div>
        <h1>@UiTexts.SoporteTitulo</h1>
        <p>@UiTexts.SoporteSub</p>
    </div>
</div>
<div class="panel chat-start">
    <form asp-action="Iniciar" method="post" class="toolbar" enctype="multipart/form-data">
        <div class="field">
            <label for="destinoId">@UiTexts.Destinatario</label>
            <select id="destinoId" name="destinoId" class="searchable">
                @foreach (var u in Model.Destinatarios)
                {
                    <option value="@u.UsuarioId">@u.NombreCompleto (@u.Rol)</option>
                }
            </select>
        </div>
        <div class="field chat-start-message">
            <label for="textoInicio">@UiTexts.Mensaje</label>
            <input id="textoInicio" name="texto" placeholder="@UiTexts.EscribeMensaje" autocomplete="off" />
        </div>
        <div class="chat-attach" data-chat-adjunto>
            <input id="archivoInicio" class="sr-only" name="archivo" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf,image/jpeg,image/png,image/webp,application/pdf" data-chat-archivo />
            <label class="chat-attach-btn" for="archivoInicio" title="@UiTexts.AdjuntarArchivo">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                    <path d="M21.44 11.05 12.25 20.24a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="sr-only">@UiTexts.AdjuntarArchivo</span>
            </label>
            <p class="chat-attach-chip hidden" data-chat-archivo-nombre>
                <span data-chat-archivo-texto></span>
                <button type="button" class="chat-attach-clear" data-chat-archivo-quitar aria-label="@UiTexts.QuitarArchivo" title="@UiTexts.QuitarArchivo">
                    <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
                        <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                </button>
            </p>
        </div>
        <button class="primary" type="submit">@UiTexts.IniciarConversacion</button>
    </form>
</div>
<div class="chat-shell" data-chat-vivo data-yo="@yo" data-conversacion="@(Model.ConversacionId?.ToString() ?? "")" data-evento="mensajeChat" data-adjunto-plantilla="@Url.Action("Adjunto", new { id = Guid.Empty })">
    <aside class="chat-list">
        <div class="chat-list-head">
            <h2>@UiTexts.Conversaciones</h2>
            <form method="get" class="chat-search-form" data-submit-on-change>
                <label class="sr-only" for="q">@UiTexts.BuscarChat</label>
                <input id="q" name="q" class="chat-search" value="@Model.Busqueda" placeholder="@UiTexts.BuscarChat" />
                @if (Model.ConversacionId.HasValue)
                {
                    <input type="hidden" name="id" value="@Model.ConversacionId" />
                }
                <button class="secondary" type="submit">@UiTexts.Buscar</button>
                <a class="secondary" asp-action="Index">@UiTexts.LimpiarFiltros</a>
            </form>
        </div>
        @if (!Model.Conversaciones.Any())
        {
            <div class="chat-list-body" data-chat-lista role="list" aria-label="@UiTexts.ListaConversacionesAria">
                <div class="empty">@UiTexts.Vacio</div>
            </div>
        }
        else
        {
            <div class="chat-list-body" data-chat-lista role="list" aria-label="@UiTexts.ListaConversacionesAria">
            @foreach (var c in Model.Conversaciones)
            {
                var persona = ChatVista.Contraparte(c, yo);
                var activa = Model.ConversacionId == c.ConversacionId;
                var pendiente = string.Equals(c.Estado, "Abierta", StringComparison.Ordinal);
                <a class="chat-item @(activa ? "active" : null) @(pendiente ? null : "is-closed")"
                   data-chat-item="@c.ConversacionId"
                   role="listitem"
                   asp-action="Index"
                   asp-route-id="@c.ConversacionId"
                   asp-route-q="@Model.Busqueda">
                    <div class="chat-person">
                        <span class="chat-avatar @persona.Tono">@persona.Iniciales</span>
                        <span class="chat-person-copy">
                            <strong>@persona.Nombre</strong>
                            <em>@persona.Rol</em>
                        </span>
                        @if (pendiente)
                        {
                            <span class="chat-dot" title="@c.Estado"></span>
                        }
                        else
                        {
                            <span class="pill @EstadoUi.Pill(c.Estado)">@c.Estado</span>
                        }
                    </div>
                    <small>@(string.IsNullOrWhiteSpace(c.UltimoTexto) ? UiTexts.SinMensajes : c.UltimoTexto)</small>
                </a>
            }
            </div>
        }
    </aside>
    <section class="chat-window">
        @if (Model.Detalle is null)
        {
            <header class="chat-head">
                <div>
                    <h2>@UiTexts.SoporteTitulo</h2>
                    <p>@UiTexts.SeleccionaConversacion</p>
                </div>
            </header>
            <div class="chat-messages">
                <div class="empty">@UiTexts.SeleccionaConversacion</div>
            </div>
        }
        else
        {
            var conv = Model.Detalle.Conversacion;
            var persona = ChatVista.Contraparte(conv, yo);
            <header class="chat-head">
                <div class="chat-head-person">
                    <span class="chat-avatar @persona.Tono">@persona.Iniciales</span>
                    <div>
                        <h2>@persona.Nombre</h2>
                        <p>@persona.Rol · @UiTexts.ConversacionDeSoporte</p>
                    </div>
                </div>
                <div class="chat-head-actions">
                    <span class="pill @EstadoUi.Pill(conv.Estado)">@conv.Estado</span>
                    @if (abierta)
                    {
                        <form asp-action="Cerrar" asp-route-id="@conv.ConversacionId" method="post">
                            <button class="secondary" type="submit">@UiTexts.MarcarAtendida</button>
                        </form>
                    }
                </div>
            </header>
            <div class="chat-messages" data-chat-scroll role="log" aria-live="polite" aria-label="@UiTexts.MensajesConversacionAria">
                @if (!Model.Detalle.Mensajes.Any())
                {
                    <div class="empty">@UiTexts.SinMensajes</div>
                }
                else
                {
                    @foreach (var m in Model.Detalle.Mensajes)
                    {
                        var mine = m.UsuarioEmisorId == yo;
                        <div class="chat-message @(mine ? "me" : "other")" data-mensaje-id="@m.MensajeId">
                            @if (!string.IsNullOrWhiteSpace(m.Texto))
                            {
                                @m.Texto
                            }
                            @if (m.AdjuntoId is Guid adjuntoId)
                            {
                                var nombre = m.NombreArchivo ?? UiTexts.VerArchivo;
                                var href = Url.Action("Adjunto", new { id = adjuntoId });
                                if (ChatAdjunto.EsImagen(m.NombreArchivo))
                                {
                                    <a class="chat-file" href="@href" target="_blank" rel="noopener">
                                        <img src="@href" alt="@nombre" />
                                        <span>@nombre</span>
                                    </a>
                                }
                                else
                                {
                                    <a class="chat-file chat-file-pdf" href="@href">@nombre</a>
                                }
                            }
                            <time>@m.FechaEnvio.ToLocalTime().ToString("dd/MM HH:mm") · @(string.IsNullOrWhiteSpace(m.NombreEmisor) ? persona.Nombre : m.NombreEmisor)</time>
                        </div>
                    }
                }
            </div>
            @if (abierta)
            {
                <form class="chat-compose" asp-action="Enviar" asp-route-id="@conv.ConversacionId" method="post" enctype="multipart/form-data">
                    <div class="chat-attach" data-chat-adjunto>
                        <input id="archivoMensaje" class="sr-only" name="archivo" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf,image/jpeg,image/png,image/webp,application/pdf" data-chat-archivo />
                        <label class="chat-attach-btn" for="archivoMensaje" title="@UiTexts.AdjuntarArchivo">
                            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                                <path d="M21.44 11.05 12.25 20.24a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <span class="sr-only">@UiTexts.AdjuntarArchivo</span>
                        </label>
                        <p class="chat-attach-chip hidden" data-chat-archivo-nombre>
                            <span data-chat-archivo-texto></span>
                            <button type="button" class="chat-attach-clear" data-chat-archivo-quitar aria-label="@UiTexts.QuitarArchivo" title="@UiTexts.QuitarArchivo">
                                <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
                                    <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                </svg>
                            </button>
                        </p>
                    </div>
                    <label class="sr-only" for="textoMensaje">@UiTexts.EscribeMensaje</label>
                    <input id="textoMensaje" class="chat-compose-text" name="texto" placeholder="@UiTexts.EscribeMensaje" autocomplete="off" />
                    <button class="primary" type="submit">@UiTexts.Enviar</button>
                </form>
            }
            else
            {
                <div class="chat-compose chat-compose-closed">@UiTexts.ConversacionCerradaAviso</div>
            }
        }
    </section>
</div>
</div>

@section Scripts {
    <script src="~/js/soporte.js" asp-append-version="true"></script>
}
