@using NewRich.Admin.Constants
@using NewRich.Admin.Services
@model NewRich.Admin.Models.SoporteIndexViewModel
@{
    var yo = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var nombres = Model.Destinatarios.ToDictionary(u => u.UsuarioId, u => u.NombreCompleto);
}
<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.SoporteKicker</div>
        <h1>@UiTexts.SoporteTitulo</h1>
        <p>@UiTexts.SoporteSub</p>
    </div>
</div>
<div class="panel">
    <form asp-action="Iniciar" method="post" class="toolbar">
        <div class="field">
            <label for="destinoId">@UiTexts.Destinatario</label>
            <select id="destinoId" name="destinoId" class="searchable">
                @foreach (var u in Model.Destinatarios)
                {
                    <option value="@u.UsuarioId">@u.NombreCompleto (@u.Rol)</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="texto">@UiTexts.Mensaje</label>
            <input id="texto" name="texto" placeholder="@UiTexts.EscribeMensaje" />
        </div>
        <button class="primary" type="submit">@UiTexts.IniciarConversacion</button>
    </form>
</div>
<div class="chat-shell">
    <aside class="chat-list">
        <div class="chat-list-head">
            <h2>@UiTexts.Conversaciones</h2>
        </div>
        @if (!Model.Conversaciones.Any())
        {
            <div class="empty">@UiTexts.Vacio</div>
        }
        else
        {
            @foreach (var c in Model.Conversaciones)
            {
                var otro = c.UsuarioIniciadorId.ToString() == yo ? c.UsuarioDestinoId : c.UsuarioIniciadorId;
                var nombre = nombres.TryGetValue(otro, out var n) ? n : otro.ToString()[..8];
                <a class="chat-item @(Model.ConversacionId == c.ConversacionId ? "active" : null)" asp-action="Index" asp-route-id="@c.ConversacionId">
                    <strong>@nombre</strong>
                    <small>@c.Estado · @c.FechaInicio.ToLocalTime().ToString("dd/MM HH:mm")</small>
                </a>
            }
        }
    </aside>
    <section class="chat-window">
        @if (Model.Detalle is null)
        {
            <header class="chat-head"><div><h2>@UiTexts.SoporteTitulo</h2></div></header>
            <div class="chat-messages"><div class="empty">@UiTexts.Vacio</div></div>
        }
        else
        {
            var conv = Model.Detalle.Conversacion;
            <header class="chat-head">
                <div>
                    <h2>Conversacion</h2>
                    <p>@conv.Estado</p>
                </div>
                <form asp-action="Cerrar" asp-route-id="@conv.ConversacionId" method="post">
                    <button class="secondary" type="submit">@UiTexts.MarcarAtendida</button>
                </form>
            </header>
            <div class="chat-messages">
                @foreach (var m in Model.Detalle.Mensajes)
                {
                    var mine = m.UsuarioEmisorId.ToString() == yo;
                    <div class="chat-message @(mine ? "me" : "other")">
                        @m.Texto
                        <time>@m.FechaEnvio.ToLocalTime().ToString("HH:mm")</time>
                    </div>
                }
            </div>
            <form class="chat-compose" asp-action="Enviar" asp-route-id="@conv.ConversacionId" method="post">
                <input name="texto" placeholder="@UiTexts.EscribeMensaje" autocomplete="off" />
                <button class="primary" type="submit">@UiTexts.Enviar</button>
            </form>
        }
    </section>
</div>
