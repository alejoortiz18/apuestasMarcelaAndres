@using NewRich.Admin.Constants
@using NewRich.Admin.Models
@model MetricasRecaudoViewModel
@{
    var ayudaId = 0;
    string Pct(double valor) => GraficoLineaRecaudo.Numero(valor) + "%";
    void Tarjeta(string titulo, string ayuda, string valor, string? tono = null)
    {
        ayudaId++;
        var id = $"ayuda-tablero-{ayudaId}";
        <article class="recaudo-metrica recaudo-metrica-ayuda@(tono is null ? null : " " + tono)">
            <span>@titulo</span>
            <strong class="recaudo-cifra">@valor</strong>
            <span class="th-ayuda metrica-ayuda" tabindex="0" aria-label="@titulo" aria-describedby="@id">
                <span class="th-ayuda-icono" aria-hidden="true">?</span>
                <span class="th-ayuda-texto" role="tooltip" id="@id">@ayuda</span>
            </span>
        </article>
    }
    void Ayuda(string titulo, string ayuda)
    {
        ayudaId++;
        var id = $"ayuda-tablero-{ayudaId}";
        <span class="th-ayuda" tabindex="0" aria-describedby="@id">
            @titulo
            <span class="th-ayuda-icono" aria-hidden="true">?</span>
            <span class="th-ayuda-texto" role="tooltip" id="@id">@ayuda</span>
        </span>
    }
    async Task Barras(IReadOnlyList<BarraRecaudo> barras, bool sonRecaudadores)
    {
        <ol class="tablero-barras">
            @foreach (var barra in barras)
            {
                var resumen = string.Format(UiTexts.BarraFormato, barra.Nombre, FormatoPesos.De(barra.Recaudado), FormatoPesos.De(barra.Pendiente), barra.Porcentaje);
                <li>
                    @if (sonRecaudadores && barra.Id is Guid id)
                    {
                        <a class="tablero-barra con-tip" asp-controller="DetalleRecaudo" asp-action="Index" asp-route-id="@id"
                           asp-route-desde="@Model.Desde.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta.ToString("yyyy-MM-dd")" aria-label="@resumen">
                            @{ CuerpoBarra(barra, sonRecaudadores); }
                        </a>
                    }
                    else
                    {
                        <a class="tablero-barra con-tip" asp-action="Index" asp-route-desde="@Model.Desde.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta.ToString("yyyy-MM-dd")"
                           asp-route-recaudadorId="@Model.RecaudadorId" asp-route-grupo="@barra.Nombre" data-tablero-grupo="@barra.Nombre" aria-label="@resumen">
                            @{ CuerpoBarra(barra, sonRecaudadores); }
                        </a>
                    }
                </li>
            }
        </ol>
    }
    void CuerpoBarra(BarraRecaudo barra, bool sonRecaudadores)
    {
        <span class="tablero-barra-cabeza" aria-hidden="true">
            <span class="tablero-barra-nombre">@barra.Nombre</span>
            <span class="tablero-barra-valor">@FormatoPesos.De(barra.Pendiente) <em>@barra.Porcentaje %</em></span>
        </span>
        <span class="tablero-barra-pista" aria-hidden="true">
            <i class="cobrado" style="width:@Pct(barra.AnchoRecaudado)"></i><i class="pendiente" style="width:@Pct(barra.AnchoPendiente)"></i>
        </span>
        <span class="grafico-tip" aria-hidden="true">
            <strong class="grafico-tip-fecha">@barra.Nombre</strong>
            @if (!sonRecaudadores && !string.IsNullOrWhiteSpace(barra.Detalle))
            {
                <span class="tip-detalle">@string.Format(UiTexts.CobranFormato, barra.Detalle)</span>
            }
            <span class="tip-detalle">@string.Format(UiTexts.VendedoresFormato, barra.Vendedores)</span>
            <dl>
                <div><dt><i class="tip-marca generado"></i>@UiTexts.TipPorRecaudar</dt><dd>@FormatoPesos.De(barra.PorRecaudar)</dd></div>
                <div><dt><i class="tip-marca cobrado"></i>@UiTexts.TipRecaudado</dt><dd>@FormatoPesos.De(barra.Recaudado)</dd></div>
                <div class="tip-pendiente"><dt><i class="tip-marca debia"></i>@UiTexts.TipPendiente</dt><dd>@FormatoPesos.De(barra.Pendiente)</dd></div>
            </dl>
            <span class="tip-avance">
                <span>@string.Format(UiTexts.TipAvanceTotalFormato, barra.Porcentaje)</span>
                <span class="tip-avance-barra"><i style="width:@Pct(barra.Porcentaje)"></i></span>
            </span>
        </span>
    }
    void Segmento(string clase, string nombre, decimal valor, decimal total, string texto)
    {
        if (valor <= 0m)
        {
            return;
        }

        var parte = MetricasRecaudoViewModel.Parte(valor, total);
        <span class="tablero-segmento @clase con-tip" tabindex="0" role="img" style="width:@Pct(parte)"
              aria-label="@string.Format(UiTexts.SegmentoFormato, nombre, texto, GraficoLineaRecaudo.Numero(parte))">
            <span class="grafico-tip tip-compacto" aria-hidden="true">
                <strong class="grafico-tip-fecha">@nombre</strong>
                <dl>
                    <div><dt>@texto</dt><dd>@GraficoLineaRecaudo.Numero(parte) %</dd></div>
                </dl>
            </span>
        </span>
    }
    var pct = Math.Clamp(Model.PorcentajeRecaudo, 0, 100);
    var nombreGrafico = Model.Grupo
        ?? Model.OpcionesRecaudadores.FirstOrDefault(o => o.Id == Model.RecaudadorId)?.Nombre
        ?? UiTexts.AlcanceTodaLaOperacion;
    var mayorSaldo = Model.MayoresSaldos.Count == 0 ? 0m : Model.MayoresSaldos.Max(s => s.TotalPendiente);
}
<div class="tablero-meta" data-tablero-aviso="@Model.Aviso">
    <span>@string.Format(UiTexts.ActualizadoFormato, Model.Actualizado.ToString("HH:mm"))</span>
    @if (Model.PeriodoRecortado)
    {
        <span class="tablero-meta-alerta">@string.Format(UiTexts.PeriodoRecortadoFormato, Model.Hasta.ToString("dd/MM/yyyy"))</span>
    }
</div>
<div class="recaudo-metricas tablero-kpis">
    @{ Tarjeta(UiTexts.TotalVendido, UiTexts.AyudaMetricaTotalVendido, FormatoPesos.De(Model.TotalVendido)); }
    @{ Tarjeta(UiTexts.TotalPorRecaudar, UiTexts.AyudaMetricaPorRecaudar, FormatoPesos.De(Model.TotalPorRecaudar), "tono-dorado"); }
    @{ Tarjeta(UiTexts.TotalRecaudado, UiTexts.AyudaMetricaRecaudado, FormatoPesos.De(Model.TotalRecaudado), "tono-verde"); }
    @{ Tarjeta(UiTexts.TotalPendiente, UiTexts.AyudaMetricaPendiente, FormatoPesos.De(Model.TotalPendiente), "tono-rojo"); }
    @{ Tarjeta(UiTexts.PorcentajeDeRecaudo, UiTexts.AyudaMetricaPorcentaje, $"{Model.PorcentajeRecaudo} %"); }
    @{ Tarjeta(UiTexts.GruposConPendiente, UiTexts.AyudaMetricaGruposConPendiente, Model.GruposConPendiente.ToString()); }
</div>
<div class="tablero-fila tablero-fila-principal">
    <section class="panel tablero-panel" aria-labelledby="tablero-operacion">
        <div class="panel-head">
            <div>
                <h2 id="tablero-operacion">@UiTexts.OperacionPorDia</h2>
                <div class="panel-sub">@UiTexts.OperacionPorDiaSub</div>
            </div>
        </div>
        @if (Model.Grafico.SinMovimiento)
        {
            <div class="empty">@UiTexts.SinDatosTablero</div>
        }
        else
        {
            <partial name="_GraficoLineaRecaudo" model="new GraficoLineaRecaudoVista(Model.Grafico, nombreGrafico)" />
        }
    </section>
    <section class="panel tablero-panel" aria-labelledby="tablero-avance">
        <div class="panel-head">
            <div>
                <h2 id="tablero-avance">@UiTexts.AvanceDelRecaudo</h2>
                <div class="panel-sub">@UiTexts.AvanceDelRecaudoSub</div>
            </div>
        </div>
        <div class="tablero-avance">
            <div class="tablero-anillo con-tip" tabindex="0" role="img"
                 aria-label="@string.Format(UiTexts.AnilloFormato, pct, FormatoPesos.De(Model.TotalRecaudado), FormatoPesos.De(Model.TotalPendiente))">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                    <circle class="anillo-fondo" cx="60" cy="60" r="50" pathLength="100" />
                    @if (pct > 0)
                    {
                        <circle class="anillo-valor" cx="60" cy="60" r="50" pathLength="100" stroke-dasharray="@pct 100" transform="rotate(-90 60 60)" />
                    }
                </svg>
                <span class="anillo-centro" aria-hidden="true"><strong>@pct %</strong><span>@UiTexts.RecaudadoCorto</span></span>
                <span class="grafico-tip" aria-hidden="true">
                    <strong class="grafico-tip-fecha">@UiTexts.AvanceDelRecaudo</strong>
                    <dl>
                        <div><dt><i class="tip-marca generado"></i>@UiTexts.TipPorRecaudar</dt><dd>@FormatoPesos.De(Model.TotalPorRecaudar)</dd></div>
                        <div><dt><i class="tip-marca cobrado"></i>@UiTexts.TipRecaudado</dt><dd>@FormatoPesos.De(Model.TotalRecaudado)</dd></div>
                        <div class="tip-pendiente"><dt><i class="tip-marca debia"></i>@UiTexts.TipPendiente</dt><dd>@FormatoPesos.De(Model.TotalPendiente)</dd></div>
                    </dl>
                </span>
            </div>
            <dl class="tablero-avance-datos">
                <div><dt><i class="tip-marca cobrado" aria-hidden="true"></i>@UiTexts.TipRecaudado</dt><dd class="recaudo-cifra">@FormatoPesos.De(Model.TotalRecaudado)</dd></div>
                <div><dt><i class="tip-marca debia" aria-hidden="true"></i>@UiTexts.TipPendiente</dt><dd class="tablero-rojo">@FormatoPesos.De(Model.TotalPendiente)</dd></div>
            </dl>
        </div>
        <h3 class="tablero-subtitulo">@UiTexts.EstadoDeLosVendedores <span>@string.Format(UiTexts.VendedoresFormato, Model.Vendedores)</span></h3>
        @if (Model.Vendedores == 0)
        {
            <div class="tablero-vacio">@UiTexts.SinMovimientoCorto</div>
        }
        else
        {
            <div class="tablero-segmentos">
                @{ Segmento("al-dia", UiTexts.EstadoAlDia, Model.VendedoresAlDia, Model.Vendedores, string.Format(UiTexts.VendedoresFormato, Model.VendedoresAlDia)); }
                @{ Segmento("por-cobrar", UiTexts.EstadoPorCobrar, Model.VendedoresPorCobrar, Model.Vendedores, string.Format(UiTexts.VendedoresFormato, Model.VendedoresPorCobrar)); }
                @{ Segmento("en-deuda", UiTexts.EstadoDeudado, Model.VendedoresEnDeuda, Model.Vendedores, string.Format(UiTexts.VendedoresFormato, Model.VendedoresEnDeuda)); }
            </div>
            <ul class="tablero-leyenda">
                <li class="al-dia">@UiTexts.EstadoAlDia <strong>@Model.VendedoresAlDia</strong></li>
                <li class="por-cobrar">@UiTexts.EstadoPorCobrar <strong>@Model.VendedoresPorCobrar</strong></li>
                <li class="en-deuda">@UiTexts.EstadoDeudado <strong>@Model.VendedoresEnDeuda</strong></li>
            </ul>
        }
        <h3 class="tablero-subtitulo">@UiTexts.ComposicionDelSaldo <span>@FormatoPesos.De(Model.TotalPendiente)</span></h3>
        @if (Model.TotalPendiente <= 0m)
        {
            <div class="tablero-vacio">@UiTexts.SinSaldosPendientes</div>
        }
        else
        {
            <div class="tablero-segmentos">
                @{ Segmento("deuda-anterior", UiTexts.DeudaAnterior, Model.DeudaAnterior, Model.TotalPendiente, FormatoPesos.De(Model.DeudaAnterior)); }
                @{ Segmento("del-dia", UiTexts.PendienteDelDia, Model.PendienteDelDia, Model.TotalPendiente, FormatoPesos.De(Model.PendienteDelDia)); }
            </div>
            <ul class="tablero-leyenda">
                <li class="deuda-anterior">@{ Ayuda(UiTexts.DeudaAnterior, UiTexts.AyudaDeudaAnterior); } <strong>@FormatoPesos.De(Model.DeudaAnterior)</strong></li>
                <li class="del-dia">@{ Ayuda(UiTexts.PendienteDelDia, UiTexts.AyudaPendienteDelDia); } <strong>@FormatoPesos.De(Model.PendienteDelDia)</strong></li>
            </ul>
        }
    </section>
</div>
<div class="tablero-fila">
    <section class="panel tablero-panel" aria-labelledby="tablero-recaudadores">
        <div class="panel-head">
            <div>
                <h2 id="tablero-recaudadores">@UiTexts.RecaudoPorRecaudador</h2>
                <div class="panel-sub">@UiTexts.BarrasSub</div>
            </div>
        </div>
        @if (!Model.Recaudadores.Any())
        {
            <div class="empty">@UiTexts.SinRecaudadoresTablero</div>
        }
        else
        {
            await Barras(Model.Recaudadores, true);
        }
    </section>
    <section class="panel tablero-panel" aria-labelledby="tablero-grupos">
        <div class="panel-head">
            <div>
                <h2 id="tablero-grupos">@UiTexts.RecaudoPorGrupo</h2>
                <div class="panel-sub">@UiTexts.BarrasSub</div>
            </div>
        </div>
        @if (!Model.Grupos.Any())
        {
            <div class="empty">@UiTexts.SinGruposTablero</div>
        }
        else
        {
            await Barras(Model.Grupos, false);
        }
    </section>
</div>
<div class="tablero-fila">
    <section class="panel tablero-panel" aria-labelledby="tablero-saldos">
        <div class="panel-head">
            <div>
                <h2 id="tablero-saldos">@UiTexts.MayoresSaldos</h2>
                <div class="panel-sub">@string.Format(UiTexts.MayoresSaldosFormato, Model.Hasta.ToString("dd/MM/yyyy"))</div>
            </div>
        </div>
        @if (!Model.MayoresSaldos.Any())
        {
            <div class="empty">@UiTexts.SinSaldosPendientes</div>
        }
        else
        {
            <ol class="tablero-ranking">
                @foreach (var saldo in Model.MayoresSaldos)
                {
                    <li class="con-tip" tabindex="0"
                        aria-label="@($"{saldo.Nombre}, {saldo.Grupo}, {saldo.Recaudador}: {UiTexts.TotalPendiente} {FormatoPesos.De(saldo.TotalPendiente)}")">
                        <span class="tablero-ranking-cabeza" aria-hidden="true">
                            <span><strong>@saldo.Nombre</strong><small>@saldo.Grupo, @saldo.Recaudador</small></span>
                            <span class="tablero-rojo">@FormatoPesos.De(saldo.TotalPendiente)</span>
                        </span>
                        <span class="tablero-barra-pista" aria-hidden="true">
                            <i class="deuda-anterior" style="width:@Pct(MetricasRecaudoViewModel.Parte(saldo.DeudaAnterior, mayorSaldo))"></i><i class="del-dia" style="width:@Pct(MetricasRecaudoViewModel.Parte(saldo.PendienteDelDia, mayorSaldo))"></i>
                        </span>
                        <span class="grafico-tip" aria-hidden="true">
                            <strong class="grafico-tip-fecha">@saldo.Nombre</strong>
                            <span class="tip-detalle">@saldo.Grupo, @saldo.Recaudador</span>
                            <dl>
                                <div><dt><i class="tip-marca debia"></i>@UiTexts.DeudaAnterior</dt><dd>@FormatoPesos.De(saldo.DeudaAnterior)</dd></div>
                                <div><dt><i class="tip-marca generado"></i>@UiTexts.PendienteDelDia</dt><dd>@FormatoPesos.De(saldo.PendienteDelDia)</dd></div>
                                <div class="tip-pendiente"><dt>@UiTexts.TotalPendiente</dt><dd>@FormatoPesos.De(saldo.TotalPendiente)</dd></div>
                            </dl>
                        </span>
                    </li>
                }
            </ol>
        }
    </section>
    <section class="panel tablero-panel" aria-labelledby="tablero-lecturas">
        <div class="panel-head">
            <div>
                <h2 id="tablero-lecturas">@UiTexts.LecturasDelPeriodo</h2>
                <div class="panel-sub">@UiTexts.LecturasDelPeriodoSub</div>
            </div>
        </div>
        <dl class="tablero-lecturas">
            <div class="tono-verde">
                <dt>@UiTexts.MejorDiaDeCobro</dt>
                @if (Model.Lecturas.MejorDia is { } mejor)
                {
                    <dd><strong>@FormatoPesos.De(mejor.Cobrado)</strong><span>@GraficoLineaRecaudo.FechaLarga(mejor.Fecha)</span></dd>
                }
                else
                {
                    <dd><strong>@UiTexts.SinMovimientoCorto</strong></dd>
                }
            </div>
            <div class="tono-rojo">
                <dt>@UiTexts.DiaConMasPendiente</dt>
                @if (Model.Lecturas.DiaMasPendiente is { } peor)
                {
                    <dd><strong>@FormatoPesos.De(peor.Pendiente)</strong><span>@GraficoLineaRecaudo.FechaLarga(peor.Fecha)</span></dd>
                }
                else
                {
                    <dd><strong>@UiTexts.SinMovimientoCorto</strong></dd>
                }
            </div>
            <div class="tono-dorado">
                <dt>@UiTexts.PromedioCobradoPorDia</dt>
                <dd><strong>@FormatoPesos.De(Model.Lecturas.PromedioCobrado)</strong></dd>
            </div>
            <div class="tono-rojo">
                <dt>@UiTexts.DiasConDeudaSinCobro</dt>
                <dd><strong>@string.Format(UiTexts.DiasFormato, Model.Lecturas.DiasSinCobro, Model.Grafico.Puntos.Count)</strong></dd>
            </div>
        </dl>
    </section>
</div>
