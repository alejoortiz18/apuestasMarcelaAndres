@using NewRich.Admin.Constants
@using NewRich.Admin.Models
@model MetricasRecaudoViewModel
<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.RecaudoKicker</div>
        <h1>@UiTexts.MetricasRecaudoTitulo</h1>
        <p>@UiTexts.MetricasRecaudoSub</p>
    </div>
</div>
<div class="panel">
    <form class="toolbar" method="get">
        <div class="field">
            <label for="desde">@UiTexts.Desde</label>
            <input id="desde" name="desde" type="date" value="@Model.Desde.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="hasta">@UiTexts.Hasta</label>
            <input id="hasta" name="hasta" type="date" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
        </div>
        <button class="primary" type="submit">@UiTexts.Aplicar</button>
    </form>
</div>
<div class="recaudo-metricas">
    <article class="recaudo-metrica"><span>@UiTexts.TotalVendido</span><strong class="recaudo-cifra">@FormatoPesos.De(Model.TotalVendido)</strong></article>
    <article class="recaudo-metrica"><span>@UiTexts.TotalPorRecaudar</span><strong class="recaudo-cifra">@FormatoPesos.De(Model.TotalPorRecaudar)</strong></article>
    <article class="recaudo-metrica"><span>@UiTexts.TotalRecaudado</span><strong class="recaudo-cifra">@FormatoPesos.De(Model.TotalRecaudado)</strong></article>
    <article class="recaudo-metrica"><span>@UiTexts.TotalPendiente</span><strong class="recaudo-cifra">@FormatoPesos.De(Model.TotalPendiente)</strong></article>
    <article class="recaudo-metrica"><span>@UiTexts.PorcentajeDeRecaudo</span><strong class="recaudo-cifra">@Model.PorcentajeRecaudo %</strong></article>
    <article class="recaudo-metrica"><span>@UiTexts.VendedoresAlDia</span><strong class="recaudo-cifra">@Model.VendedoresAlDia</strong></article>
    <article class="recaudo-metrica"><span>@UiTexts.VendedoresEnDeuda</span><strong class="recaudo-cifra">@Model.VendedoresEnDeuda</strong></article>
    <article class="recaudo-metrica"><span>@UiTexts.GruposConPendiente</span><strong class="recaudo-cifra">@Model.GruposConPendiente</strong></article>
</div>
