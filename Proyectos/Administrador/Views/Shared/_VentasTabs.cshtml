@using NewRich.Admin.Constants
@{
    var vista = ViewData["VentasVista"] as string;
    var porLoteria = vista == UiTexts.VentasVistaLoteria;
    var porCubrir = vista == UiTexts.VentasVistaCubrir;
    var porBoleto = !porLoteria && !porCubrir;
}
<nav class="view-tabs" aria-label="@UiTexts.VistaDeVentas">
    <a class="view-tab@(porLoteria ? " is-active" : "")" asp-controller="Loterias" asp-action="Index" aria-current="@(porLoteria ? "page" : null)">@UiTexts.CrumbPorLoteria</a>
    <a class="view-tab@(porBoleto ? " is-active" : "")" asp-controller="Ventas" asp-action="Index" aria-current="@(porBoleto ? "page" : null)">@UiTexts.CrumbPorBoleto</a>
    <a class="view-tab@(porCubrir ? " is-active" : "")" asp-controller="CubrirVenta" asp-action="Resumen" aria-current="@(porCubrir ? "page" : null)">@UiTexts.CrumbPorCubrir</a>
</nav>
