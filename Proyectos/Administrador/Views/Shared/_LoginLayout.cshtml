@using NewRich.Admin.Constants
@using NewRich.Admin.Services
@{
    var inactividad = User.Identity?.IsAuthenticated == true
        ? (MinutosInactividadSesion.De(Context) * 60 * 1000).ToString()
        : null;
    var avisoModal = AvisoPagina.Texto(ViewData, TempData);
}
<!DOCTYPE html>
<html lang="es-CO">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | @UiTexts.AppName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Manrope:wght@400;600;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body" data-inactividad-ms="@inactividad">
@RenderBody()
<div id="avisoDialog" class="dialog-back@(string.IsNullOrEmpty(avisoModal) ? " hidden" : "")" role="dialog" aria-modal="true" aria-labelledby="avisoDialogTitle" @(string.IsNullOrEmpty(avisoModal) ? "hidden" : null)>
    <div class="dialog">
        <h2 id="avisoDialogTitle">@UiTexts.Aviso</h2>
        <p id="avisoDialogText">@avisoModal</p>
        <div class="dialog-actions">
            <button type="button" class="primary" data-close-dialog>@UiTexts.Aceptar</button>
        </div>
    </div>
</div>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (User.Identity?.IsAuthenticated == true)
{
    <script src="~/js/inactividad.js" asp-append-version="true"></script>
}
</body>
</html>
