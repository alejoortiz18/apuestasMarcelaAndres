@using NewRich.Admin.Constants
<!DOCTYPE html>
<html lang="es-CO">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | @UiTexts.AppName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Manrope:wght@400;600;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var inactividad = User.Identity?.IsAuthenticated == true
        ? (NewRich.Admin.Services.MinutosInactividadSesion.De(Context) * 60 * 1000).ToString()
        : null;
}
<body class="login-body" data-inactividad-ms="@inactividad">
@RenderBody()
@if (User.Identity?.IsAuthenticated == true)
{
    <script src="~/js/inactividad.js" asp-append-version="true"></script>
}
</body>
</html>
