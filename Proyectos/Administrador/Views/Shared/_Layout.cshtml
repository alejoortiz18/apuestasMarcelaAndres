@using NewRich.Admin.Constants
@using NewRich.Admin.Services
@{
    var nav = ViewData["Nav"] as string ?? "";
    var crumb = ViewData["Crumb"] as string ?? UiTexts.NavResumen;
    var crumbLeaf = ViewData["CrumbLeaf"] as string;
    var ventasInicioUrl = ViewData["VentasInicioUrl"] as string ?? Url.Action("Index", "Loterias");
    var avisoModal = TempData["AvisoModal"] as string;
    string NavClass(string key) => nav == key ? "active" : "";
    var enVentas = ViewData["VentasVista"] is string;
}
<!DOCTYPE html>
<html lang="es-CO" data-no-results="@UiTexts.SinResultadosOpcion" data-search-option="@UiTexts.BuscarOpcion" data-notif-conexion="@Url.Action("Conexion", "Notificaciones")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | @UiTexts.AppName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Manrope:wght@400;600;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-nav="@nav">
<div class="app">
    <aside class="side">
        <span class="side-marco" aria-hidden="true"></span>
        <img class="side-globo" src="~/img/menu-globo.png" alt="" />
        <a class="brand" asp-controller="Inicio" asp-action="Index" aria-label="@UiTexts.AppName">
            <span class="brand-mark" aria-hidden="true">NR</span>
            <span class="brand-copy">
                <span class="brand-name">@UiTexts.AppName</span>
                <span class="brand-lema">@UiTexts.AppLema</span>
            </span>
        </a>
        <nav class="nav" aria-label="Menu principal">
            <a class="@NavClass("resumen")" asp-controller="Inicio" asp-action="Index">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M4 10.5 12 4l8 6.5V20H14v-6H10v6H4z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                <span>@UiTexts.NavResumen</span>
            </a>
            <a class="@NavClass("usuarios")" asp-controller="Usuarios" asp-action="Index">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M4 19c.8-3 2.6-4.5 5-4.5S13.2 16 14 19M17 8a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5M20 19c-.5-2.2-1.7-3.4-3.4-3.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                <span>@UiTexts.NavUsuarios</span>
            </a>
            <a class="@NavClass("grupos")" asp-controller="Grupos" asp-action="Index">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="2.4" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="16" cy="8" r="2.4" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="16" r="2.4" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M10 9.6 11.2 14M14 9.6 12.8 14" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
                <span>@UiTexts.NavGrupos</span>
            </a>
            <a class="@NavClass("pda")" asp-controller="Dispositivos" asp-action="Index">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><rect x="7" y="3" width="10" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M10 18h4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                <span>@UiTexts.NavPda</span>
            </a>
            <a class="@NavClass("resultados")" asp-controller="Resultados" asp-action="Index">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M4 19V9M10 19V5M16 19v-7M21 19H3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                <span>@UiTexts.NavResultados</span>
            </a>
            <a class="@NavClass("ventas")" asp-controller="Loterias" asp-action="Index">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 7h14l-1.2 9.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 7zM8 7l1-3h6l1 3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                <span>@UiTexts.NavVentas</span>
            </a>
            <a class="@NavClass("offline")" asp-controller="Offline" asp-action="Index">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M7 16a5 5 0 1 1 1.6-9.7A6 6 0 0 1 21 11.5 4 4 0 0 1 18 19H8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                <span>@UiTexts.NavOffline</span>
            </a>
            <a class="@NavClass("premios")" asp-controller="Premios" asp-action="Index">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M8 6V4h8v2M7 6h10v4c0 3.2-2.4 5-5 5s-5-1.8-5-5V6zM12 15v5M9 20h6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                <span>@UiTexts.NavPremios</span>
            </a>
            <a class="@NavClass("kpi")" asp-controller="Kpi" asp-action="Index">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M4 18V8M10 18V5M16 18v-6M20 18H3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                <span>@UiTexts.NavKpi</span>
            </a>
            <a class="@NavClass("notificaciones")" asp-controller="Notificaciones" asp-action="Index">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M18 8A6 6 0 1 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M13.7 21a2 2 0 0 1-3.4 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                <span>@UiTexts.NavNotificaciones</span>
            </a>
            <a class="@NavClass("soporte")" asp-controller="Soporte" asp-action="Index">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 13v-2a7 7 0 0 1 14 0v2M5 13a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h1v-6H5zM19 13h1a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-1v-6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                <span>@UiTexts.NavSoporte</span>
            </a>
            <a class="@NavClass("configuracion")" asp-controller="Configuracion" asp-action="Index">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M12 3.5v2.2M12 18.3v2.2M4.6 7.1l1.9 1.1M17.5 15.8l1.9 1.1M4.6 16.9l1.9-1.1M17.5 8.2l1.9-1.1" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                <span>@UiTexts.NavConfiguracion</span>
            </a>
        </nav>
        <div class="side-foot">
            <details class="side-cuenta" data-cuenta-menu>
                <summary aria-label="@UiTexts.MenuCuenta">
                    <span class="side-cuenta-ico" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M5.5 19c1.2-3.2 3.6-4.8 6.5-4.8S17.8 15.8 19 19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                    </span>
                    <span class="side-cuenta-copy">
                        <strong>@User.RolMostrado()</strong>
                        <span>@User.NombreUsuario()</span>
                    </span>
                    <span class="side-cuenta-arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M9 7V5H5v14h4v-2M10 12h10M16 8l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                </summary>
                <form asp-controller="Cuenta" asp-action="Salir" method="post">
                    <button class="side-salir" type="submit">@UiTexts.CerrarSesion</button>
                </form>
            </details>
        </div>
    </aside>
    <main>
        <header class="top">
            <nav class="crumb" aria-label="@UiTexts.MigaDePan">
                <span>@UiTexts.AppName</span>
                <span class="crumb-sep" aria-hidden="true">/</span>
                @if (enVentas && !string.IsNullOrEmpty(crumbLeaf))
                {
                    <a href="@ventasInicioUrl">@UiTexts.NavVentas</a>
                    <span class="crumb-sep" aria-hidden="true">/</span>
                    <strong aria-current="page">@crumbLeaf</strong>
                }
                else
                {
                    <strong aria-current="page">@crumb</strong>
                }
            </nav>
            <div class="top-user">
                @await Component.InvokeAsync("CampanaNotificaciones")
                <details class="top-cuenta" data-cuenta-menu>
                    <summary aria-label="@UiTexts.MenuCuenta">
                        <span class="top-user-name">@User.NombreMostrado()</span>
                        <div class="avatar" aria-hidden="true">@User.Iniciales()</div>
                    </summary>
                    <form asp-controller="Cuenta" asp-action="Salir" method="post">
                        <button class="side-salir" type="submit">@UiTexts.CerrarSesion</button>
                    </form>
                </details>
            </div>
        </header>
        <div id="notifToast" class="notif-toast hidden" role="status" aria-live="polite" data-toast-ms="3000">
            <strong>@UiTexts.NuevaNotificacion</strong>
            <p data-toast-text></p>
            <a data-toast-link href="#">@UiTexts.Ver</a>
        </div>
        <section class="content">
            @if (TempData["FlashOk"] is string ok)
            {
                <div class="notice ok" role="status">@ok</div>
            }
            @if (TempData["FlashError"] is string err)
            {
                <div class="notice error" role="alert">@err</div>
            }
            @RenderBody()
        </section>
        <footer class="app-foot">
            <span>@UiTexts.PieDerechos</span>
            <span class="app-foot-meta">@UiTexts.PieVision · @UiTexts.PieEstrategia · @UiTexts.PieResultados</span>
        </footer>
    </main>
    <nav class="mobile-bar" aria-label="Navegacion rapida">
        <a class="@NavClass("resumen")" asp-controller="Inicio" asp-action="Index">@UiTexts.NavResumen</a>
        <a class="@NavClass("usuarios")" asp-controller="Usuarios" asp-action="Index">@UiTexts.NavUsuarios</a>
        <a class="@NavClass("ventas")" asp-controller="Loterias" asp-action="Index">@UiTexts.NavVentas</a>
        <a class="@NavClass("soporte")" asp-controller="Soporte" asp-action="Index">@UiTexts.NavSoporte</a>
    </nav>
</div>
<div id="ticketDialog" class="dialog-back hidden" role="dialog" aria-modal="true" aria-labelledby="ticketDialogTitle" hidden>
    <div class="dialog dialog-ticket" data-ticket-panel></div>
</div>
<div id="avisoDialog" class="dialog-back@(string.IsNullOrEmpty(avisoModal) ? " hidden" : "")" role="dialog" aria-modal="true" aria-labelledby="avisoDialogTitle" @(string.IsNullOrEmpty(avisoModal) ? "hidden" : null)>
    <div class="dialog">
        <h2 id="avisoDialogTitle">@UiTexts.Aviso</h2>
        <p id="avisoDialogText">@avisoModal</p>
        <div class="dialog-actions">
            <button type="button" class="primary" data-close-dialog>@UiTexts.Cerrar</button>
        </div>
    </div>
</div>
<script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
