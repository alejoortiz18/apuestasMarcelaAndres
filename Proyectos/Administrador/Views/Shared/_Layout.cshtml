@using NewRich.Admin.Constants
@using NewRich.Admin.Services
@{
    var nav = ViewData["Nav"] as string ?? "";
    var crumb = ViewData["Crumb"] as string ?? UiTexts.NavResumen;
    string NavClass(string key) => nav == key ? "active" : "";
}
<!DOCTYPE html>
<html lang="es-CO" data-no-results="@UiTexts.SinResultadosOpcion" data-search-option="@UiTexts.BuscarOpcion">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | @UiTexts.AppName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app">
    <aside class="side">
        <a class="brand" asp-controller="Inicio" asp-action="Index">NR<span>@UiTexts.AppSubtitle.ToUpperInvariant()</span></a>
        <nav class="nav" aria-label="Menu principal">
            <a class="@NavClass("resumen")" asp-controller="Inicio" asp-action="Index"><i>#</i><span>@UiTexts.NavResumen</span></a>
            <a class="@NavClass("usuarios")" asp-controller="Usuarios" asp-action="Index"><i>U</i><span>@UiTexts.NavUsuarios</span></a>
            <a class="@NavClass("grupos")" asp-controller="Grupos" asp-action="Index"><i>G</i><span>@UiTexts.NavGrupos</span></a>
            <a class="@NavClass("pda")" asp-controller="Dispositivos" asp-action="Index"><i>P</i><span>@UiTexts.NavPda</span></a>
            <a class="@NavClass("loterias")" asp-controller="Loterias" asp-action="Index"><i>L</i><span>@UiTexts.NavLoterias</span></a>
            <a class="@NavClass("resultados")" asp-controller="Resultados" asp-action="Index"><i>R</i><span>@UiTexts.NavResultados</span></a>
            <a class="@NavClass("ventas")" asp-controller="Ventas" asp-action="Index"><i>V</i><span>@UiTexts.NavVentas</span></a>
            <a class="@NavClass("offline")" asp-controller="Offline" asp-action="Index"><i>O</i><span>@UiTexts.NavOffline</span></a>
            <a class="@NavClass("premios")" asp-controller="Premios" asp-action="Index"><i>C</i><span>@UiTexts.NavPremios</span></a>
            <a class="@NavClass("kpi")" asp-controller="Kpi" asp-action="Index"><i>K</i><span>@UiTexts.NavKpi</span></a>
            <a class="@NavClass("notificaciones")" asp-controller="Notificaciones" asp-action="Index"><i>!</i><span>@UiTexts.NavNotificaciones</span></a>
            <a class="@NavClass("soporte")" asp-controller="Soporte" asp-action="Index"><i>S</i><span>@UiTexts.NavSoporte</span></a>
            <a class="@NavClass("configuracion")" asp-controller="Configuracion" asp-action="Index"><i>+</i><span>@UiTexts.NavConfiguracion</span></a>
        </nav>
        <div class="side-foot">
            <span class="detail">@UiTexts.ServidorCentral<br /><strong>@UiTexts.Conectado</strong></span>
            <form asp-controller="Cuenta" asp-action="Salir" method="post">
                <button class="secondary" type="submit">@UiTexts.CerrarSesion</button>
            </form>
        </div>
    </aside>
    <main>
        <header class="top">
            <div class="crumb">@UiTexts.CrumbPrefijo<strong>@crumb</strong></div>
            <div class="top-user">
                <a class="avisos" asp-controller="Notificaciones" asp-action="Index">@UiTexts.Avisos</a>
                <b>@User.NombreMostrado()</b>
                <div class="avatar" aria-hidden="true">@User.Iniciales()</div>
            </div>
        </header>
        <section class="content">
            @if (TempData["FlashOk"] is string ok)
            {
                <div class="notice ok" role="status">@ok</div>
            }
            @if (TempData["FlashError"] is string err)
            {
                <div class="notice error" role="alert">@err</div>
            }
            @RenderBody()
        </section>
    </main>
    <nav class="mobile-bar" aria-label="Navegacion rapida">
        <a class="@NavClass("resumen")" asp-controller="Inicio" asp-action="Index">@UiTexts.NavResumen</a>
        <a class="@NavClass("usuarios")" asp-controller="Usuarios" asp-action="Index">@UiTexts.NavUsuarios</a>
        <a class="@NavClass("ventas")" asp-controller="Ventas" asp-action="Index">@UiTexts.NavVentas</a>
        <a class="@NavClass("soporte")" asp-controller="Soporte" asp-action="Index">@UiTexts.NavSoporte</a>
    </nav>
</div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
