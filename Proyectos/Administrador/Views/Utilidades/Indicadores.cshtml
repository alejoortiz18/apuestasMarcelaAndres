@using NewRich.Admin.Constants
@model NewRich.Admin.Models.UtilidadesVentasViewModel
<link rel="stylesheet" href="~/css/informes.css" asp-append-version="true" />

<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.UtilidadesKicker</div>
        <h1>@UiTexts.NavUtilidadesIndicadores</h1>
        <p>@UiTexts.IndicadoresAyuda</p>
    </div>
</div>
<div class="panel">
    <form class="toolbar" method="get">
        <div class="field">
            <label for="periodo">@UiTexts.Periodo</label>
            <select id="periodo" name="periodo" class="searchable">
                @foreach (var opcion in Model.Configuracion.Periodos)
                {
                    <option value="@opcion.Valor" selected="@(Model.Periodo == opcion.Valor)">@opcion.Texto</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="desde">@UiTexts.Desde</label>
            <input id="desde" name="desde" type="date" value="@Model.Desde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="hasta">@UiTexts.Hasta</label>
            <input id="hasta" name="hasta" type="date" value="@Model.Hasta?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="grupoId">@UiTexts.Grupo</label>
            <select id="grupoId" name="grupoId" class="searchable">
                <option value="">@UiTexts.InformeTodosGrupos</option>
                @foreach (var grupo in Model.Configuracion.Grupos)
                {
                    <option value="@grupo.Valor" selected="@(Model.GrupoId?.ToString() == grupo.Valor)">@grupo.Texto</option>
                }
            </select>
        </div>
        <button class="primary" type="submit">@UiTexts.Consultar</button>
        <a class="secondary" asp-action="Indicadores">@UiTexts.Limpiar</a>
    </form>
</div>
<section class="panel informe-seccion" aria-labelledby="utilidadesVentasTitulo">
    <div class="informe-categoria">
        <h2 id="utilidadesVentasTitulo" class="informe-titulo-categoria">@UiTexts.InformeCategoriaVentas</h2>
        <article class="informe-config">
            <div class="informe-config-datos">
                <h3>@UiTexts.InformeCategoriaVentas</h3>
                <dl>
                    @foreach (var detalle in Model.Configuracion.Detalle)
                    {
                        <div>
                            <dt>@detalle.Etiqueta</dt>
                            <dd>@detalle.Valor</dd>
                        </div>
                    }
                </dl>
                <p>@UiTexts.InformeGruposVentasAyuda</p>
            </div>
        </article>
        @if (Model.Informe is not null)
        {
            <partial name="~/Views/Informes/_InformeVentas.cshtml" model="Model.Informe" />
        }
    </div>
</section>
