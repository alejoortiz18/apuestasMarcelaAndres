<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NewRich.Admin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\API\src\NewRich.Application\NewRich.Application.csproj" />
    <ProjectReference Include="..\API\src\NewRich.Constants\NewRich.Constants.csproj" />
    <ProjectReference Include="..\API\src\NewRich.Domain\NewRich.Domain.csproj" />
    <ProjectReference Include="..\API\src\NewRich.Shared\NewRich.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- El APK viaja con el proyecto para instalar el PDA, pero no se publica como archivo web. -->
    <Content Remove="wwwroot\android\**" />
    <None Include="wwwroot\android\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2025.7.3" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
