@model NewRich.Vendedor.Models.InicioViewModel
@{
    var r = Model.Resumen;
    var ventaRegistrada = r.VentasRegistradas > 0;
    var paginacion = new PaginacionViewModel { Page = Model.Page, PageSize = Model.PageSize, Total = r.Ganadores.Count, Accion = "Index", Controlador = "Inicio" };
}
<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.ResumenKicker</div>
        <h1>@UiTexts.ResumenTitulo</h1>
        <p>@UiTexts.ResumenSub</p>
    </div>
    <a class="primary" asp-controller="Vender" asp-action="Index">@UiTexts.Vender</a>
</div>
@if (Model.HorarioCerrado)
{
    <div class="panel"><p>@UiTexts.JuegosCerrados</p></div>
}
@if (!string.IsNullOrWhiteSpace(Model.Aviso))
{
    <div class="panel"><p>@Model.Aviso</p></div>
}
<div class="stats stats-resumen">
    <a class="stat stat-enlace" asp-controller="Historico" asp-action="Index">
        <span class="stat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M6 7h12v12H6zM8 7V5.6A1.6 1.6 0 0 1 9.6 4h4.8A1.6 1.6 0 0 1 16 5.6V7" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M9 12h6M9 15h4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
        <div>
            <small>@UiTexts.ResumenJuegos</small>
            <strong>@r.JuegosRegistrados</strong>
            <span class="stat-nota">@string.Format(UiTexts.ResumenJuegosNota, r.ApuestasRegistradas, Montos.De(r.ValorJuegos))</span>
        </div>
    </a>
    <a class="stat stat-enlace@(ventaRegistrada ? null : " stat-pendiente")" asp-controller="RegistrarVenta" asp-action="Index">
        <span class="stat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M12 8v8M9 10.5c.8-1 2-1.5 3-1.5s2.2.6 3 1.6M9 14.2c.8 1 2 1.5 3 1.5s2.2-.6 3-1.6" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></span>
        <div>
            <small>@UiTexts.ResumenVenta</small>
            <strong>@(ventaRegistrada ? string.Format(UiTexts.Pesos, Montos.De(r.ValorVentaDelDia)) : UiTexts.ResumenVentaPendiente)</strong>
            <span class="stat-nota">@(ventaRegistrada ? UiTexts.ResumenVentaNota : UiTexts.ResumenVentaPendienteNota)</span>
        </div>
    </a>
    <a class="stat stat-enlace" asp-controller="EntregaPremio" asp-action="Index">
        <span class="stat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 4h8v4a4 4 0 0 1-8 0V4zM8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4M12 12v4M9 20h6M10 16h4v4h-4z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></span>
        <div>
            <small>@UiTexts.ResumenPremios</small>
            <strong>@r.PremiosEntregados</strong>
            <span class="stat-nota">@string.Format(UiTexts.ResumenPremiosNota, Montos.De(r.ValorPremiosEntregados))</span>
        </div>
    </a>
    <a class="stat stat-enlace" asp-controller="Gastos" asp-action="Index">
        <span class="stat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 7h16v11H4zM4 10h16M15 14.5h2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <div>
            <small>@UiTexts.ResumenGastos</small>
            <strong>@r.Gastos</strong>
            <span class="stat-nota">@string.Format(UiTexts.ResumenGastosNota, Montos.De(r.ValorGastos))</span>
        </div>
    </a>
    <a class="stat stat-enlace@(r.Ganadores.Count > 0 ? " stat-destacado" : null)" href="#ganadores">
        <span class="stat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="m12 4 2.3 4.7 5.2.8-3.8 3.6.9 5.2-4.6-2.4-4.6 2.4.9-5.2-3.8-3.6 5.2-.8L12 4z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></span>
        <div>
            <small>@UiTexts.ResumenGanadores</small>
            <strong>@r.Ganadores.Count</strong>
            <span class="stat-nota">@(r.Ganadores.Count > 0 ? UiTexts.ResumenGanadoresNota : UiTexts.ResumenSinGanadoresNota)</span>
        </div>
    </a>
</div>
<div class="panel" id="ganadores">
    <div class="panel-head">
        <div>
            <h2>@UiTexts.ResumenGanadoresTitulo</h2>
            <p class="panel-sub">@UiTexts.ResumenGanadoresAyuda</p>
        </div>
        <a class="secondary" asp-controller="Resultados" asp-action="Index">@UiTexts.VerResultados</a>
    </div>
    @if (r.Ganadores.Count == 0)
    {
        <div class="empty empty-rich">
            <p>@UiTexts.Vacio</p>
            <p>@UiTexts.ResumenGanadoresVacio</p>
        </div>
    }
    else
    {
        <form class="toolbar" method="get" action="#ganadores" data-submit-on-change>
            <div class="field">
                <label for="pageSize">@UiTexts.FilasPorPagina</label>
                <select id="pageSize" name="pageSize">
                    @foreach (var size in Paginas.Tamanos)
                    {
                        if (Model.PageSize == size)
                        {
                            <option value="@size" selected>@size</option>
                        }
                        else
                        {
                            <option value="@size">@size</option>
                        }
                    }
                </select>
            </div>
        </form>
        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>@UiTexts.Loteria</th>
                    <th>@UiTexts.Numero</th>
                    <th>@UiTexts.TipoJuego</th>
                    <th>@UiTexts.Codigo</th>
                    <th>@UiTexts.ValorJugado</th>
                    <th>@UiTexts.Hora</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var g in Model.Ganadores)
                {
                    <tr tabindex="0">
                        <td>@g.Loteria</td>
                        <td><strong>@g.Numero</strong></td>
                        <td>@g.Tipo</td>
                        <td>@g.CodigoPublico</td>
                        <td>@string.Format(UiTexts.Pesos, Montos.De(g.Valor))</td>
                        <td>@g.FechaRegistro.ToString("hh:mm tt", System.Globalization.CultureInfo.GetCultureInfo("es-CO"))</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="paginacion" />
    }
</div>
