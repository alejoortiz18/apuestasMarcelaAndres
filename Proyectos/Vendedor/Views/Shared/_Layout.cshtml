@using NewRich.Vendedor.Constants
@using NewRich.Vendedor.Services
@{
    var nav = ViewData["Nav"] as string ?? "";
    var avisoModal = AvisoPagina.Texto(ViewData, TempData);
    string NavClass(string key) => nav == key ? "active" : "";
    var inactividadMs = MinutosInactividadSesion.De(Context) * 60 * 1000;
}
<!DOCTYPE html>
<html lang="es-CO" data-no-results="@UiTexts.SinResultados" data-search-option="@UiTexts.BuscarLoteria">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | @UiTexts.AppName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Manrope:wght@400;600;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-nav="@nav" data-inactividad-ms="@inactividadMs">
<div class="app">
    <aside class="side">
        <span class="side-marco" aria-hidden="true"></span>
        <img class="side-globo" src="~/img/menu-globo.png" alt="" />
        <a class="brand" asp-controller="Inicio" asp-action="Index" aria-label="@UiTexts.AppName">
            <span class="brand-mark" aria-hidden="true">NR</span>
            <span class="brand-copy">
                <span class="brand-name">@UiTexts.AppName</span>
                <span class="brand-lema">@UiTexts.SitioVendedor</span>
            </span>
        </a>
        <nav class="nav" aria-label="Menu del vendedor">
            <div class="nav-group">
                <a class="@NavClass("inicio")" asp-controller="Inicio" asp-action="Index"><span>@UiTexts.Inicio</span></a>
                <a class="@NavClass("vender")" asp-controller="Vender" asp-action="Index"><span>@UiTexts.Vender</span></a>
                <a class="@NavClass("historico")" asp-controller="Historico" asp-action="Index"><span>@UiTexts.Historico</span></a>
                <a class="@NavClass("alertas")" asp-controller="Alertas" asp-action="Index"><span>@UiTexts.Alertas</span></a>
                <a class="@NavClass("validar")" asp-controller="Validar" asp-action="Index"><span>@UiTexts.ValidarTicket</span></a>
                <a class="@NavClass("resultados")" asp-controller="Resultados" asp-action="Index"><span>@UiTexts.Resultados</span></a>
                <a class="@NavClass("soporte")" asp-controller="Soporte" asp-action="Index"><span>@UiTexts.Atencion</span></a>
                <a class="@NavClass("soporte-tecnico")" asp-controller="Soporte" asp-action="Tecnico"><span>@UiTexts.SoporteTecnico</span></a>
                <a class="@NavClass("entrega")" asp-controller="EntregaPremio" asp-action="Index"><span>@UiTexts.EntregaPremio</span></a>
                <a class="@NavClass("mis-gastos")" asp-controller="Gastos" asp-action="Index"><span>@UiTexts.MisGastos</span></a>
            </div>
        </nav>
    </aside>
    <main>
        <header class="top">
            <div class="top-user">
                <span class="top-user-name">@User.NombreMostrado()</span>
                <div class="avatar" aria-hidden="true">@User.Iniciales()</div>
            </div>
            <form asp-controller="Cuenta" asp-action="Salir" method="post" data-cerrar-sesion>
                @Html.AntiForgeryToken()
                <button class="secondary" type="submit">@UiTexts.CerrarSesion</button>
            </form>
        </header>
        <section class="content">
            @RenderBody()
        </section>
        <footer class="app-foot">
            <span>@UiTexts.PieDerechos</span>
            <span class="app-foot-meta">@UiTexts.PieVision · @UiTexts.PieEstrategia · @UiTexts.PieResultados</span>
        </footer>
    </main>
</div>
<div id="avisoDialog" class="dialog-back@(string.IsNullOrEmpty(avisoModal) ? " hidden" : "")" role="dialog" aria-modal="true" aria-labelledby="avisoDialogTitle" @(string.IsNullOrEmpty(avisoModal) ? "hidden" : null)>
    <div class="dialog">
        <h2 id="avisoDialogTitle">@UiTexts.Aviso</h2>
        <p id="avisoDialogText">@avisoModal</p>
        <div class="dialog-actions">
            <button type="button" class="primary" data-close-dialog>@UiTexts.Aceptar</button>
        </div>
    </div>
</div>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/inactividad.js" asp-append-version="true"></script>
</body>
</html>
