@model NewRich.Vendedor.Models.IndicadoresGastosViewModel
@{
    var opciones = new (string Valor, string Texto)[]
    {
        ("hoy", UiTexts.PeriodoHoy),
        ("ayer", UiTexts.PeriodoAyer),
        ("ultimos-7", UiTexts.Periodo7),
        ("ultimos-30", UiTexts.Periodo30),
        ("mes", UiTexts.PeriodoMes),
        ("mes-anterior", UiTexts.PeriodoMesAnterior),
        ("rango", UiTexts.PeriodoRango)
    };
}
<div class="heading">
    <div>
        <div class="eyebrow">@UiTexts.MenuUtilidades</div>
        <h1>@UiTexts.Indicadores</h1>
        <p>@UiTexts.IndicadoresAyuda</p>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Aviso))
{
    <div class="notice error" role="alert">@Model.Aviso</div>
}
<div class="panel">
    <form class="toolbar" method="get">
        <div class="field">
            <label for="periodo">@UiTexts.Periodo</label>
            <select id="periodo" name="periodo">
                @foreach (var opcion in opciones)
                {
                    if (Model.Periodo == opcion.Valor)
                    {
                        <option value="@opcion.Valor" selected>@opcion.Texto</option>
                    }
                    else
                    {
                        <option value="@opcion.Valor">@opcion.Texto</option>
                    }
                }
            </select>
        </div>
        <div class="field">
            <label for="desde">@UiTexts.Desde</label>
            <input id="desde" name="desde" type="date" value="@Model.Desde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="hasta">@UiTexts.Hasta</label>
            <input id="hasta" name="hasta" type="date" value="@Model.Hasta?.ToString("yyyy-MM-dd")" />
        </div>
        <button class="primary" type="submit">@UiTexts.Buscar</button>
        <a class="secondary" asp-action="Indicadores">@UiTexts.Limpiar</a>
    </form>
    <p class="field-help">@UiTexts.RangoAyuda</p>
    @if (!string.IsNullOrWhiteSpace(Model.PeriodoTexto))
    {
        <p>@Model.PeriodoTexto</p>
    }
</div>
<div class="metric-grid">
    <article class="metric">
        <small>@UiTexts.TotalMisGastos</small>
        <strong>@Model.Total</strong>
    </article>
    <article class="metric">
        <small>@UiTexts.CantidadGastos</small>
        <strong>@Model.Cantidad</strong>
    </article>
    <article class="metric">
        <small>@UiTexts.GastoPromedio</small>
        <strong>@Model.Promedio</strong>
    </article>
    <article class="metric">
        <small>@UiTexts.MayorGasto</small>
        <strong>@Model.MayorValor</strong>
        <em>@Model.Mayor</em>
    </article>
</div>
<div class="kpi-grid informe-grid">
    <section class="kpi-section">
        <h2>@UiTexts.GastosPorTipo</h2>
        @if (Model.Tipos.Count == 0)
        {
            <p>@UiTexts.SinGastosPeriodo</p>
        }
        else
        {
            <div class="kpi-bars">
                @foreach (var tipo in Model.Tipos)
                {
                    <div>
                        <div class="kpi-bar-head">
                            <span>@tipo.Etiqueta</span>
                            <span>@tipo.Valor · @string.Format(UiTexts.Participacion, tipo.Porcentaje) · @tipo.Detalle</span>
                        </div>
                        <div class="kpi-bar gold" role="img" aria-label="@tipo.Etiqueta @tipo.Valor">
                            <i style="width: @(tipo.Porcentaje)%"></i>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
    <section class="kpi-section">
        <h2>@Model.SerieTitulo</h2>
        @if (Model.Serie.Count == 0)
        {
            <p>@UiTexts.SinGastosPeriodo</p>
        }
        else
        {
            <div class="informe-dias" role="img" aria-label="@Model.SerieTitulo">
                @foreach (var dia in Model.Serie)
                {
                    <div class="informe-dia">
                        <span class="informe-dia-valor">@dia.Valor</span>
                        <div class="informe-dia-pista">
                            <i style="height: @(Math.Max(dia.Porcentaje, dia.Porcentaje == 0 ? 0 : 8))%"></i>
                        </div>
                        <span class="informe-dia-fecha">@dia.Etiqueta</span>
                    </div>
                }
            </div>
        }
    </section>
</div>
@if (!string.IsNullOrWhiteSpace(Model.AnuladosTexto))
{
    <p class="kpi-note">@Model.AnuladosTexto</p>
}
