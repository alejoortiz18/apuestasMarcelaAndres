@model NewRich.Vendedor.Models.CambiarPasswordViewModel
@{
    Layout = "_LoginLayout";
}
<section class="login">
    <div class="login-inner">
        <div class="login-box">
            <h1>@UiTexts.CambiarContrasena</h1>
            <form asp-action="CambiarPassword" method="post">
                <div class="field">
                    <label asp-for="PasswordActual"></label>
                    <input asp-for="PasswordActual" autocomplete="current-password" />
                    <span asp-validation-for="PasswordActual"></span>
                </div>
                <div class="field">
                    <label asp-for="PasswordNuevo"></label>
                    <input asp-for="PasswordNuevo" autocomplete="new-password" />
                    <span asp-validation-for="PasswordNuevo"></span>
                </div>
                <div class="field">
                    <label asp-for="PasswordConfirmacion"></label>
                    <input asp-for="PasswordConfirmacion" autocomplete="new-password" />
                    <span asp-validation-for="PasswordConfirmacion"></span>
                </div>
                <button class="primary" type="submit">@UiTexts.GuardarContrasena</button>
            </form>
        </div>
    </div>
</section>
